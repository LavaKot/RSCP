//! The stack-based virtual machine.
//!
//! Design: each call pushes a [`Frame`] with its own instruction pointer;
//! locals live in the value stack above the callee slot (slot 0 of a frame
//! is the running closure itself). Closures capture locals through shared
//! [`Upvalue`] cells that start "open" (pointing at a stack slot) and close
//! (copying the value) when the defining scope exits.

use std::cell::RefCell;
use std::collections::HashMap;
use std::io::{BufWriter, Stdout, Write};
use std::rc::Rc;
use std::time::{SystemTime, UNIX_EPOCH};

use crate::bytecode::{Chunk, FnProto, Op};
use crate::errors::{RscpError, TraceFrame};
use crate::fxhash::FxBuild;
use crate::value::{detail, FunctionVal, RtError, Upvalue, Value};

/// Maximum call depth before a "stack overflow" runtime error.
const MAX_FRAMES: usize = 1024;

/// A global binding and its mutability.
pub struct GlobalCell {
    pub value: Value,
    pub mutable: bool,
}

/// Globals table: `Rc<str>` keys so a `GetGlobal` never allocates a lookup
/// `String` (the name constant is already an `Rc<str>` we can clone cheaply),
/// FxHash for fast lookups.
pub type GlobalMap = HashMap<Rc<str>, GlobalCell, FxBuild>;

/// Result of a cold raise helper (`op_throw`): a `try` handler took over,
/// or the error propagates fatally.
enum Control {
    Handled,
    Fatal(RscpError),
}

/// Outcome of the (cold) class-construction call path.
enum CallOutcome {
    /// The instance is ready (no init): push it as the call's value.
    Pushed(Value),
    /// `init` was entered: a frame is pushed, reload the dispatch loop.
    Entered,
    /// An arity/overflow error was raised and a handler took over.
    Handled,
    /// The error propagates fatally.
    Fatal(RscpError),
}

/// Program output. Interactive terminals keep the line-buffered stdout; when
/// stdout is not a terminal (a pipe or a file), `run` switches to a block
/// buffer so print-heavy scripts stop paying a flush per line.
pub enum Out {
    Line,
    Full(BufWriter<Stdout>),
}

impl Out {
    /// Std's `println!` panics with this message when stdout fails; the
    /// panic hook in main turns a broken pipe into a quiet exit(141).
    fn fail(e: std::io::Error) -> ! {
        panic!("failed printing to stdout: {e}")
    }

    pub fn write_str(&mut self, s: &str) {
        match self {
            Out::Line => {
                let mut out = std::io::stdout();
                if let Err(e) = out.write_all(s.as_bytes()) {
                    Out::fail(e);
                }
            }
            Out::Full(w) => {
                if let Err(e) = w.write_all(s.as_bytes()) {
                    Out::fail(e);
                }
            }
        }
    }

    pub fn write_line(&mut self, s: &str) {
        match self {
            Out::Line => {
                let mut out = std::io::stdout();
                if let Err(e) = out.write_all(s.as_bytes()) {
                    Out::fail(e);
                }
                if let Err(e) = out.write_all(b"\n") {
                    Out::fail(e);
                }
            }
            Out::Full(w) => {
                if let Err(e) = w.write_all(s.as_bytes()) {
                    Out::fail(e);
                }
                if let Err(e) = w.write_all(b"\n") {
                    Out::fail(e);
                }
            }
        }
    }

    pub fn flush(&mut self) {
        match self {
            Out::Line => {
                let _ = std::io::stdout().flush();
            }
            Out::Full(w) => {
                let _ = w.flush();
            }
        }
    }
}

/// An active `try` handler: unwinding restores the frame count and stack
/// length recorded at registration, then enters `catch_ip` with the error
/// message pushed onto the stack.
#[derive(Debug, Clone, Copy)]
pub struct Handler {
    /// `frames.len()` when the handler was registered; valid while the
    /// registering frame (index `frame_count - 1`) is still alive.
    pub frame_count: usize,
    pub catch_ip: usize,
    pub stack_len: usize,
}

/// Bookkeeping for a running module frame: when it returns, its globals
/// (minus builtins) become the export map, and the importer's globals are
/// restored.
struct ModuleCtx {
    path: String,
    saved_globals: GlobalMap,
    /// The module's own globals, shared with every closure it created:
    /// filled when the module finishes (26.0.12.2).
    globals: Rc<RefCell<GlobalMap>>,
}

struct Frame {
    func: Rc<FunctionVal>,
    /// Resume point (instruction index) saved while a callee runs.
    ip: usize,
    /// Stack index of the callee slot; locals start at `base + 1`.
    base: usize,
    /// Set while an imported module is running in this frame.
    module: Option<Box<ModuleCtx>>,
    /// When set, the frame's return value is replaced by this value
    /// (a constructor call returns the instance even when init returns
    /// nothing).
    ret_override: Option<Value>,
}

pub struct Vm {
    pub stack: Vec<Value>,
    frames: Vec<Frame>,
    pub globals: GlobalMap,
    /// Reusable argument buffer for native calls (no per-call allocation).
    native_args: Vec<Value>,
    open_upvalues: Vec<(usize, Rc<RefCell<Upvalue>>)>,
    /// Active `try` handlers, innermost last.
    pub handlers: Vec<Handler>,
    /// Imported modules by canonical path: the export map (diamond imports
    /// run the module once).
    pub modules: HashMap<String, Value>,
    /// REPL mode: allow redefining and reassigning top-level bindings.
    pub repl: bool,
    /// When true, `print`/`println` produce no output (used by tests).
    pub quiet: bool,
    /// Program output (line-buffered terminal stdout, or a block buffer
    /// when stdout is a pipe/file).
    pub out: Out,
    rng: u64,
}

impl Default for Vm {
    fn default() -> Self {
        Self::new()
    }
}

impl Vm {
    pub fn new() -> Self {
        let seed = SystemTime::now()
            .duration_since(UNIX_EPOCH)
            .map(|d| d.as_nanos() as u64)
            .unwrap_or(0x9e3779b97f4a7c15)
            | 1; // xorshift state must be non-zero
        let mut vm = Vm {
            stack: Vec::with_capacity(256),
            frames: Vec::with_capacity(64),
            globals: HashMap::default(),
            native_args: Vec::new(),
            open_upvalues: Vec::new(),
            handlers: Vec::new(),
            modules: HashMap::new(),
            repl: false,
            quiet: false,
            out: Out::Line,
            rng: seed,
        };
        crate::builtins::install(&mut vm);
        vm
    }

    pub fn define_native(&mut self, name: &'static str, func: crate::value::NativeFn) {
        self.globals.insert(
            Rc::from(name),
            GlobalCell {
                value: Value::Native(Rc::new(crate::value::NativeVal { name, func })),
                mutable: false,
            },
        );
    }

    /// Execute a compiled script. After the top level finishes, if a global
    /// function `main` exists it is called with no arguments.
    pub fn run_script(&mut self, proto: Rc<FnProto>) -> Result<(), RscpError> {
        self.run_frameless(proto)?;
        if !self.repl {
            if let Some(cell) = self.globals.get("main") {
                match &cell.value {
                    Value::Func(f) if f.proto.arity == 0 => {
                        let func = f.clone();
                        self.run_frameless(func.proto.clone())?;
                    }
                    Value::Func(_) => {
                        return Err(RscpError::runtime("'main' must take no arguments", 0));
                    }
                    other => {
                        return Err(RscpError::runtime(
                            format!("'main' is defined but is not a function (it is a {})", other.type_name()),
                            0,
                        ));
                    }
                }
            }
        }
        Ok(())
    }

    /// Push a fresh frame for `proto` and run until it returns.
    fn run_frameless(&mut self, proto: Rc<FnProto>) -> Result<(), RscpError> {
        self.stack.clear();
        self.frames.clear();
        self.handlers.clear();
        let func = Rc::new(FunctionVal { proto, upvalues: Vec::new(), globals: None });
        self.stack.push(Value::Func(Rc::clone(&func)));
        self.frames.push(Frame { func, ip: 0, base: 0, module: None, ret_override: None });
        self.exec()
    }

    /// The main interpreter loop. `continue 'outer` re-enters after a frame
    /// switch (call or return); the inner loop borrows the current chunk
    /// through a local `Rc` clone, so pushing frames never fights the borrow.
    fn exec(&mut self) -> Result<(), RscpError> {
        // Expands to: sync the current frame's ip, then raise a runtime
        // error. Catchable errors unwind to the innermost `try` handler
        // (if any) and resume in its catch block; fatal ones propagate.
        // On the catch path the macro `break`s out of the inner dispatch
        // loop, which makes the outer loop reload the frame (and its new
        // ip) — macro hygiene hides `'outer`, so a labeled continue is not
        // an option. `self` resolves at the expansion site; the failing
        // instruction index must be passed in because macro hygiene hides
        // surrounding locals.
        macro_rules! rt {
            ($op_ip:expr, $msg:expr) => {{
                self.frames.last_mut().unwrap().ip = $op_ip;
                match self.raise("RUNTIME", $msg, Value::Null, true) {
                    Ok(()) => break, // a handler took over
                    Err(e) => return Err(e),
                }
            }};
        }
        // raise with an explicit machine-readable code (26.0.10.0)
        macro_rules! rtc {
            ($op_ip:expr, $code:expr, $msg:expr) => {{
                self.frames.last_mut().unwrap().ip = $op_ip;
                match self.raise($code, $msg, Value::Null, true) {
                    Ok(()) => break, // a handler took over
                    Err(e) => return Err(e),
                }
            }};
        }
        // raise a prebuilt RtError (from arith/index/native helpers)
        macro_rules! rte {
            ($op_ip:expr, $err:expr) => {{
                self.frames.last_mut().unwrap().ip = $op_ip;
                match self.raise($err.code, $err.msg, $err.detail, true) {
                    Ok(()) => break, // a handler took over
                    Err(e) => return Err(e),
                }
            }};
        }
        macro_rules! rt_fatal {
            ($op_ip:expr, $msg:expr) => {{
                self.frames.last_mut().unwrap().ip = $op_ip;
                match self.raise("FATAL", $msg, Value::Null, false) {
                    Ok(()) => break, // unreachable for fatal errors
                    Err(e) => return Err(e),
                }
            }};
        }

        'outer: loop {
            let frame = self.frames.last().unwrap();
            let func = Rc::clone(&frame.func);
            let mut ip = frame.ip;
            let base = frame.base;
            let chunk: &Chunk = &func.proto.chunk;

            loop {
                let op_ip = ip;
                let byte = chunk.code[ip];
                ip += 1;
                let op = match Op::from_byte(byte) {
                    Some(op) => op,
                    None => rt_fatal!(op_ip, format!("corrupt bytecode: unknown opcode {byte}")),
                };
                match op {
                    Op::Constant => {
                        let ci = read_u16(chunk, &mut ip);
                        let v = chunk.consts[ci as usize].clone();
                        self.stack.push(v);
                    }
                    Op::Null => self.stack.push(Value::Null),
                    Op::True => self.stack.push(Value::Bool(true)),
                    Op::False => self.stack.push(Value::Bool(false)),
                    Op::Pop => {
                        if self.stack.len() <= base {
                            rt_fatal!(op_ip, "internal error: stack underflow in Pop");
                        }
                        let new_len = self.stack.len() - 1;
                        self.close_upvalues_ge(new_len);
                        self.stack.truncate(new_len);
                    }
                    Op::PopN => {
                        let n = chunk.code[ip] as usize;
                        ip += 1;
                        if self.stack.len() < base + n {
                            rt_fatal!(op_ip, "internal error: stack underflow in PopN");
                        }
                        let new_len = self.stack.len() - n;
                        self.close_upvalues_ge(new_len);
                        self.stack.truncate(new_len);
                    }
                    Op::GetLocal => {
                        let slot = chunk.code[ip] as usize;
                        ip += 1;
                        let v = self.stack[base + slot].clone();
                        self.stack.push(v);
                    }
                    Op::SetLocal => {
                        let slot = chunk.code[ip] as usize;
                        ip += 1;
                        let v = self.stack.pop().unwrap();
                        self.stack[base + slot] = v;
                    }
                    Op::GetUpvalue => {
                        let idx = chunk.code[ip] as usize;
                        ip += 1;
                        let cell = Rc::clone(&func.upvalues[idx]);
                        let v = self.upvalue_read(&cell);
                        self.stack.push(v);
                    }
                    Op::SetUpvalue => {
                        let idx = chunk.code[ip] as usize;
                        ip += 1;
                        let v = self.stack.pop().unwrap();
                        let cell = Rc::clone(&func.upvalues[idx]);
                        self.upvalue_write(&cell, v);
                    }
                    Op::DefineGlobal | Op::DefineGlobalConst => {
                        let ci = read_u16(chunk, &mut ip);
                        let v = self.stack.pop().unwrap();
                        let name: Rc<str> = match &chunk.consts[ci as usize] {
                            Value::Str(s) => Rc::clone(s),
                            _ => rt_fatal!(op_ip, "internal error: global name constant is not a string"),
                        };
                        self.globals.insert(
                            name,
                            GlobalCell { value: v, mutable: op == Op::DefineGlobal },
                        );
                    }
                    Op::GetGlobal => {
                        let ci = read_u16(chunk, &mut ip);
                        // Borrowed lookup: no String allocation, no copy of
                        // the name (26.0.9.0 — this used to to_string() the
                        // name on every global read).
                        let v = match &chunk.consts[ci as usize] {
                            Value::Str(s) => {
                                if let Some(mg) = &func.globals {
                                    // Module closure: its own module first;
                                    // the outer table is only good for
                                    // builtins (26.0.12.2).
                                    let m = mg.borrow();
                                    match m.get(&**s) {
                                        Some(c) => Some(c.value.clone()),
                                        None => self.globals.get(&**s).and_then(|c| {
                                            if matches!(c.value, Value::Native(_)) {
                                                Some(c.value.clone())
                                            } else {
                                                None
                                            }
                                        }),
                                    }
                                } else {
                                    self.globals.get(&**s).map(|c| c.value.clone())
                                }
                            }
                            _ => rt_fatal!(op_ip, "internal error: global name constant is not a string"),
                        };
                        match v {
                            Some(v) => self.stack.push(v),
                            None => {
                                let name = match &chunk.consts[ci as usize] {
                                    Value::Str(s) => s.to_string(),
                                    _ => String::new(),
                                };
                                rtc!(op_ip, "UNDEFINED_VAR", format!("undefined variable '{name}'"))
                            }
                        }
                    }
                    Op::SetGlobal => {
                        let ci = read_u16(chunk, &mut ip);
                        let v = self.stack.pop().unwrap();
                        let name: Rc<str> = match &chunk.consts[ci as usize] {
                            Value::Str(s) => Rc::clone(s),
                            _ => rt_fatal!(op_ip, "internal error: global name constant is not a string"),
                        };
                        if let Some(mg) = &func.globals {
                            // Module closure: write its own module's snapshot
                            // (26.0.12.2). 0 = done, 1 = immutable, 2 = missing.
                            let mut val = Some(v);
                            let outcome = {
                                let mut m = mg.borrow_mut();
                                match m.get_mut(&*name) {
                                    Some(cell) if cell.mutable || self.repl => {
                                        cell.value = val.take().unwrap();
                                        0
                                    }
                                    Some(_) => 1,
                                    None => 2,
                                }
                            };
                            match outcome {
                                0 => {}
                                1 => rtc!(op_ip, "IMMUTABLE", format!(
                                    "cannot assign to immutable variable '{name}' (declared with 'let')"
                                )),
                                _ => {
                                    if self
                                        .globals
                                        .get(&*name)
                                        .map_or(true, |c| matches!(c.value, Value::Native(_)))
                                    {
                                        mg.borrow_mut().insert(
                                            name,
                                            GlobalCell { value: val.take().unwrap(), mutable: true },
                                        );
                                    } else {
                                        rtc!(op_ip, "UNDEFINED_VAR", format!(
                                            "undefined variable '{name}' (it belongs to the importer)"
                                        ));
                                    }
                                }
                            }
                        } else {
                            match self.globals.get_mut(&*name) {
                                None => rtc!(op_ip, "UNDEFINED_VAR", format!("undefined variable '{name}'")),
                                Some(cell) => {
                                    if !cell.mutable && !self.repl {
                                        rtc!(op_ip, "IMMUTABLE", format!(
                                            "cannot assign to immutable variable '{name}' (declared with 'let')"
                                        ));
                                    }
                                    cell.value = v;
                                }
                            }
                        }
                    }
                    Op::Equal => {
                        let rhs = self.stack.pop().unwrap();
                        let li = self.stack.len() - 1;
                        let b = self.stack[li].equals(&rhs);
                        self.stack[li] = Value::Bool(b);
                    }
                    Op::Greater | Op::Less | Op::Le | Op::Ge => {
                        let rhs = self.stack.pop().unwrap();
                        let li = self.stack.len() - 1;
                        let ord = match Value::num_cmp(&self.stack[li], &rhs) {
                            Some(ord) => ord,
                            None => rtc!(op_ip, "TYPE", format!(
                                "cannot compare {} and {} with '{}'",
                                self.stack[li].type_name(),
                                rhs.type_name(),
                                match op {
                                    Op::Greater => ">",
                                    Op::Less => "<",
                                    Op::Le => "<=",
                                    _ => ">=",
                                }
                            )),
                        };
                        use std::cmp::Ordering::*;
                        let b = match op {
                            Op::Greater => ord == Greater,
                            Op::Less => ord == Less,
                            Op::Le => ord != Greater,
                            _ => ord != Less,
                        };
                        self.stack[li] = Value::Bool(b);
                    }
                    Op::Not => {
                        let v = self.stack.pop().unwrap();
                        match v {
                            Value::Bool(b) => self.stack.push(Value::Bool(!b)),
                            other => rtc!(op_ip, "TYPE", format!(
                                "the operand of '!' must be bool, got {}",
                                other.type_name()
                            )),
                        }
                    }
                    Op::Negate => {
                        let v = self.stack.pop().unwrap();
                        match v {
                            Value::Int(i) => match i.checked_neg() {
                                Some(n) => self.stack.push(Value::Int(n)),
                                None => rtc!(op_ip, "INT_OVERFLOW", "integer overflow in unary '-'"),
                            },
                            Value::Float(f) => self.stack.push(Value::Float(-f)),
                            other => rtc!(op_ip, "TYPE", format!(
                                "the operand of unary '-' must be a number, got {}",
                                other.type_name()
                            )),
                        }
                    }
                    Op::FloorDiv => {
                        // Floor division (26.0.12.5): ints floor toward
                        // -infinity like Python's `//`; floats floor the
                        // quotient.
                        let b = self.stack.pop().unwrap();
                        let a = self.stack.pop().unwrap();
                        let r = match (a, b) {
                            (Value::Int(x), Value::Int(y)) => floor_div_i64(op_ip, x, y).map(Value::Int),
                            (Value::Float(x), Value::Float(y)) => Ok(Value::Float((x / y).floor())),
                            (Value::Int(x), Value::Float(y)) => Ok(Value::Float(((x as f64) / y).floor())),
                            (Value::Float(x), Value::Int(y)) => Ok(Value::Float((x / (y as f64)).floor())),
                            (lhs, rhs) => Err(RtError::boxed("TYPE", format!(
                                "'//' needs numbers, got {} and {}",
                                lhs.type_name(),
                                rhs.type_name()
                            ))),
                        };
                        match r {
                            Ok(v) => self.stack.push(v),
                            Err(e) => rte!(op_ip, e),
                        }
                    }
                    Op::Add | Op::Sub | Op::Mul | Op::Div | Op::Mod => {
                        let rhs = self.stack.pop().unwrap();
                        // Fast path (26.0.9.0): numeric operands update the
                        // lhs slot in place — no pop+push pair per binary op.
                        let li = self.stack.len() - 1;
                        let r = match (&self.stack[li], rhs) {
                            (Value::Int(a), Value::Int(b)) => int_arith(op, *a, b).map(Value::Int),
                            (Value::Float(a), Value::Float(b)) => Ok(Value::Float(f_arith(op, *a, b))),
                            (Value::Int(a), Value::Float(b)) => Ok(Value::Float(f_arith(op, *a as f64, b))),
                            (Value::Float(a), Value::Int(b)) => Ok(Value::Float(f_arith(op, *a, b as f64))),
                            (lhs, rhs) => arith(op, lhs.clone(), rhs),
                        };
                        match r {
                            Ok(v) => self.stack[li] = v,
                            Err(e) => rte!(op_ip, e),
                        }
                    }
                    Op::Jump => {
                        let t = read_u16(chunk, &mut ip) as usize;
                        ip = t;
                    }
                    Op::ForRangeExcl | Op::ForRangeIncl => {
                        let idx_slot = chunk.code[ip] as usize;
                        let end_slot = chunk.code[ip + 1] as usize;
                        let elem_slot = chunk.code[ip + 2] as usize;
                        ip += 3;
                        let t = read_u16(chunk, &mut ip) as usize;
                        // Same comparison semantics as the Less/Le opcodes
                        // (numbers, strings via num_cmp; None is an error).
                        let ord = Value::num_cmp(
                            &self.stack[base + idx_slot],
                            &self.stack[base + end_slot],
                        );
                        let cont = match ord {
                            Some(ord) => {
                                use std::cmp::Ordering::*;
                                if op == Op::ForRangeIncl { ord != Greater } else { ord == Less }
                            }
                            None => rtc!(op_ip, "TYPE", format!(
                                "cannot compare {} and {} with '{}'",
                                self.stack[base + idx_slot].type_name(),
                                self.stack[base + end_slot].type_name(),
                                if op == Op::ForRangeIncl { "<=" } else { "<" },
                            )),
                        };
                        if cont {
                            let v = self.stack[base + idx_slot].clone();
                            self.close_upvalue_at(base + elem_slot);
                            self.stack[base + elem_slot] = v;
                        } else {
                            ip = t;
                        }
                    }
                    Op::ForArray => {
                        let iter_slot = chunk.code[ip] as usize;
                        let idx_slot = chunk.code[ip + 1] as usize;
                        let elem_slot = chunk.code[ip + 2] as usize;
                        ip += 3;
                        let t = read_u16(chunk, &mut ip) as usize;
                        let n = match &self.stack[base + iter_slot] {
                            // the same error ArrayLen used to raise
                            Value::Array(a) => a.borrow().len() as i64,
                            other => rtc!(op_ip, "TYPE", format!(
                                "for-in requires an array, got {}",
                                other.type_name()
                            )),
                        };
                        let idx = match &self.stack[base + idx_slot] {
                            Value::Int(i) => *i,
                            _ => rt_fatal!(op_ip, "internal error: for-in index is not an int"),
                        };
                        if idx < n {
                            let obj = self.stack[base + iter_slot].clone();
                            let v = match index_get(obj, Value::Int(idx)) {
                                Ok(v) => v,
                                Err(e) => rte!(op_ip, e),
                            };
                            self.close_upvalue_at(base + elem_slot);
                            self.stack[base + elem_slot] = v;
                        } else {
                            ip = t;
                        }
                    }
                    Op::EnumIs => {
                        // push Bool: is the local a variant of enum E named V?
                        let slot = chunk.code[ip] as usize;
                        ip += 1;
                        let e_ci = read_u16(chunk, &mut ip);
                        let v_ci = read_u16(chunk, &mut ip);
                        let (ename, vname) = match (&chunk.consts[e_ci as usize], &chunk.consts[v_ci as usize]) {
                            (Value::Str(e), Value::Str(v)) => (e, v),
                            _ => rt_fatal!(op_ip, "internal error: EnumIs constants must be strings"),
                        };
                        let hit = match &self.stack[base + slot] {
                            Value::Map(m) => {
                                let mref = m.borrow();
                                let is = |v: &Value, name: &Rc<str>| {
                                    matches!(v, Value::Str(s) if s == name)
                                };
                                mref.get("__enum__").map_or(false, |e| is(e, ename))
                                    && mref.get("__variant__").map_or(false, |v| is(v, vname))
                            }
                            _ => false,
                        };
                        self.stack.push(Value::Bool(hit));
                    }
                    Op::ArgsIs => {
                        // push Bool: does local(m).args[arg] equal consts[k]?
                        let m_slot = chunk.code[ip] as usize;
                        let arg_idx = chunk.code[ip + 1] as usize;
                        ip += 2;
                        let k_ci = read_u16(chunk, &mut ip);
                        let lit = chunk.consts[k_ci as usize].clone();
                        let hit = match &self.stack[base + m_slot] {
                            Value::Map(m) => {
                                let mref = m.borrow();
                                match mref.get("args") {
                                    Some(Value::Array(items)) => {
                                        let items = items.borrow();
                                        items.get(arg_idx).map_or(false, |v| v.equals(&lit))
                                    }
                                    _ => false,
                                }
                            }
                            _ => false,
                        };
                        self.stack.push(Value::Bool(hit));
                    }
                    Op::EnumBind => {
                        // stack[base + dst] = local(m).args[arg_idx]
                        let m_slot = chunk.code[ip] as usize;
                        let arg_idx = chunk.code[ip + 1] as usize;
                        let dst = chunk.code[ip + 2] as usize;
                        ip += 3;
                        let v = match &self.stack[base + m_slot] {
                            Value::Map(m) => {
                                let mref = m.borrow();
                                match mref.get("args") {
                                    Some(Value::Array(items)) => {
                                        let items = items.borrow();
                                        items.get(arg_idx).cloned()
                                    }
                                    _ => None,
                                }
                            }
                            _ => None,
                        };
                        match v {
                            Some(v) => self.stack[base + dst] = v,
                            None => rtc!(op_ip, "TYPE",
                            "match: the enum value does not carry an array payload (was the value modified?)"
                        ),
                        }
                    }
                    Op::JumpIfFalsePeek | Op::JumpIfTruePeek => {
                        let t = read_u16(chunk, &mut ip) as usize;
                        let jump = match self.stack.last() {
                            Some(Value::Bool(b)) => {
                                if op == Op::JumpIfFalsePeek { !*b } else { *b }
                            }
                            Some(other) => rtc!(op_ip, "TYPE", format!(
                                "expected a bool, got {} (conditions and '&&'/'||' operands must be bool)",
                                other.type_name()
                            )),
                            None => rt_fatal!(op_ip, "internal error: stack underflow in JumpIfFalsePeek"),
                        };
                        if jump {
                            ip = t;
                        }
                    }
                    Op::JumpIfFalsePop => {
                        // Fused statement condition: the value is consumed on
                        // both paths (26.0.9.0).
                        let t = read_u16(chunk, &mut ip) as usize;
                        let jump = match self.stack.pop() {
                            Some(Value::Bool(b)) => !b,
                            Some(other) => rtc!(op_ip, "TYPE", format!(
                                "expected a bool, got {} (conditions and '&&'/'||' operands must be bool)",
                                other.type_name()
                            )),
                            None => rt_fatal!(op_ip, "internal error: stack underflow in JumpIfFalsePop"),
                        };
                        let new_len = self.stack.len();
                        self.close_upvalues_ge(new_len);
                        if jump {
                            ip = t;
                        }
                    }
                    Op::IncLocal => {
                        let slot = chunk.code[ip] as usize;
                        ip += 1;
                        let ci = read_u16(chunk, &mut ip);
                        let v = self.stack[base + slot].clone();
                        let new_v = match (&v, &chunk.consts[ci as usize]) {
                            (Value::Int(a), Value::Int(b)) => match a.checked_add(*b) {
                                Some(r) => Value::Int(r),
                                None => rtc!(op_ip, "INT_OVERFLOW", "integer overflow in '+'"),
                            },
                            (Value::Float(a), Value::Float(b)) => Value::Float(a + b),
                            (Value::Int(a), Value::Float(b)) => Value::Float(*a as f64 + *b),
                            (Value::Float(a), Value::Int(b)) => Value::Float(a + *b as f64),
                            (other, _) => rtc!(op_ip, "TYPE", format!(
                                "loop counter must be a number, got {}",
                                other.type_name()
                            )),
                        };
                        self.stack[base + slot] = new_v;
                    }
                    Op::Loop => {
                        let t = read_u16(chunk, &mut ip) as usize;
                        ip = t;
                    }
                    Op::Call => {
                        let argc = chunk.code[ip] as usize;
                        ip += 1;
                        if self.stack.len() < argc + 1 {
                            rt_fatal!(op_ip, "internal error: stack underflow in Call");
                        }
                        let callee_pos = self.stack.len() - argc - 1;
                        let callee = self.stack[callee_pos].clone();
                        match callee {
                            Value::Native(native) => {
                                // Move the arguments into a reusable buffer
                                // (grown once, never re-allocated steady state)
                                // and hand the native a slice — no Vec
                                // allocation per call (26.0.9.0).
                                let mut args = std::mem::take(&mut self.native_args);
                                args.clear();
                                args.extend(self.stack.drain(callee_pos + 1..));
                                self.stack.truncate(callee_pos);
                                let res = (native.func)(self, &args);
                                args.clear();
                                self.native_args = args;
                                match res {
                                    Ok(v) => self.stack.push(v),
                                    Err(e) => rte!(op_ip, e),
                                }
                            }
                            Value::Func(f) => {
                                if f.proto.arity as usize != argc {
                                    let name = if f.proto.name.is_empty() {
                                        "<anonymous>".to_string()
                                    } else {
                                        f.proto.name.clone()
                                    };
                                    match self.raise_arity(
                                        op_ip,
                                        format!(
                                            "function '{}' expects {} argument(s), got {}",
                                            name, f.proto.arity, argc
                                        ),
                                        f.proto.arity as i64,
                                        argc as i64,
                                    ) {
                                        Control::Handled => break,
                                        Control::Fatal(e) => return Err(e),
                                    }
                                }
                                if self.frames.len() >= MAX_FRAMES {
                                    // Fatal on purpose: catching a stack
                                    // overflow and continuing would risk
                                    // overflowing again inside the handler.
                                    rt_fatal!(op_ip, format!(
                                        "stack overflow: call depth exceeded {MAX_FRAMES} frames"
                                    ));
                                }
                                self.frames.last_mut().unwrap().ip = ip;
                                self.frames.push(Frame { func: Rc::clone(&f), ip: 0, base: callee_pos, module: None, ret_override: None });
                                continue 'outer;
                            }
                        Value::Map(ref m)
                            if m
                                .borrow()
                                .get("__isclass__")
                                .map_or(false, |f| matches!(f, Value::Bool(true))) =>
                        {
                            // Calling a class constructs an instance; the
                            // (cold) machinery lives in its own method so
                            // the dispatch loop stays compact.
                            match self.call_class(Rc::clone(m), callee_pos, op_ip, ip) {
                                CallOutcome::Pushed(v) => {
                                    self.stack.push(v);
                                }
                                CallOutcome::Entered => {
                                    continue 'outer;
                                }
                                CallOutcome::Handled => {
                                    break; // a handler took over
                                }
                                CallOutcome::Fatal(e) => return Err(e),
                            }
                        }
                            other => rtc!(op_ip, "TYPE", format!(
                                "only functions can be called, got {}",
                                other.type_name()
                            )),
                        }
                    }
                    Op::Closure => {
                        let ci = read_u16(chunk, &mut ip);
                        let proto = match &chunk.consts[ci as usize] {
                            Value::Proto(p) => Rc::clone(p),
                            _ => rt_fatal!(op_ip, "internal error: Closure constant is not a prototype"),
                        };
                        let mut upvalues = Vec::with_capacity(proto.upvalues.len());
                        // One (is_local, index) descriptor pair per captured
                        // variable follows the constant index in the stream.
                        for _ in 0..proto.upvalues.len() {
                            let is_local = chunk.code[ip] == 1;
                            let idx = chunk.code[ip + 1] as usize;
                            ip += 2;
                            if is_local {
                                upvalues.push(self.capture_upvalue(base + idx));
                            } else {
                                let cell = Rc::clone(&func.upvalues[idx]);
                                upvalues.push(cell);
                            }
                        }
                        let globals = match &self.frames.last().unwrap().module {
                            Some(m) => Some(Rc::clone(&m.globals)),
                            None => func.globals.clone(),
                        };
                        self.stack.push(Value::Func(Rc::new(FunctionVal { proto, upvalues, globals })));
                    }
                    Op::Return => {
                        let result = self.stack.pop();
                        let mut frame = self.frames.pop().unwrap();
                        let frame_base = frame.base;
                        self.close_upvalues_ge(frame_base);
                        self.stack.truncate(frame_base);
                        // Handlers registered by the returning frame die with it.
                        while self
                            .handlers
                            .last()
                            .map_or(false, |h| h.frame_count > self.frames.len())
                        {
                            self.handlers.pop();
                        }
                        // A module frame returns its export map and restores
                        // the importer's globals.
                        let value = match frame.module {
                            Some(ctx) => {
                                let mut map = crate::value::ValueMap::default();
                                let module_globals = std::mem::take(&mut self.globals);
                                for (k, cell) in &module_globals {
                                    if !matches!(cell.value, Value::Native(_)) {
                                        map.insert(Rc::clone(k), cell.value.clone());
                                    }
                                }
                                // Closures from this module resolve names
                                // against this snapshot from now on (26.0.12.2).
                                *ctx.globals.borrow_mut() = module_globals;
                                self.globals = ctx.saved_globals;
                                let v = Value::Map(Rc::new(RefCell::new(map)));
                                self.modules.insert(ctx.path, v.clone());
                                v
                            }
                            None => result.unwrap_or(Value::Null),
                        };
                        // A constructor call returns the instance even when
                        // init returns nothing.
                        let value = frame.ret_override.take().unwrap_or(value);
                        if self.frames.is_empty() {
                            return Ok(());
                        }
                        self.stack.push(value);
                        continue 'outer;
                    }
                    Op::Array => {
                        let n = read_u16(chunk, &mut ip) as usize;
                        let mut items = Vec::with_capacity(n);
                        for _ in 0..n {
                            items.push(self.stack.pop().unwrap());
                        }
                        items.reverse();
                        self.stack.push(Value::Array(Rc::new(RefCell::new(items))));
                    }
                    Op::Map => {
                        let n = read_u16(chunk, &mut ip) as usize;
                        let mut pairs = Vec::with_capacity(n);
                        for _ in 0..n {
                            let v = self.stack.pop().unwrap();
                            let k = self.stack.pop().unwrap();
                            pairs.push((k, v));
                        }
                        pairs.reverse();
                        let mut map = crate::value::ValueMap::with_capacity_and_hasher(n, Default::default());
                        for (k, v) in pairs {
                            match k {
                                Value::Str(s) => {
                                    map.insert(s, v);
                                }
                                other => rtc!(op_ip, "TYPE", format!(
                                    "map keys must be strings, got {}",
                                    other.type_name()
                                )),
                            }
                        }
                        self.stack.push(Value::Map(Rc::new(RefCell::new(map))));
                    }
                    Op::IndexGet => {
                        let idx = self.stack.pop().unwrap();
                        let obj = self.stack.pop().unwrap();
                        // Fast path: m[key] on a hit (the hot shape); every
                        // miss and non-map shape goes through the helper,
                        // which owns the typed errors (26.0.10.0).
                        if let (Value::Map(m), Value::Str(k)) = (&obj, &idx) {
                            if let Some(v) = m.borrow().get(&**k).cloned() {
                                self.stack.push(v);
                                continue;
                            }
                        }
                        match index_get(obj, idx) {
                            Ok(v) => self.stack.push(v),
                            Err(e) => rte!(op_ip, e),
                        }
                    }
                    Op::IndexSet => {
                        let value = self.stack.pop().unwrap();
                        let idx = self.stack.pop().unwrap();
                        let obj = self.stack.pop().unwrap();
                        // Fast path: m[key] = value (the hot shape).
                        if let (Value::Map(m), Value::Str(k)) = (&obj, &idx) {
                            m.borrow_mut().insert(Rc::clone(k), value);
                            continue;
                        }
                        match index_set(obj, idx, value) {
                            Ok(()) => {}
                            Err(e) => rte!(op_ip, e),
                        }
                    }
                    Op::CallMethod => {
                        // obj.key(args): an own field holding a function is
                        // called unbound; an instance's method is looked up
                        // the class chain and called with self bound.
                        let argc = chunk.code[ip] as usize;
                        ip += 1;
                        if self.stack.len() < argc + 2 {
                            rt_fatal!(op_ip, "internal error: stack underflow in CallMethod");
                        }
                        let obj_pos = self.stack.len() - argc - 2;
                        let obj = self.stack[obj_pos].clone();
                        let key = match &self.stack[obj_pos + 1] {
                            Value::Str(k) => Rc::clone(k),
                            _ => rt_fatal!(op_ip, "internal error: method name must be a string"),
                        };
                        // A property holding a class (e.g. a class exported
                        // by a module) constructs on call, exactly like
                        // `C()` (26.0.12.13); functions call as before.
                        enum PropCallee {
                            Func(Rc<FunctionVal>, Option<Value>),
                            Class(Rc<RefCell<crate::value::ValueMap>>),
                        }
                        let callee = match &obj {
                            Value::Map(m) => {
                                let mref = m.borrow();
                                if let Some(v) = mref.get(&*key) {
                                    match v {
                                        Value::Func(f) => PropCallee::Func(Rc::clone(f), None),
                                        Value::Map(cm) if is_class(v) => {
                                            PropCallee::Class(Rc::clone(cm))
                                        }
                                        other => rtc!(op_ip, "TYPE", format!(
                                            "property '{key}' of a {} is not a function",
                                            other.type_name()
                                        )),
                                    }
                                } else if let Some(Value::Map(class)) = mref.get("__class__") {
                                    let class = Value::Map(Rc::clone(class));
                                    match find_method(&class, &key) {
                                        Some(f) => PropCallee::Func(f, Some(obj.clone())),
                                        None => rtc!(op_ip, "UNKNOWN_METHOD", format!(
                                            "unknown method '{key}' in class '{}'",
                                            class_name(&class)
                                        )),
                                    }
                                } else {
                                    rtc!(op_ip, "UNKNOWN_METHOD", format!("unknown method or field '{key}'"))
                                }
                            }
                            other => rtc!(op_ip, "TYPE", format!(
                                "cannot call methods on {}",
                                other.type_name()
                            )),
                        };
                        let (f, bound_self) = match callee {
                            PropCallee::Class(cm) => {
                                // Reshape [obj, key, args...] into the plain
                                // call shape [class, args...] and construct.
                                self.stack[obj_pos] = Value::Map(Rc::clone(&cm));
                                self.stack.remove(obj_pos + 1);
                                match self.call_class(cm, obj_pos, op_ip, ip) {
                                    CallOutcome::Pushed(v) => {
                                        self.stack.push(v);
                                    }
                                    CallOutcome::Entered => {
                                        continue 'outer;
                                    }
                                    CallOutcome::Handled => {
                                        break;
                                    }
                                    CallOutcome::Fatal(e) => return Err(e),
                                }
                                continue;
                            }
                            PropCallee::Func(f, bound_self) => (f, bound_self),
                        };
                        let self_extra = if bound_self.is_some() { 1 } else { 0 };
                        if f.proto.arity as usize != argc + self_extra {
                            match self.raise_arity(
                            op_ip,
                            format!(
                                "method '{key}' expects {} argument(s), got {}",
                                f.proto.arity as usize - self_extra,
                                argc
                            ),
                            f.proto.arity as i64 - self_extra as i64,
                            argc as i64,
                        ) {
                            Control::Handled => break,
                            Control::Fatal(e) => return Err(e),
                        }
                        }
                        if self.frames.len() >= MAX_FRAMES {
                            rt_fatal!(op_ip, format!(
                                "stack overflow: call depth exceeded {MAX_FRAMES} frames"
                            ));
                        }
                        self.frames.last_mut().unwrap().ip = ip;
                        let args: Vec<Value> = self.stack.drain(obj_pos + 2..).collect();
                        self.stack.truncate(obj_pos);
                        self.stack.push(Value::Func(Rc::clone(&f)));
                        if let Some(inst) = bound_self {
                            self.stack.push(inst);
                        }
                        self.stack.extend(args);
                        self.frames.push(Frame {
                            func: f,
                            ip: 0,
                            base: obj_pos,
                            module: None,
                            ret_override: None,
                        });
                        continue 'outer;
                    }
                    Op::SuperMethod => {
                        // Push the parent class's method for super.name(...);
                        // self is local slot 0 of the enclosing method frame.
                        // The parent is resolved from the class that DEFINES
                        // the running method (closure identity in the
                        // instance's chain), not from the instance's own
                        // class: with self.__class__ a 3-level chain called
                        // the middle init forever (26.0.12.7).
                        let ni = read_u16(chunk, &mut ip);
                        let name = match &chunk.consts[ni as usize] {
                            Value::Str(s) => s.to_string(),
                            _ => rt_fatal!(op_ip, "internal error: SuperMethod name"),
                        };
                        let frame = self.frames.last().unwrap();
                        let base = frame.base;
                        let running = Rc::clone(&frame.func);
                        let this = match self.stack.get(base + 1) {
                            Some(v) => v.clone(),
                            None => rtc!(op_ip, "TYPE", "super can only be used inside a method"),
                        };
                        let parent = match &this {
                            Value::Map(m) => {
                                let class = m.borrow().get("__class__").and_then(|c| match c {
                                    Value::Map(cm) => Some(Rc::clone(cm)),
                                    _ => None,
                                });
                                match class {
                                    Some(cm) => {
                                        // Walk the chain: the first class
                                        // whose `name` entry IS the running
                                        // closure is the defining class.
                                        let mut defining: Option<Rc<RefCell<crate::value::ValueMap>>> = None;
                                        let mut cur = Some(Rc::clone(&cm));
                                        for _ in 0..256 {
                                            let c = match cur {
                                                Some(c) => c,
                                                None => break,
                                            };
                                            let (hit, next) = {
                                                let mref = c.borrow();
                                                let hit = matches!(
                                                    mref.get(name.as_str()),
                                                    Some(Value::Func(f)) if Rc::ptr_eq(f, &running)
                                                );
                                                let next = match mref.get("__parent__") {
                                                    Some(Value::Map(pm)) => Some(Rc::clone(pm)),
                                                    _ => None,
                                                };
                                                (hit, next)
                                            };
                                            if hit {
                                                defining = Some(c);
                                                break;
                                            }
                                            cur = next;
                                        }
                                        match defining {
                                            Some(def) => {
                                                let parent = def.borrow().get("__parent__").cloned();
                                                match parent {
                                                    Some(p @ Value::Map(_)) => p,
                                                    _ => rtc!(op_ip, "UNKNOWN_METHOD", format!(
                                                        "super: class '{}' has no parent",
                                                        class_name(&Value::Map(def))
                                                    )),
                                                }
                                            }
                                            None => rtc!(op_ip, "UNKNOWN_METHOD", format!(
                                                "super: method '{name}' is not defined in the class chain of '{}'",
                                                class_name(&Value::Map(cm))
                                            )),
                                        }
                                    }
                                    None => rtc!(op_ip, "TYPE", "super can only be used inside a method"),
                                }
                            }
                            _ => rtc!(op_ip, "TYPE", "super can only be used inside a method"),
                        };
                        match find_method(&parent, &name) {
                            Some(f) => self.stack.push(Value::Func(f)),
                            None => rtc!(op_ip, "UNKNOWN_METHOD", format!("super: unknown method '{name}'")),
                        }
                    }
                    Op::InstanceOf => {
                        let rhs = self.stack.pop().unwrap();
                        let lhs = self.stack.pop().unwrap();
                        let hit = match (&lhs, &rhs) {
                            (Value::Map(inst), Value::Map(cls)) => {
                                // `x instanceof SomeEnum` (26.0.11.0): true
                                // for any variant of that enum.
                                let rhs_is_enum = cls
                                    .borrow()
                                    .get("__enum__")
                                    .map_or(false, |v| matches!(v, Value::Str(_)));
                                if rhs_is_enum {
                                    inst.borrow().get("__enum__").map_or(false, |e| {
                                        cls.borrow()
                                            .get("__enum__")
                                            .map_or(false, |c| e.equals(c))
                                    })
                                } else {
                                    inst.borrow()
                                        .get("__class__")
                                        .and_then(|c| class_chain_has(c, &rhs))
                                        .unwrap_or(false)
                                }
                            }
                            _ => false,
                        };
                        self.stack.push(Value::Bool(hit));
                    }
                    Op::SliceGet => {
                        let step = self.stack.pop().unwrap();
                        let end = self.stack.pop().unwrap();
                        let start = self.stack.pop().unwrap();
                        let obj = self.stack.pop().unwrap();
                        match slice_get(obj, start, end, step) {
                            Ok(v) => self.stack.push(v),
                            Err(e) => rte!(op_ip, e),
                        }
                    }
                    Op::IndexGetKeep => {
                        // obj and idx stay on the stack; the element is
                        // pushed on top (compound assignment support).
                        let idx = self.stack.last().cloned().unwrap_or(Value::Null);
                        let obj = self
                            .stack
                            .get(self.stack.len().wrapping_sub(2))
                            .cloned()
                            .unwrap_or(Value::Null);
                        match index_get(obj, idx) {
                            Ok(v) => self.stack.push(v),
                            Err(e) => rte!(op_ip, e),
                        }
                    }
                    Op::ArrayLen => {
                        let v = self.stack.pop().unwrap();
                        match v {
                            Value::Array(a) => {
                                let n = a.borrow().len() as i64;
                                self.stack.push(Value::Int(n));
                            }
                            other => rtc!(op_ip, "TYPE", format!(
                                "for-in requires an array, got {}",
                                other.type_name()
                            )),
                        }
                    }
                    Op::PopNUnder => {
                        // Pop n cells from under the top value (match keeps
                        // its result while dropping hidden slots).
                        let n = chunk.code[ip] as usize;
                        ip += 1;
                        if self.stack.len() < base + n + 1 {
                            rt_fatal!(op_ip, "internal error: stack underflow in PopNUnder");
                        }
                        let top = self.stack.pop().unwrap();
                        let new_len = self.stack.len() - n;
                        // No upvalue can target the hidden match slots.
                        self.stack.truncate(new_len);
                        self.stack.push(top);
                    }
                    Op::BitAnd | Op::BitOr | Op::BitXor | Op::Shl | Op::Shr => {
                        let rhs = self.stack.pop().unwrap();
                        let lhs = self.stack.pop().unwrap();
                        match bitwise(op, lhs, rhs) {
                            Ok(v) => self.stack.push(v),
                            Err(e) => rte!(op_ip, e),
                        }
                    }
                    Op::BitNot => {
                        let v = self.stack.pop().unwrap();
                        match v {
                            Value::Int(i) => self.stack.push(Value::Int(!i)),
                            Value::Bool(b) => self.stack.push(Value::Bool(!b)),
                            other => rtc!(op_ip, "TYPE", format!(
                                "the operand of '~' must be int or bool, got {}",
                                other.type_name()
                            )),
                        }
                    }
                    Op::Pow => {
                        let rhs = self.stack.pop().unwrap();
                        let lhs = self.stack.pop().unwrap();
                        match pow_values(lhs, rhs) {
                            Ok(v) => self.stack.push(v),
                            Err(e) => rte!(op_ip, e),
                        }
                    }
                    Op::TryCatch => {
                        let catch_ip = read_u16(chunk, &mut ip) as usize;
                        self.handlers.push(Handler {
                            frame_count: self.frames.len(),
                            catch_ip,
                            stack_len: self.stack.len(),
                        });
                    }
                    Op::PopHandler => {
                        if self.handlers.pop().is_none() {
                            rt_fatal!(op_ip, "internal error: PopHandler with no active handler");
                        }
                    }
                    Op::Throw => {
                        let v = self.stack.pop().unwrap();
                        self.frames.last_mut().unwrap().ip = op_ip;
                        match self.op_throw(v) {
                            Control::Handled => break, // a handler took over
                            Control::Fatal(e) => return Err(e),
                        }
                    }
                    Op::Import => {
                        // Stack: [proto, path] -> [export map]. First import
                        // runs the module in a fresh global scope via a
                        // module frame; its Return builds the map.
                        let path = match self.stack.pop().unwrap() {
                            Value::Str(s) => s.to_string(),
                            _ => rt_fatal!(op_ip, "internal error: Import path is not a string"),
                        };
                        let proto = match self.stack.pop().unwrap() {
                            Value::Proto(p) => p,
                            _ => rt_fatal!(op_ip, "internal error: Import constant is not a prototype"),
                        };
                        if let Some(m) = self.modules.get(&path) {
                            self.stack.push(m.clone());
                        } else {
                            let saved_globals = std::mem::take(&mut self.globals);
                            self.globals = HashMap::default();
                            crate::builtins::install(self);
                            self.frames.last_mut().unwrap().ip = ip;
                            let func = Rc::new(FunctionVal { proto, upvalues: Vec::new(), globals: None });
                            self.stack.push(Value::Func(Rc::clone(&func)));
                            let base2 = self.stack.len() - 1;
                            let holder: Rc<RefCell<GlobalMap>> = Rc::new(RefCell::new(HashMap::default()));
                            self.frames.push(Frame {
                                func,
                                ip: 0,
                                base: base2,
                                module: Some(Box::new(ModuleCtx { path, saved_globals, globals: holder })),
                                ret_override: None,
                            });
                            continue 'outer;
                        }
                    }
                    Op::ToString => {
                        let v = self.stack.pop().unwrap();
                        self.stack.push(Value::str(v.display_string(0)));
                    }
                    Op::StrJoin => {
                        let n = chunk.code[ip] as usize;
                        ip += 1;
                        if self.stack.len() < base + n {
                            rt_fatal!(op_ip, "internal error: stack underflow in StrJoin");
                        }
                        let mut parts = Vec::with_capacity(n);
                        for _ in 0..n {
                            let v = self.stack.pop().unwrap();
                            match v {
                                Value::Str(s) => parts.push(s),
                                other => rt!(op_ip, format!(
                                    "internal error: StrJoin of a non-string ({})",
                                    other.type_name()
                                )),
                            }
                        }
                        parts.reverse();
                        let joined: String = parts.concat();
                        self.stack.push(Value::str(joined));
                    }
                }
            }
        }
    }

    // ---- error handling -----------------------------------------------------

    /// Raise a runtime error. With `catchable` and an active `try` handler,
    /// unwind the frames and stack to the handler's registration point and
    /// resume in its catch block with the message on the stack; otherwise
    /// return the error (with a full stack trace) to the caller.
    fn raise(
        &mut self,
        code: &str,
        msg: impl Into<String>,
        detail: Value,
        catchable: bool,
    ) -> Result<(), RscpError> {
        let msg = msg.into();
        let handler = if catchable { self.handlers.last().copied() } else { None };
        let Some(h) = handler else {
            return Err(rt_error(self, code, msg));
        };
        let v = crate::value::error_value(code, msg, detail);
        self.unwind_to(h, v);
        Ok(())
    }

    /// Rethrow an already-built error value — a `catch` guard declined it or
    /// the user did `throw e` on an error object. The very same map travels
    /// on (identity and custom fields preserved).
    fn raise_error_value(&mut self, v: Value) -> Result<(), RscpError> {
        let Some(h) = self.handlers.last().copied() else {
            // uncaught: render from the map's own code/message
            let (code, msg) = match &v {
                Value::Map(m) => {
                    let mref = m.borrow();
                    let code = mref.get("code").map_or("USER".to_string(), |c| match c {
                        Value::Str(s) => s.to_string(),
                        _ => "USER".to_string(),
                    });
                    let msg = mref.get("message").map_or(String::new(), |c| match c {
                        Value::Str(s) => s.to_string(),
                        _ => String::new(),
                    });
                    (code, msg)
                }
                _ => ("USER".to_string(), v.display_string(0)),
            };
            return Err(rt_error(self, &code, msg));
        };
        self.unwind_to(h, v);
        Ok(())
    }

    /// Raise an ARITY error with the standard detail payload — cold, and
    /// kept out of the dispatch loop so its code does not shift the hot
    /// blocks around (26.0.10.0).
    #[cold]
    fn raise_arity(&mut self, op_ip: usize, msg: String, expected: i64, got: i64) -> Control {
        self.frames.last_mut().unwrap().ip = op_ip;
        let d = crate::value::detail(&[
            ("expected", Value::Int(expected)),
            ("got", Value::Int(got)),
        ]);
        match self.raise("ARITY", msg, d, true) {
            Ok(()) => Control::Handled,
            Err(e) => Control::Fatal(e),
        }
    }

    /// Calling a class value constructs an instance: a map
    /// `{"__class__": class}`; `init` (if any) runs with the instance as
    /// self, and the instance is the value of the whole call. Cold: kept
    /// out of the dispatch loop (26.0.10.0).
    #[cold]
    fn call_class(
        &mut self,
        class_map: Rc<RefCell<crate::value::ValueMap>>,
        callee_pos: usize,
        op_ip: usize,
        ip: usize,
    ) -> CallOutcome {
        let args: Vec<Value> = self.stack.drain(callee_pos + 1..).collect();
        self.stack.truncate(callee_pos);
        let class = Value::Map(Rc::clone(&class_map));
        // Declared fields (26.0.12.6) start as null: a forgotten assignment
        // reads as null instead of MISSING_KEY.
        let field_names: Vec<Rc<str>> = {
            let mref = class_map.borrow();
            match mref.get("__fields__") {
                Some(Value::Array(items)) => items
                    .borrow()
                    .iter()
                    .filter_map(|v| match v {
                        Value::Str(s) => Some(Rc::clone(s)),
                        _ => None,
                    })
                    .collect(),
                _ => Vec::new(),
            }
        };
        let mut instance_map = crate::value::ValueMap::default();
        instance_map.insert(Rc::from("__class__") as Rc<str>, class.clone());
        for f in field_names {
            instance_map.insert(f, Value::Null);
        }
        let instance = Value::Map(Rc::new(RefCell::new(instance_map)));
        match find_method(&class, "init") {
            Some(init) => {
                if init.proto.arity as usize != args.len() + 1 {
                    return match self.raise_arity(
                        op_ip,
                        format!(
                            "init of class '{}' expects {} argument(s), got {}",
                            class_name(&class),
                            init.proto.arity - 1,
                            args.len()
                        ),
                        init.proto.arity as i64 - 1,
                        args.len() as i64,
                    ) {
                        Control::Handled => CallOutcome::Handled,
                        Control::Fatal(e) => CallOutcome::Fatal(e),
                    };
                }
                if self.frames.len() >= MAX_FRAMES {
                    // Fatal on purpose: catching a stack overflow and
                    // continuing would risk overflowing again inside the
                    // handler.
                    self.frames.last_mut().unwrap().ip = op_ip;
                    return CallOutcome::Fatal(rt_error(
                        self,
                        "FATAL",
                        format!("stack overflow: call depth exceeded {MAX_FRAMES} frames"),
                    ));
                }
                self.frames.last_mut().unwrap().ip = ip;
                self.stack.push(Value::Func(Rc::clone(&init)));
                self.stack.push(instance.clone());
                self.stack.extend(args);
                self.frames.push(Frame {
                    func: init,
                    ip: 0,
                    base: callee_pos,
                    module: None,
                    ret_override: Some(instance),
                });
                CallOutcome::Entered
            }
            None => {
                if !args.is_empty() {
                    self.frames.last_mut().unwrap().ip = op_ip;
                    return match self.raise(
                        "ARITY",
                        format!(
                            "class '{}' has no init and takes no arguments",
                            class_name(&class)
                        ),
                        Value::Null,
                        true,
                    ) {
                        Ok(()) => CallOutcome::Handled,
                        Err(e) => CallOutcome::Fatal(e),
                    };
                }
                CallOutcome::Pushed(instance)
            }
        }
    }

    /// The `throw` instruction, kept out of `exec` so the dispatch loop
    /// stays compact (cold: user throws are rare in hot loops).
    /// An existing error object (from `error()`, a `throw e` rethrow, or a
    /// declined catch guard) travels on unchanged; a thrown map may carry
    /// its own `code`/`message` fields; everything else becomes code USER.
    #[cold]
    fn op_throw(&mut self, v: Value) -> Control {
        if crate::value::is_error_value(&v) {
            return match self.raise_error_value(v) {
                Ok(()) => Control::Handled,
                Err(e) => Control::Fatal(e),
            };
        }
        let (code, msg) = match &v {
            Value::Map(m) => {
                let mref = m.borrow();
                let code = mref.get("code").and_then(|c| match c {
                    Value::Str(s) => Some(s.to_string()),
                    _ => None,
                });
                let msg = mref.get("message").and_then(|c| match c {
                    Value::Str(s) => Some(s.to_string()),
                    _ => None,
                });
                (code, msg)
            }
            _ => (None, None),
        };
        let detail = if matches!(v, Value::Map(_)) { v.clone() } else { Value::Null };
        let code = code.unwrap_or_else(|| "USER".to_string());
        let msg = msg.unwrap_or_else(|| v.display_string(0));
        match self.raise(&code, msg, detail, true) {
            Ok(()) => Control::Handled,
            Err(e) => Control::Fatal(e),
        }
    }

    /// Unwind to a registered `try` handler and resume in its catch code
    /// with the error value pushed onto the stack.
    fn unwind_to(&mut self, h: Handler, v: Value) {
        while self.frames.len() > h.frame_count {
            self.frames.pop();
        }
        self.close_upvalues_ge(h.stack_len);
        self.stack.truncate(h.stack_len);
        if let Some(f) = self.frames.last_mut() {
            f.ip = h.catch_ip;
        }
        self.handlers.pop();
        self.stack.push(v);
    }

    // ---- upvalues ----------------------------------------------------------

    fn upvalue_read(&self, cell: &Rc<RefCell<Upvalue>>) -> Value {
        match &*cell.borrow() {
            Upvalue::Open(i) => self.stack[*i].clone(),
            Upvalue::Closed(v) => v.clone(),
        }
    }

    fn upvalue_write(&mut self, cell: &Rc<RefCell<Upvalue>>, v: Value) {
        let open_idx = match &*cell.borrow() {
            Upvalue::Open(i) => Some(*i),
            Upvalue::Closed(_) => None,
        };
        match open_idx {
            Some(i) => self.stack[i] = v,
            None => *cell.borrow_mut() = Upvalue::Closed(v),
        }
    }

    /// Find or create the shared open-upvalue cell for stack slot `slot`.
    fn capture_upvalue(&mut self, slot: usize) -> Rc<RefCell<Upvalue>> {
        for (s, cell) in &self.open_upvalues {
            if *s == slot {
                return Rc::clone(cell);
            }
        }
        let cell = Rc::new(RefCell::new(Upvalue::Open(slot)));
        self.open_upvalues.push((slot, Rc::clone(&cell)));
        cell
    }

    /// Close the open upvalue of exactly one stack slot, if any: the cell
    /// takes ownership of the CURRENT value. Loop heads call this before
    /// refreshing the loop variable so each iteration's closures capture a
    /// fresh cell (26.0.12.16) — the promise "a fresh binding each
    /// iteration" from README/ast was not kept: all closures used to see
    /// the last value.
    fn close_upvalue_at(&mut self, slot: usize) {
        if let Some(i) = self.open_upvalues.iter().position(|(s, _)| *s == slot) {
            let (_, cell) = self.open_upvalues.swap_remove(i);
            let v = self.stack[slot].clone();
            *cell.borrow_mut() = Upvalue::Closed(v);
        }
    }

    /// Close every open upvalue pointing at or above `from`: the owning
    /// stack slots are going away, so the cells take ownership of the values.
    pub fn close_upvalues_ge(&mut self, from: usize) {
        if self.open_upvalues.is_empty() {
            return;
        }
        let mut i = 0;
        while i < self.open_upvalues.len() {
            let (slot, cell) = &self.open_upvalues[i];
            if *slot >= from {
                let v = self.stack[*slot].clone();
                *cell.borrow_mut() = Upvalue::Closed(v);
                self.open_upvalues.swap_remove(i);
            } else {
                i += 1;
            }
        }
    }

    /// Pseudo-random float in [0, 1) (xorshift64*), used by `rand()`.
    pub fn next_rand(&mut self) -> f64 {
        let mut x = self.rng;
        x ^= x >> 12;
        x ^= x << 25;
        x ^= x >> 27;
        self.rng = x;
        let v = x.wrapping_mul(0x2545f4914f6cdd1d);
        (v >> 11) as f64 / (1u64 << 53) as f64
    }
}

fn read_u16(chunk: &Chunk, ip: &mut usize) -> u16 {
    let v = u16::from(chunk.code[*ip]) | (u16::from(chunk.code[*ip + 1]) << 8);
    *ip += 2;
    v
}

fn arith_symbol(op: Op) -> &'static str {
    match op {
        Op::Add => "+",
        Op::Sub => "-",
        Op::Mul => "*",
        Op::Div => "/",
        _ => "%",
    }
}

/// Floor division on ints (26.0.12.5): toward -infinity, like Python's
/// `//` — `-7 // 2` is `-4`. i64::MIN // -1 overflows; // 0 is DIV_ZERO.
fn floor_div_i64(_op_ip: usize, a: i64, b: i64) -> Result<i64, Box<RtError>> {
    if b == 0 {
        return Err(RtError::boxed("DIV_ZERO", "division by zero"));
    }
    let q = match a.checked_div(b) {
        Some(q) => q,
        None => return Err(RtError::boxed("INT_OVERFLOW", "integer overflow in '//'")),
    };
    let r = a % b;
    if r != 0 && ((r < 0) != (b < 0)) {
        Ok(q - 1)
    } else {
        Ok(q)
    }
}

/// Checked int arithmetic for the Add/Sub/Mul/Div/Mod opcodes.
fn int_arith(op: Op, a: i64, b: i64) -> Result<i64, Box<RtError>> {
    let r = match op {
        Op::Add => a.checked_add(b),
        Op::Sub => a.checked_sub(b),
        Op::Mul => a.checked_mul(b),
        Op::Div => {
            if b == 0 {
                return Err(RtError::boxed("DIV_ZERO", "division by zero"));
            }
            a.checked_div(b)
        }
        _ => {
            if b == 0 {
                return Err(RtError::boxed("DIV_ZERO", "modulo by zero"));
            }
            a.checked_rem(b)
        }
    };
    r.ok_or_else(|| RtError::boxed("INT_OVERFLOW", format!("integer overflow in '{}'", arith_symbol(op))))
}

/// Float arithmetic for the Add/Sub/Mul/Div/Mod opcodes.
fn f_arith(op: Op, a: f64, b: f64) -> f64 {
    match op {
        Op::Add => a + b,
        Op::Sub => a - b,
        Op::Mul => a * b,
        Op::Div => a / b,
        _ => a % b,
    }
}

/// Arithmetic for the Add/Sub/Mul/Div/Mod opcodes. Ints are exact (with
/// overflow and division-by-zero errors); mixing int and float promotes to
/// float; `+` also concatenates strings and arrays.
fn arith(op: Op, lhs: Value, rhs: Value) -> Result<Value, Box<RtError>> {
    match (lhs, rhs) {
        (Value::Int(a), Value::Int(b)) => Ok(Value::Int(int_arith(op, a, b)?)),
        (Value::Float(a), Value::Float(b)) => Ok(Value::Float(f_arith(op, a, b))),
        (Value::Int(a), Value::Float(b)) => Ok(Value::Float(f_arith(op, a as f64, b))),
        (Value::Float(a), Value::Int(b)) => Ok(Value::Float(f_arith(op, a, b as f64))),
        (Value::Str(a), Value::Str(b)) if op == Op::Add => {
            let mut s = String::with_capacity(a.len() + b.len());
            s.push_str(&a);
            s.push_str(&b);
            Ok(Value::str(s))
        }
        (Value::Array(a), Value::Array(b)) if op == Op::Add => {
            let mut items = a.borrow().clone();
            items.extend(b.borrow().iter().cloned());
            Ok(Value::Array(Rc::new(RefCell::new(items))))
        }
        (a, b) => Err(RtError::boxed("TYPE", format!(
            "unsupported operand types for '{}': {} and {}",
            arith_symbol(op),
            a.type_name(),
            b.type_name()
        ))),
    }
}

/// Exponentiation. `int ** int` stays exact while the exponent is >= 0
/// (overflow is an error); a negative exponent (or any float operand)
/// produces a float, like Python.
fn pow_values(lhs: Value, rhs: Value) -> Result<Value, Box<RtError>> {
    let num = |v: &Value| -> Result<f64, Box<RtError>> {
        match v {
            Value::Int(i) => Ok(*i as f64),
            Value::Float(f) => Ok(*f),
            other => Err(RtError::boxed("TYPE", format!(
                "'**' needs numbers, got {}",
                other.type_name()
            ))),
        }
    };
    match (&lhs, &rhs) {
        (Value::Int(a), Value::Int(b)) if *b >= 0 => {
            let exp = u32::try_from(*b).map_err(|_| RtError::boxed("INT_OVERFLOW", "integer overflow in '**'"))?;
            a.checked_pow(exp)
                .map(Value::Int)
                .ok_or_else(|| RtError::boxed("INT_OVERFLOW", "integer overflow in '**'"))
        }
        (Value::Int(0), _) => Err(RtError::boxed("MATH", "zero to a negative power")),
        _ => {
            let x = num(&lhs)?;
            let y = num(&rhs)?;
            Ok(Value::Float(x.powf(y)))
        }
    }
}

/// Bitwise ops: two ints (`& | ^ << >>`, shift amounts clamped-checked to
/// 0..64), or two bools for `& | ^`. Any other combination is an error.
fn bitwise(op: Op, lhs: Value, rhs: Value) -> Result<Value, Box<RtError>> {
    let symbol = match op {
        Op::BitAnd => "&",
        Op::BitOr => "|",
        Op::BitXor => "^",
        Op::Shl => "<<",
        _ => ">>",
    };
    match (lhs, rhs) {
        (Value::Int(a), Value::Int(b)) => Ok(Value::Int(match op {
            Op::BitAnd => a & b,
            Op::BitOr => a | b,
            Op::BitXor => a ^ b,
            Op::Shl | Op::Shr => {
                if b < 0 || b >= 64 {
                    return Err(RtError::boxed("TYPE", format!("shift amount must be in 0..64, got {b}")));
                }
                let amt = b as u32;
                if op == Op::Shl { a << amt } else { a >> amt }
            }
            _ => unreachable!(),
        })),
        (Value::Bool(a), Value::Bool(b)) if !matches!(op, Op::Shl | Op::Shr) => {
            Ok(Value::Bool(match op {
                Op::BitAnd => a & b,
                Op::BitOr => a | b,
                _ => a ^ b,
            }))
        }
        (a, b) => Err(RtError::boxed("TYPE", format!(
            "bitwise '{symbol}' needs two ints (or two bools for & | ^), got {} and {}",
            a.type_name(),
            b.type_name()
        ))),
    }
}

/// Index read: array[int], map[string], string[int] (char index).
/// Negative indexes count from the end: a[-1] is the last element.
fn index_get(obj: Value, idx: Value) -> Result<Value, Box<RtError>> {
    match (obj, idx) {
        (Value::Array(a), Value::Int(i)) => {
            let items = a.borrow();
            let len = items.len() as i64;
            let at = if i < 0 { i + len } else { i };
            if at < 0 || at >= len {
                return Err(RtError::boxed_with_detail(
                    "IDX_RANGE",
                    format!("index {i} out of bounds for array of length {len}"),
                    detail(&[("index", Value::Int(i)), ("length", Value::Int(len))]),
                ));
            }
            Ok(items[at as usize].clone())
        }
        (Value::Map(m), Value::Str(k)) => match m.borrow().get(&*k) {
            Some(v) => Ok(v.clone()),
            None => Err(RtError::boxed_with_detail(
                "MISSING_KEY",
                format!("missing key '{k}' in map"),
                detail(&[("key", Value::Str(Rc::clone(&k)))]),
            )),
        },
        (Value::Str(s), Value::Int(i)) => {
            let len = s.chars().count() as i64;
            let at = if i < 0 { i + len } else { i };
            if at < 0 || at >= len {
                return Err(RtError::boxed_with_detail(
                    "IDX_RANGE",
                    format!("index {i} out of bounds for string of length {len}"),
                    detail(&[("index", Value::Int(i)), ("length", Value::Int(len))]),
                ));
            }
            let ch = s.chars().nth(at as usize).unwrap();
            Ok(Value::str(ch.to_string()))
        }
        (obj, idx) => Err(RtError::boxed("TYPE", format!(
            "cannot index {} with {}",
            obj.type_name(),
            idx.type_name()
        ))),
    }
}

/// Index write: array[int] and map[string]. Negative indexes count from
/// the end, like the reads.
fn index_set(obj: Value, idx: Value, value: Value) -> Result<(), Box<RtError>> {
    match (obj, idx) {
        (Value::Array(a), Value::Int(i)) => {
            let mut items = a.borrow_mut();
            let len = items.len() as i64;
            let at = if i < 0 { i + len } else { i };
            if at < 0 || at >= len {
                return Err(RtError::boxed_with_detail(
                    "IDX_RANGE",
                    format!("index {i} out of bounds for array of length {len}"),
                    detail(&[("index", Value::Int(i)), ("length", Value::Int(len))]),
                ));
            }
            items[at as usize] = value;
            Ok(())
        }
        (Value::Map(m), Value::Str(k)) => {
            m.borrow_mut().insert(k, value);
            Ok(())
        }
        (obj, idx) => Err(RtError::boxed("TYPE", format!(
            "cannot assign into {} with {} index",
            obj.type_name(),
            idx.type_name()
        ))),
    }
}

/// Python-style slicing: obj[start:end:step] on arrays and strings.
/// Omitted bounds arrive as Null, negative bounds count from the end,
/// a zero step is an error, and a negative step walks backwards
/// (CPython's slice.indices rules, including the -1 stop sentinel).
fn slice_get(obj: Value, start: Value, end: Value, step: Value) -> Result<Value, Box<RtError>> {
    let step = match step {
        Value::Null => 1,
        Value::Int(0) => return Err(RtError::boxed("MATH", "slice step cannot be zero")),
        Value::Int(i) => i,
        v => return Err(RtError::boxed("TYPE", format!("slice step must be an int, got {}", v.type_name()))),
    };
    let len: i64 = match &obj {
        Value::Array(a) => a.borrow().len() as i64,
        Value::Str(s) => s.chars().count() as i64,
        o => return Err(RtError::boxed("TYPE", format!("cannot slice {}", o.type_name()))),
    };
    let resolve = |v: Value, default: i64| -> Result<i64, Box<RtError>> {
        match v {
            Value::Null => Ok(default),
            Value::Int(i) => Ok(if i < 0 { i + len } else { i }),
            o => Err(RtError::boxed("TYPE", format!("slice bounds must be ints, got {}", o.type_name()))),
        }
    };
    let mut idxs: Vec<usize> = Vec::new();
    if step > 0 {
        let s = resolve(start, 0)?.clamp(0, len);
        let e = resolve(end, len)?.clamp(0, len);
        let mut i = s;
        while i < e {
            idxs.push(i as usize);
            i += step;
        }
    } else {
        // Backwards: the default start is the last element and the default
        // stop sits just before the first (index -1).
        let s = resolve(start, len - 1)?.clamp(-1, len - 1);
        let e = resolve(end, -1)?.clamp(-1, len - 1);
        let mut i = s;
        while i > e {
            idxs.push(i as usize);
            i += step;
        }
    }
    match obj {
        Value::Array(a) => {
            let items = a.borrow();
            let out = idxs.into_iter().map(|i| items[i].clone()).collect();
            Ok(Value::Array(Rc::new(RefCell::new(out))))
        }
        Value::Str(s) => {
            let out: String = idxs.into_iter().map(|i| s.chars().nth(i).unwrap()).collect();
            Ok(Value::str(out))
        }
        o => Err(RtError::boxed("TYPE", format!("cannot slice {}", o.type_name()))),
    }
}


/// True for class objects — maps carrying "__isclass__": true.
#[allow(dead_code)]
fn is_class(v: &Value) -> bool {
    match v {
        Value::Map(m) => m
            .borrow()
            .get("__isclass__")
            .map_or(false, |f| matches!(f, Value::Bool(true))),
        _ => false,
    }
}

/// The "__name__" of a class map ("?" when absent).
fn class_name(class: &Value) -> String {
    match class {
        Value::Map(m) => m.borrow().get("__name__").map_or_else(
            || "?".to_string(),
            |v| match v {
                Value::Str(s) => s.to_string(),
                _ => "?".to_string(),
            },
        ),
        _ => "?".to_string(),
    }
}

/// Find a method by name in a class chain (depth-capped against cycles).
fn find_method(class: &Value, name: &str) -> Option<Rc<FunctionVal>> {
    let mut cur = Some(class.clone());
    for _ in 0..256 {
        let c = cur?;
        if let Value::Map(m) = &c {
            let mref = m.borrow();
            if let Some(v) = mref.get(name) {
                return match v {
                    Value::Func(f) => Some(Rc::clone(f)),
                    _ => None, // a non-function field shadows the name
                };
            }
            cur = mref.get("__parent__").cloned();
        } else {
            return None;
        }
    }
    None
}

/// Does the class chain of `class` contain `target` (by identity)?
fn class_chain_has(class: &Value, target: &Value) -> Option<bool> {
    let mut cur = Some(class.clone());
    for _ in 0..256 {
        let c = cur?;
        if let (Value::Map(a), Value::Map(b)) = (&c, target) {
            if Rc::ptr_eq(a, b) {
                return Some(true);
            }
            cur = a.borrow().get("__parent__").cloned();
        } else {
            return Some(false);
        }
    }
    Some(false)
}

/// Build a runtime error with a stack trace. Assumes every frame's `ip`
/// already points at (or just after) its failing instruction.
fn rt_error(vm: &Vm, code: &str, msg: impl Into<String>) -> RscpError {
    let mut trace = Vec::new();
    for f in vm.frames.iter().rev() {
        let (line, _) = f.func.proto.chunk.line_at(f.ip);
        trace.push(TraceFrame { name: frame_name(&f.func), line });
    }
    let line = vm
        .frames
        .last()
        .map_or(0, |f| f.func.proto.chunk.line_at(f.ip).0);
    RscpError::Runtime { code: code.to_string(), msg: msg.into(), line, trace }
}

fn frame_name(f: &FunctionVal) -> String {
    if f.proto.name == "<script>" {
        "<script>".to_string()
    } else if f.proto.name.is_empty() {
        "<anonymous fn>".to_string()
    } else {
        format!("fn '{}'", f.proto.name)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::compiler::compile;
    use crate::lexer::Lexer;
    use crate::parser::Parser;

    fn run(src: &str) -> Result<Vm, RscpError> {
        let tokens = Lexer::new(src).tokenize()?;
        let program = Parser::new(tokens).parse()?;
        let proto = compile(&program, std::path::Path::new(""))?;
        let mut vm = Vm::new();
        vm.quiet = true;
        vm.run_script(proto)?;
        Ok(vm)
    }

    fn global(vm: &Vm, name: &str) -> Value {
        vm.globals[name].value.clone()
    }

    #[test]
    fn arithmetic_and_globals() {
        let vm = run("var a = 7 / 2; let b = 7.0 / 2; var c = 7 % 3; var d = 2 + 3 * 4;").unwrap();
        assert!(matches!(global(&vm, "a"), Value::Int(3)));
        assert!(matches!(global(&vm, "b"), Value::Float(f) if (f - 3.5).abs() < 1e-12));
        assert!(matches!(global(&vm, "c"), Value::Int(1)));
        assert!(matches!(global(&vm, "d"), Value::Int(14)));
    }

    #[test]
    fn string_concat_and_index() {
        let vm = run("var s = \"foo\" + \"bar\"; var c = s[0]; var n = len(s);").unwrap();
        assert!(matches!(global(&vm, "s"), Value::Str(ref s) if &**s == "foobar"));
        assert!(matches!(global(&vm, "c"), Value::Str(ref c) if &**c == "f"));
        assert!(matches!(global(&vm, "n"), Value::Int(6)));
    }

    #[test]
    fn closures_share_state() {
        let vm = run(
            "fn make() { var c = 0; fn inc() { c++; return c; } return inc; }\
             var a = make(); var b = make(); a(); a(); var x = a(); var y = b();",
        )
        .unwrap();
        assert!(matches!(global(&vm, "x"), Value::Int(3)));
        assert!(matches!(global(&vm, "y"), Value::Int(1)));
    }

    #[test]
    fn arrays_are_references() {
        let vm = run(
            "var a = [1, 2]; var b = a; push(b, 3); var n = len(a); a[0] = 99; var z = b[0];",
        )
        .unwrap();
        assert!(matches!(global(&vm, "n"), Value::Int(3)));
        assert!(matches!(global(&vm, "z"), Value::Int(99)));
    }

    #[test]
    fn loops_and_break() {
        let vm = run(
            "var s = 0;\
             for (var i = 0; i < 10; i++) { if i == 5 { break; } s += i; }\
             var t = 0; for (let v in [10, 20, 30]) { t += v; }",
        )
        .unwrap();
        assert!(matches!(global(&vm, "s"), Value::Int(10))); // 0+1+2+3+4
        assert!(matches!(global(&vm, "t"), Value::Int(60)));
    }

    #[test]
    fn main_is_autocalled() {
        let vm = run("var x = 1; fn main() { x = 42; }").unwrap();
        assert!(matches!(global(&vm, "x"), Value::Int(42)));
    }

    #[test]
    fn runtime_errors() {
        let cases = [
            ("var x = 1 / 0;", "division by zero"),
            ("let a = [1]; let x = a[5];", "out of bounds"),
            ("let m = {}; let x = m[\"k\"];", "missing key"),
            ("fn f(a, b) { return a; } f(1);", "expects 2 argument"),
            ("var x = nope;", "undefined variable 'nope'"),
            ("let x = 1 + true;", "unsupported operand types"),
            ("var f = 5; f();", "only functions can be called"),
            ("if 1 { }", "expected a bool"),
            ("let x = 1; x = 2;", "immutable"),
            ("fn f() { return g(); } fn g() { return f(); } f();", "stack overflow"),
        ];
        for (src, needle) in cases {
            let err = match run(src) {
                Err(e) => e,
                Ok(_) => panic!("expected a runtime error for: {src}"),
            };
            let msg = format!("{err}");
            assert!(msg.contains(needle), "for {src}: got {msg}");
        }
    }

    #[test]
    fn error_codes_are_stable() {
        // Every catchable error carries a machine-readable code; the
        // accessor is for tests and tooling (26.0.10.0).
        let cases = [
            ("var x = 1 / 0;", "DIV_ZERO"),
            ("var x = 1 % 0;", "DIV_ZERO"),
            ("let a = [1]; let x = a[5];", "IDX_RANGE"),
            ("let m = {}; let x = m[\"k\"];", "MISSING_KEY"),
            ("var x = nope;", "UNDEFINED_VAR"),
            ("let x = 1; x = 2;", "IMMUTABLE"),
            ("fn f(a, b) { return a; } f(1);", "ARITY"),
            ("let x = 1 + true;", "TYPE"),
            ("throw \"boom\";", "USER"),
        ];
        for (src, code) in cases {
            let err = match run(src) {
                Err(e) => e,
                Ok(_) => panic!("expected a runtime error for: {src}"),
            };
            assert_eq!(err.runtime_code(), code, "for {src}");
        }
    }

    #[test]
    fn upvalues_close_at_scope_exit() {
        // Two closures from the same block share one captured local.
        let vm = run(
            "var f = null; var g = null;\
             { var n = 10; f = fn() { n += 1; return n; }; g = fn() { return n; }; }\
             f(); f(); var x = g();",
        )
        .unwrap();
        assert!(matches!(global(&vm, "x"), Value::Int(12)));
    }

    #[test]
    fn ternary_and_logic() {
        let vm = run("var a = true ? 1 : 2; var b = false || true; var c = true && false;").unwrap();
        assert!(matches!(global(&vm, "a"), Value::Int(1)));
        assert!(matches!(global(&vm, "b"), Value::Bool(true)));
        assert!(matches!(global(&vm, "c"), Value::Bool(false)));
    }

    #[test]
    fn bitwise_ops() {
        let vm = run(
            "var a = 0b1100 & 0xA; var b = 0x0F | 0x30; var c = 0xFF ^ 0x0F; \
             var d = 1 << 10; var e = -16 >> 2; var f = ~0; \
             var g = true & false; var h = true | false; var i = true ^ true; var j = ~true;",
        )
        .unwrap();
        assert!(matches!(global(&vm, "a"), Value::Int(8)));
        assert!(matches!(global(&vm, "b"), Value::Int(63)));
        assert!(matches!(global(&vm, "c"), Value::Int(240)));
        assert!(matches!(global(&vm, "d"), Value::Int(1024)));
        assert!(matches!(global(&vm, "e"), Value::Int(-4)));
        assert!(matches!(global(&vm, "f"), Value::Int(-1)));
        assert!(matches!(global(&vm, "g"), Value::Bool(false)));
        assert!(matches!(global(&vm, "h"), Value::Bool(true)));
        assert!(matches!(global(&vm, "i"), Value::Bool(false)));
        assert!(matches!(global(&vm, "j"), Value::Bool(false)));
        // Compound bitwise assignment: 10 &15 |1 ^3 <<2 >>1 = 16.
        let vm = run("var x = 0b1010; x &= 0x0F; x |= 1; x ^= 3; x <<= 2; x >>= 1;").unwrap();
        assert!(matches!(global(&vm, "x"), Value::Int(16)));
    }

    #[test]
    fn bitwise_errors() {
        for (src, needle) in [
            ("var x = 1 << 64;", "shift amount"),
            ("var x = 1 >> -1;", "shift amount"),
            ("var x = 1 & 1.5;", "bitwise"),
            ("var x = 1 | \"s\";", "bitwise"),
            ("var x = ~1.5;", "'~'"),
        ] {
            let err = match run(src) {
                Err(e) => e,
                Ok(_) => panic!("expected a runtime error for: {src}"),
            };
            let msg = format!("{err}");
            assert!(msg.contains(needle), "for {src}: got {msg}");
        }
    }

    #[test]
    fn match_expressions() {
        let vm = run(
            "fn name(n) -> match n { 0 => \"zero\", 1 | 2 => \"few\", k if k < 0 => \"neg\", 3..=9 => \"digit\", else => \"many\" };\
             var a = name(0); var b = name(2); var c = name(-5); var d = name(7); var e = name(42);",
        )
        .unwrap();
        let s = |n: &str| match global(&vm, n) {
            Value::Str(s) => s.to_string(),
            other => panic!("bad {n}: {other:?}"),
        };
        assert_eq!(s("a"), "zero");
        assert_eq!(s("b"), "few");
        assert_eq!(s("c"), "neg");
        assert_eq!(s("d"), "digit");
        assert_eq!(s("e"), "many");
        // Exclusive range, block body with an implicit value, binding.
        let vm = run("let x = match 5 { 0..5 => \"low\", n => { var t = n * 2; t + 1 } };").unwrap();
        assert!(matches!(global(&vm, "x"), Value::Int(11)));
        // Strings, bools and null as scrutinees; match as a statement.
        let vm = run(
            "var out = \"\";\
             match \"b\" { \"a\" => { out = \"A\" }, \"b\" => { out = \"B\" }, else => { out = \"?\" } };\
             match true { false => { out = \"f\" }, _ => { out = out + \"!\" } };\
             match null { 1 => { out = \"1\" }, else => { out = out + \"n\" } };",
        )
        .unwrap();
        assert!(matches!(global(&vm, "out"), Value::Str(ref s) if &**s == "B!n"));
    }

    #[test]
    fn power_operator() {
        let vm = run(
            "var a = 2 ** 10; var b = -2 ** 2; var c = 2 ** -1; var d = 2.0 ** 0.5; \
             var e = 2 ** 3 ** 2; var f = 0 ** 0; var g = (-2) ** 2; var h = 2 ** 2 * 3;",
        )
        .unwrap();
        assert!(matches!(global(&vm, "a"), Value::Int(1024)));
        assert!(matches!(global(&vm, "b"), Value::Int(-4))); // -(2**2), Python-style
        assert!(matches!(global(&vm, "c"), Value::Float(f) if (f - 0.5).abs() < 1e-12));
        assert!(matches!(global(&vm, "d"), Value::Float(f) if (f - 2f64.sqrt()).abs() < 1e-12));
        assert!(matches!(global(&vm, "e"), Value::Int(512))); // right-associative
        assert!(matches!(global(&vm, "f"), Value::Int(1)));
        assert!(matches!(global(&vm, "g"), Value::Int(4)));
        assert!(matches!(global(&vm, "h"), Value::Int(12))); // ** tighter than *
        let vm = run("var x = 3; x **= 2;").unwrap();
        assert!(matches!(global(&vm, "x"), Value::Int(9)));
        for (src, needle) in [
            ("var x = 0 ** -1;", "zero to a negative power"),
            ("var x = 2 ** 100;", "overflow"),
            ("var x = 2 ** \"s\";", "'**' needs numbers"),
        ] {
            let err = match run(src) {
                Err(e) => e,
                Ok(_) => panic!("expected a runtime error for: {src}"),
            };
            assert!(format!("{err}").contains(needle), "for {src}: {err}");
        }
    }

    #[test]
    fn f_strings() {
        let vm = run(
            "var name = \"RSCP\";\
             var a = f\"hello {name}\";\
             var b = f\"{1 + 2 * 3} items\";\
             var c = f\"no holes\";\
             var d = f\"braces: {{}} and {name}\";\
             var e = f\"{upper(name)}!\";\
             var n = 0;\
             var f2 = f\"value={n}\";",
        )
        .unwrap();
        let s = |n: &str| match global(&vm, n) {
            Value::Str(s) => s.to_string(),
            other => panic!("bad {n}: {other:?}"),
        };
        assert_eq!(s("a"), "hello RSCP");
        assert_eq!(s("b"), "7 items");
        assert_eq!(s("c"), "no holes");
        assert_eq!(s("d"), "braces: {} and RSCP");
        assert_eq!(s("e"), "RSCP!");
        assert_eq!(s("f2"), "value=0");
    }

    #[test]
    fn string_builtins() {
        let vm = run(
            "var a = upper(\"héllo\"); var b = lower(\"WORLD\"); var c = trim(\"  x  \"); \
             var d = split(\"a,b,c\", \",\"); var e = join([1, \"two\", 3.0], \"|\"); \
             var f = replace(\"banana\", \"na\", \"NA\"); var g = find(\"banana\", \"na\"); \
             var h = find(\"banana\", \"x\"); var i = slice(\"hello\", -3, 100); \
             var j = slice([1, 2, 3, 4], 1, -1); var k = contains([1, 2], 2); \
             var l = starts_with(\"rscp\", \"rs\"); var m = repeat(\"ab\", 2); \
             var o = ord(\"A\"); var p = chr(66);",
        )
        .unwrap();
        assert!(matches!(global(&vm, "a"), Value::Str(ref s) if &**s == "HÉLLO"));
        assert!(matches!(global(&vm, "b"), Value::Str(ref s) if &**s == "world"));
        assert!(matches!(global(&vm, "c"), Value::Str(ref s) if &**s == "x"));
        match global(&vm, "d") {
            Value::Array(arr) => {
                let items = arr.borrow();
                assert_eq!(items.len(), 3);
                assert!(matches!(&items[0], Value::Str(s) if &**s == "a"));
            }
            other => panic!("bad d: {other:?}"),
        }
        assert!(matches!(global(&vm, "e"), Value::Str(ref s) if &**s == "1|two|3.0"));
        assert!(matches!(global(&vm, "f"), Value::Str(ref s) if &**s == "baNANA"));
        assert!(matches!(global(&vm, "g"), Value::Int(2)));
        assert!(matches!(global(&vm, "h"), Value::Int(-1)));
        assert!(matches!(global(&vm, "i"), Value::Str(ref s) if &**s == "llo"));
        match global(&vm, "j") {
            Value::Array(arr) => {
                let items = arr.borrow();
                assert_eq!(items.len(), 2);
                assert!(matches!(&items[0], Value::Int(2)));
            }
            other => panic!("bad j: {other:?}"),
        }
        assert!(matches!(global(&vm, "k"), Value::Bool(true)));
        assert!(matches!(global(&vm, "l"), Value::Bool(true)));
        assert!(matches!(global(&vm, "m"), Value::Str(ref s) if &**s == "abab"));
        assert!(matches!(global(&vm, "o"), Value::Int(65)));
        assert!(matches!(global(&vm, "p"), Value::Str(ref s) if &**s == "B"));
    }

    #[test]
    fn try_catch_throw() {
        let vm = run(
            "var log = \"\";\
             try { let x = 1 / 0 } catch e { log = str(e) }\
             try { throw \"boom\" } catch e { log = log + \"|\" + str(e) }\
             try { panic(\"p\") } catch e { log = log + \"|\" + str(e) }\
             try { [1][5] } catch e { log = log + \"|\" + slice(str(e), 0, 5) }\
             try { println(\"no\") } catch { log = log + \"|unreached\" }",
        )
        .unwrap();
        assert!(matches!(global(&vm, "log"), Value::Str(ref s)
            if &**s == "division by zero|boom|p|index"));

        // Errors cross function frames into the caller's try; `return`
        // inside try (both paths) and break/continue inside try work.
        let vm = run(
            "fn risky(n) { if n == 0 { throw \"zero\" } return 100 / n }\
             fn safe() { try { return risky(0) } catch e { return \"caught \" + str(e) } }\
             fn early(n) { try { if n > 0 { return \"early\" } throw \"nope\" } catch e { return \"late \" + str(e) } }\
             var a = safe(); var b = early(1); var c = early(0);\
             var log = [];\
             for i in 0..5 { try { if i == 2 { continue } if i == 4 { break } push(log, i) } catch e { push(log, \"x\") } }",
        )
        .unwrap();
        assert!(matches!(global(&vm, "a"), Value::Str(ref s) if &**s == "caught zero"));
        assert!(matches!(global(&vm, "b"), Value::Str(ref s) if &**s == "early"));
        assert!(matches!(global(&vm, "c"), Value::Str(ref s) if &**s == "late nope"));
        match global(&vm, "log") {
            Value::Array(arr) => {
                let items = arr.borrow();
                assert_eq!(items.len(), 3);
                assert!(matches!(&items[0], Value::Int(0)));
            }
            other => panic!("bad log: {other:?}"),
        }

        // Nested try with a rethrow; the catch binding is a normal local.
        let vm = run(
            "var out = \"\";\
             try { try { throw \"inner\" } catch e { throw \"outer: \" + str(e) } } catch e2 { out = str(e2) }",
        )
        .unwrap();
        assert!(matches!(global(&vm, "out"), Value::Str(ref s) if &**s == "outer: inner"));
    }

    #[test]
    fn fatal_errors_are_not_caught() {
        // Stack overflow must stay fatal: catching it invites an immediate
        // second overflow inside the handler.
        let err = match run("fn f() { return f() } try { f() } catch e { }") {
            Err(e) => e,
            Ok(_) => panic!("expected a fatal stack overflow"),
        };
        assert!(format!("{err}").contains("stack overflow"));
    }

    #[test]
    fn match_runtime_errors() {
        for (src, needle) in [
            // A catch-all-less literal match is a compile error (26.0.12.8);
            // the runtime raise stays as a safety net.
            ("var x = match 5 { 1 => \"one\", 2 => \"two\" };", "not exhaustive"),
            ("var x = match 1.5 { 1 => \"one\", else => \"x\" };", ""), // int/float equality
        ] {
            if needle.is_empty() {
                let vm = run(src).unwrap();
                assert!(matches!(global(&vm, "x"), Value::Str(ref s) if &**s == "x"));
                continue;
            }
            let err = match run(src) {
                Err(e) => e,
                Ok(_) => panic!("expected a runtime error for: {src}"),
            };
            let msg = format!("{err}");
            assert!(msg.contains(needle), "for {src}: got {msg}");
        }
    }
}
