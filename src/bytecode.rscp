//! Bytecode representation: opcodes, chunks, function prototypes and the
//! disassembler behind `rscp disasm`.

use crate::value::Value;

/// Every VM instruction. Operands are little-endian; sizes per opcode are
/// declared by [`Op::operand`].
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
#[repr(u8)]
pub enum Op {
    /// push consts[u16]
    Constant = 0,
    Null,
    True,
    False,
    /// pop 1 (closes any upvalues pointing at the popped slot)
    Pop,
    /// pop n (u8)
    PopN,
    /// push stack[base + u8]
    GetLocal,
    /// stack[base + u8] = pop
    SetLocal,
    /// push upvalue[u8]
    GetUpvalue,
    /// upvalue[u8] = pop
    SetUpvalue,
    /// globals[consts[u16]] = pop (binding is mutable)
    DefineGlobal,
    /// globals[consts[u16]] = pop (binding is immutable)
    DefineGlobalConst,
    /// push globals[consts[u16]]
    GetGlobal,
    /// globals[consts[u16]] = pop
    SetGlobal,
    Equal,
    Greater,
    Less,
    Le,
    Ge,
    Not,
    Negate,
    Add,
    Sub,
    Mul,
    Div,
    FloorDiv,
    Mod,
    /// absolute jump to u16
    Jump,
    /// peek top; jump to u16 if it is `false` (errors on non-bool)
    JumpIfFalsePeek,
    /// peek top; jump to u16 if it is `true` (errors on non-bool)
    JumpIfTruePeek,
    /// absolute backward jump to u16
    Loop,
    /// call: callee + argc(u8) args are on the stack
    Call,
    /// create a closure from prototype consts[u16]; followed by one
    /// (is_local: u8, index: u8) pair per prototype upvalue
    Closure,
    Return,
    /// build an array of u16 elements popped off the stack
    Array,
    /// build a map of u16 key/value pairs popped off the stack
    Map,
    /// obj[idx] (pop idx, obj; push result)
    IndexGet,
    /// obj[idx] = value (pop value, idx, obj)
    IndexSet,
    /// obj[start:end:step] (pop step, end, start, obj; push the slice)
    SliceGet,
    /// like IndexGet but keeps obj and idx on the stack (compound assignment)
    IndexGetKeep,
    /// len(array) — used by `for-in`
    ArrayLen,
    /// bitwise: two ints (or two bools for & | ^)
    BitAnd,
    BitOr,
    BitXor,
    Shl,
    Shr,
    BitNot,
    /// pop n (u8) cells from under the top value (used by match)
    PopNUnder,
    /// exponentiation: int**int (exact when the exponent >= 0), else float
    Pow,
    /// pop a value, push its display string (f-string interpolation)
    ToString,
    /// pop n (u8) strings, push their concatenation
    StrJoin,
    /// register an error handler: jump target u16 = the catch code
    TryCatch,
    /// unregister the innermost handler (try body finished normally)
    PopHandler,
    /// raise a runtime error carrying the popped value's text (catchable)
    Throw,
    /// pop (path, proto); push the module's export map — running the module
    /// in a fresh global scope on first import (VM caches it by path)
    Import,
    /// obj.key(args): pop argc(u8) args, the key and obj; when obj is an
    /// instance the method is called with self bound (2026.6.0)
    CallMethod,
    /// push the parent class's method consts[u16] (super.name(...))
    SuperMethod,
    /// a instanceof B
    InstanceOf,
    /// pop top; jump to u16 if it is `false` (errors on non-bool). The fused
    /// statement-condition form: replaces a `JumpIfFalsePeek` followed by
    /// `Pop` on both paths, so conditions cost one dispatch less (26.0.9.0).
    JumpIfFalsePop,
    /// stack[base + u8] += consts[u16] (checked int/float add) — the loop
    /// counter increment of a range `for`
    IncLocal,
    /// Range `for` head (exclusive): compare locals idx/end (u8, u8),
    /// copy idx into the loop variable (u8) and fall through, or jump to
    /// the u16 exit. One dispatch instead of GetLocal+GetLocal+Less+
    /// JumpIfFalsePop+MoveLocal (26.0.9.0).
    ForRangeExcl,
    /// Range `for` head, inclusive end (`..=`).
    ForRangeIncl,
    /// Array `for` head: if idx < len(iter) (u8, u8), store iter[idx] into
    /// the loop variable (u8) and fall through, else jump to the u16 exit.
    /// Replaces nine dispatches per iteration (26.0.9.0).
    ForArray,
    /// push Bool: is the local at u8 a variant of enum consts[u16] named
    /// consts[u16]? (match patterns, 26.0.11.0)
    EnumIs,
    /// stack[base + u8(dst)] = local(u8).args[u8] — destructure an enum
    /// variant payload into a binding (26.0.11.0)
    EnumBind,
    /// push Bool: does local(u8).args[u8] equal consts[u16]? (literal
    /// elements of variant patterns, 26.0.12.0)
    ArgsIs,
}

const ALL_OPS: [Op; 66] = [
    Op::Constant,
    Op::Null,
    Op::True,
    Op::False,
    Op::Pop,
    Op::PopN,
    Op::GetLocal,
    Op::SetLocal,
    Op::GetUpvalue,
    Op::SetUpvalue,
    Op::DefineGlobal,
    Op::DefineGlobalConst,
    Op::GetGlobal,
    Op::SetGlobal,
    Op::Equal,
    Op::Greater,
    Op::Less,
    Op::Le,
    Op::Ge,
    Op::Not,
    Op::Negate,
    Op::Add,
    Op::Sub,
    Op::Mul,
    Op::Div,
    Op::FloorDiv,
    Op::Mod,
    Op::Jump,
    Op::JumpIfFalsePeek,
    Op::JumpIfTruePeek,
    Op::Loop,
    Op::Call,
    Op::Closure,
    Op::Return,
    Op::Array,
    Op::Map,
    Op::IndexGet,
    Op::IndexSet,
    Op::SliceGet,
    Op::IndexGetKeep,
    Op::ArrayLen,
    Op::BitAnd,
    Op::BitOr,
    Op::BitXor,
    Op::Shl,
    Op::Shr,
    Op::BitNot,
    Op::PopNUnder,
    Op::Pow,
    Op::ToString,
    Op::StrJoin,
    Op::TryCatch,
    Op::PopHandler,
    Op::Throw,
    Op::Import,
    Op::CallMethod,
    Op::SuperMethod,
    Op::InstanceOf,
    Op::JumpIfFalsePop,
    Op::IncLocal,
    Op::ForRangeExcl,
    Op::ForRangeIncl,
    Op::ForArray,
    Op::EnumIs,
    Op::EnumBind,
    Op::ArgsIs,
];

impl Op {
    pub fn from_byte(b: u8) -> Option<Op> {
        ALL_OPS.get(b as usize).copied()
    }

    pub fn name(self) -> &'static str {
        match self {
            Op::Constant => "Constant",
            Op::Null => "Null",
            Op::True => "True",
            Op::False => "False",
            Op::Pop => "Pop",
            Op::PopN => "PopN",
            Op::GetLocal => "GetLocal",
            Op::SetLocal => "SetLocal",
            Op::GetUpvalue => "GetUpvalue",
            Op::SetUpvalue => "SetUpvalue",
            Op::DefineGlobal => "DefineGlobal",
            Op::DefineGlobalConst => "DefineGlobalConst",
            Op::GetGlobal => "GetGlobal",
            Op::SetGlobal => "SetGlobal",
            Op::Equal => "Equal",
            Op::Greater => "Greater",
            Op::Less => "Less",
            Op::Le => "Le",
            Op::Ge => "Ge",
            Op::Not => "Not",
            Op::Negate => "Negate",
            Op::Add => "Add",
            Op::Sub => "Sub",
            Op::Mul => "Mul",
            Op::Div => "Div",
            Op::FloorDiv => "FloorDiv",
            Op::Mod => "Mod",
            Op::Jump => "Jump",
            Op::JumpIfFalsePeek => "JumpIfFalsePeek",
            Op::JumpIfTruePeek => "JumpIfTruePeek",
            Op::Loop => "Loop",
            Op::Call => "Call",
            Op::Closure => "Closure",
            Op::Return => "Return",
            Op::Array => "Array",
            Op::Map => "Map",
            Op::IndexGet => "IndexGet",
            Op::IndexSet => "IndexSet",
            Op::SliceGet => "SliceGet",
            Op::IndexGetKeep => "IndexGetKeep",
            Op::ArrayLen => "ArrayLen",
            Op::BitAnd => "BitAnd",
            Op::BitOr => "BitOr",
            Op::BitXor => "BitXor",
            Op::Shl => "Shl",
            Op::Shr => "Shr",
            Op::BitNot => "BitNot",
            Op::PopNUnder => "PopNUnder",
            Op::Pow => "Pow",
            Op::ToString => "ToString",
            Op::StrJoin => "StrJoin",
            Op::TryCatch => "TryCatch",
            Op::PopHandler => "PopHandler",
            Op::Throw => "Throw",
            Op::Import => "Import",
            Op::CallMethod => "CallMethod",
            Op::SuperMethod => "SuperMethod",
            Op::InstanceOf => "InstanceOf",
            Op::JumpIfFalsePop => "JumpIfFalsePop",
            Op::IncLocal => "IncLocal",
            Op::ForRangeExcl => "ForRangeExcl",
            Op::ForRangeIncl => "ForRangeIncl",
            Op::ForArray => "ForArray",
            Op::EnumIs => "EnumIs",
            Op::EnumBind => "EnumBind",
            Op::ArgsIs => "ArgsIs",
        }
    }

    /// The kind (and size) of this opcode's inline operands.
    pub fn operand(self) -> Operand {
        match self {
            Op::PopN | Op::PopNUnder | Op::StrJoin | Op::GetLocal | Op::SetLocal
            | Op::GetUpvalue | Op::SetUpvalue | Op::Call | Op::CallMethod => {
                Operand::U8
            }
            Op::Constant
            | Op::DefineGlobal
            | Op::DefineGlobalConst
            | Op::GetGlobal
            | Op::SetGlobal
            | Op::Jump
            | Op::JumpIfFalsePeek
            | Op::JumpIfTruePeek
            | Op::JumpIfFalsePop
            | Op::Loop
            | Op::Closure
            | Op::TryCatch
            | Op::SuperMethod
            | Op::Array
            | Op::Map => Operand::U16,
            Op::IncLocal => Operand::U8U16,
            Op::ForRangeExcl | Op::ForRangeIncl | Op::ForArray => Operand::U8U8U8U16,
            Op::EnumIs => Operand::U8U16U16,
            Op::EnumBind => Operand::U8U8U8,
            Op::ArgsIs => Operand::U8U8U16,
            _ => Operand::None,
        }
    }
}

/// Operand layout of an opcode.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum Operand {
    None,
    U8,
    U16,
    /// u8 slot, u16 const index
    U8U16,
    /// u8 slot, u8 slot, u8 slot, u16 jump target
    U8U8U8U16,
    /// u8 slot, u16 const index, u16 const index
    U8U16U16,
    /// u8 slot, u8 index, u8 slot
    U8U8U8,
    /// u8 slot, u8 index, u16 const index
    U8U8U16,
}


/// A compiled function: its bytecode, constants, arity and upvalue captures.
pub struct FnProto {
    /// Empty for anonymous functions, "<script>" for the top level.
    pub name: String,
    pub arity: u8,
    /// (is_local, index): capture the local at frame_base+index of the
    /// enclosing function, or the enclosing closure's upvalue #index.
    pub upvalues: Vec<(bool, u8)>,
    pub chunk: Chunk,
}

impl std::fmt::Debug for FnProto {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.debug_struct("FnProto")
            .field("name", &self.name)
            .field("arity", &self.arity)
            .field("upvalues", &self.upvalues)
            .field("code_len", &self.chunk.code.len())
            .finish()
    }
}

/// A bytecode chunk: code, constant pool and per-byte source positions.
pub struct Chunk {
    pub code: Vec<u8>,
    pub consts: Vec<Value>,
    pub lines: Vec<u32>,
    pub cols: Vec<u32>,
}

impl Default for Chunk {
    fn default() -> Self {
        Self::new()
    }
}

impl Chunk {
    pub fn new() -> Self {
        Chunk { code: Vec::new(), consts: Vec::new(), lines: Vec::new(), cols: Vec::new() }
    }

    fn at(&mut self, line: usize, col: usize) {
        self.lines.push(line as u32);
        self.cols.push(col as u32);
    }

    /// Emit a bare opcode; returns the index of the opcode byte.
    pub fn emit(&mut self, op: Op, line: usize, col: usize) -> usize {
        let i = self.code.len();
        self.code.push(op as u8);
        self.at(line, col);
        i
    }

    /// Emit an opcode with a u8 operand.
    pub fn emit_op_u8(&mut self, op: Op, v: u8, line: usize, col: usize) -> usize {
        let i = self.emit(op, line, col);
        self.code.push(v);
        self.at(line, col);
        i
    }

    /// Emit an opcode with a u16 (little-endian) operand.
    pub fn emit_op_u16(&mut self, op: Op, v: u16, line: usize, col: usize) -> usize {
        let i = self.emit(op, line, col);
        self.code.push((v & 0xff) as u8);
        self.code.push((v >> 8) as u8);
        self.at(line, col);
        self.at(line, col);
        i
    }

    /// Emit an opcode with a u8 operand followed by a u16 (little-endian).
    pub fn emit_op_u8_u16(&mut self, op: Op, a: u8, v: u16, line: usize, col: usize) -> usize {
        let i = self.emit(op, line, col);
        self.code.push(a);
        self.code.push((v & 0xff) as u8);
        self.code.push((v >> 8) as u8);
        self.at(line, col);
        self.at(line, col);
        self.at(line, col);
        i
    }

    /// Emit an opcode with a u8 operand and two u16 (little-endian).
    pub fn emit_op_u8_u16_u16(&mut self, op: Op, a: u8, b: u16, c: u16, line: usize, col: usize) -> usize {
        let i = self.emit(op, line, col);
        self.code.push(a);
        self.code.push((b & 0xff) as u8);
        self.code.push((b >> 8) as u8);
        self.code.push((c & 0xff) as u8);
        self.code.push((c >> 8) as u8);
        self.at(line, col);
        self.at(line, col);
        self.at(line, col);
        self.at(line, col);
        self.at(line, col);
        i
    }

    /// Emit an opcode with a u8, a u8 and a u16 (little-endian).
    pub fn emit_op_u8_u8_u16(&mut self, op: Op, a: u8, b: u8, c: u16, line: usize, col: usize) -> usize {
        let i = self.emit(op, line, col);
        self.code.push(a);
        self.code.push(b);
        self.code.push((c & 0xff) as u8);
        self.code.push((c >> 8) as u8);
        self.at(line, col);
        self.at(line, col);
        self.at(line, col);
        self.at(line, col);
        i
    }

    /// Emit an opcode with three u8 operands.
    pub fn emit_op_u8_u8_u8(&mut self, op: Op, a: u8, b: u8, c: u8, line: usize, col: usize) -> usize {
        let i = self.emit(op, line, col);
        self.code.push(a);
        self.code.push(b);
        self.code.push(c);
        self.at(line, col);
        self.at(line, col);
        self.at(line, col);
        i
    }

    /// Emit an opcode with three u8 operands and a u16 (little-endian).
    pub fn emit_op_u8_u8_u8_u16(
        &mut self,
        op: Op,
        a: u8,
        b: u8,
        c: u8,
        v: u16,
        line: usize,
        col: usize,
    ) -> usize {
        let i = self.emit(op, line, col);
        self.code.push(a);
        self.code.push(b);
        self.code.push(c);
        self.code.push((v & 0xff) as u8);
        self.code.push((v >> 8) as u8);
        self.at(line, col);
        self.at(line, col);
        self.at(line, col);
        self.at(line, col);
        self.at(line, col);
        i
    }

    /// Overwrite the u16 operand stored at `at` (the opcode index).
    pub fn patch_u16(&mut self, at: usize, target: usize) {
        let t = target as u16;
        self.code[at + 1] = (t & 0xff) as u8;
        self.code[at + 2] = (t >> 8) as u8;
    }

    /// Append an extra raw u8 operand (used by Closure descriptors).
    pub fn push_byte(&mut self, b: u8, line: usize, col: usize) {
        self.code.push(b);
        self.at(line, col);
    }

    /// (line, col) of the instruction byte at `ip`.
    pub fn line_at(&self, ip: usize) -> (usize, usize) {
        if ip >= self.lines.len() {
            return (0, 0);
        }
        (self.lines[ip] as usize, self.cols[ip] as usize)
    }
}

/// Disassemble a whole prototype tree (the script and every nested function).
pub fn disassemble_proto(proto: &FnProto) -> String {
    let mut out = String::new();
    disasm_one(proto, &mut out);
    out
}

fn disasm_one(p: &FnProto, out: &mut String) {
    let title = if p.name.is_empty() {
        "<anonymous>".to_string()
    } else {
        p.name.clone()
    };
    out.push_str(&format!(
        "== {} ({} params, {} upvalues) ==\n",
        title,
        p.arity,
        p.upvalues.len()
    ));
    if !p.chunk.consts.is_empty() {
        out.push_str("constants:\n");
        for (i, c) in p.chunk.consts.iter().enumerate() {
            out.push_str(&format!("  {i:04} = {}\n", const_repr(c)));
        }
    }
    out.push_str("code:\n");

    let chunk = &p.chunk;
    let mut ip = 0usize;
    while ip < chunk.code.len() {
        let op_ip = ip;
        let byte = chunk.code[ip];
        ip += 1;
        let op = match Op::from_byte(byte) {
            Some(op) => op,
            None => {
                out.push_str(&format!("  {op_ip:04}  <bad opcode {byte}>\n"));
                continue;
            }
        };
        let (line, col) = chunk.line_at(op_ip);
        let mut text = format!("  {op_ip:04}  L{line}:C{col:<4} {}", op.name());
        let mut u16_operand: Option<u16> = None;
        match op.operand() {
            Operand::None => {}
            Operand::U8 => {
                let v = chunk.code[ip];
                ip += 1;
                text.push_str(&format!(" {v}"));
            }
            Operand::U16 => {
                let v = u16::from(chunk.code[ip]) | (u16::from(chunk.code[ip + 1]) << 8);
                ip += 2;
                u16_operand = Some(v);
                text.push_str(&format!(" {v}"));
                match op {
                    Op::Constant => {
                        text.push_str(&format!(
                            "        ; {}",
                            const_repr(&chunk.consts[v as usize])
                        ));
                    }
                    Op::DefineGlobal | Op::DefineGlobalConst | Op::GetGlobal | Op::SetGlobal => {
                        text.push_str(&format!(
                            "        ; '{}'",
                            const_repr(&chunk.consts[v as usize])
                        ));
                    }
                    Op::Jump
                    | Op::JumpIfFalsePeek
                    | Op::JumpIfTruePeek
                    | Op::JumpIfFalsePop
                    | Op::Loop
                    | Op::TryCatch => {
                        text.push_str(&format!("        ; -> {v}"));
                    }
                    Op::Closure => {
                        if let Value::Proto(inner) = &chunk.consts[v as usize] {
                            text.push_str(&format!(
                                "        ; fn '{}' ({} params)",
                                if inner.name.is_empty() { "<anonymous>" } else { &inner.name },
                                inner.arity
                            ));
                        }
                    }
                    _ => {}
                }
            }
            Operand::U8U16 => {
                let a = chunk.code[ip];
                let b = u16::from(chunk.code[ip + 1]) | (u16::from(chunk.code[ip + 2]) << 8);
                ip += 3;
                text.push_str(&format!(" {a} {b}"));
                if op == Op::IncLocal {
                    text.push_str(&format!(
                        "        ; {}",
                        const_repr(&chunk.consts[b as usize])
                    ));
                }
            }
            Operand::U8U8U8U16 => {
                let (a, b, c) = (chunk.code[ip], chunk.code[ip + 1], chunk.code[ip + 2]);
                let t = u16::from(chunk.code[ip + 3]) | (u16::from(chunk.code[ip + 4]) << 8);
                ip += 5;
                text.push_str(&format!(" {a} {b} {c} {t}"));
                text.push_str(&format!("        ; -> {t}"));
            }
            Operand::U8U16U16 => {
                let a = chunk.code[ip];
                let b = u16::from(chunk.code[ip + 1]) | (u16::from(chunk.code[ip + 2]) << 8);
                let c = u16::from(chunk.code[ip + 3]) | (u16::from(chunk.code[ip + 4]) << 8);
                ip += 5;
                text.push_str(&format!(" {a} {b} {c}"));
                if let (Some(Value::Str(e)), Some(Value::Str(v))) =
                    (chunk.consts.get(b as usize), chunk.consts.get(c as usize))
                {
                    text.push_str(&format!("        ; {e}.{v}"));
                }
            }
            Operand::U8U8U8 => {
                let (a, b, c) = (chunk.code[ip], chunk.code[ip + 1], chunk.code[ip + 2]);
                ip += 3;
                text.push_str(&format!(" {a} {b} {c}"));
            }
            Operand::U8U8U16 => {
                let (a, b) = (chunk.code[ip], chunk.code[ip + 1]);
                let c = u16::from(chunk.code[ip + 2]) | (u16::from(chunk.code[ip + 3]) << 8);
                ip += 4;
                text.push_str(&format!(" {a} {b} {c}"));
                if let Some(Value::Str(k)) = chunk.consts.get(c as usize) {
                    text.push_str(&format!("        ; == {k:?}"));
                }
            }
        }
        if op == Op::Closure {
            let ci = u16_operand.unwrap() as usize;
            let n = match &chunk.consts[ci] {
                Value::Proto(inner) => inner.upvalues.len(),
                _ => 0,
            };
            for _ in 0..n {
                let is_local = chunk.code[ip];
                let idx = chunk.code[ip + 1];
                ip += 2;
                text.push_str(&format!(
                    "\n           capture {} {}",
                    if is_local == 1 { "local" } else { "upvalue" },
                    idx
                ));
            }
        }
        out.push_str(&text);
        out.push('\n');
    }

    for c in &p.chunk.consts {
        if let Value::Proto(inner) = c {
            out.push('\n');
            disasm_one(inner, out);
        }
    }
}

fn const_repr(v: &Value) -> String {
    match v {
        Value::Int(i) => format!("Int({i})"),
        Value::Float(f) => format!("Float({f:?})"),
        Value::Str(s) => format!("Str({s:?})"),
        Value::Proto(p) => {
            format!("Fn('{}')", if p.name.is_empty() { "<anonymous>" } else { &p.name })
        }
        other => format!("{}", other.type_name()),
    }
}
