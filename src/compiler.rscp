//! Compiler: lowers the AST to bytecode.
//!
//! One [`FnCtx`] per function nesting level. Locals live on the VM stack
//! (slot 0 is reserved for the running closure itself); variables at the
//! script's top level become globals. Names that escape a function are
//! captured as upvalues (see `vm.rscp` for the runtime side).

use std::path::{Path, PathBuf};
use std::rc::Rc;

use crate::ast::*;
use crate::bytecode::{Chunk, FnProto, Op};
use crate::errors::RscpError;
use crate::lexer::Lexer;
use crate::parser::Parser;
use crate::value::Value;

/// Max locals per function (slot indices are u8; slot 0 is reserved).
const MAX_LOCALS: usize = 255;
const MAX_CONSTS: usize = u16::MAX as usize + 1;
const MAX_CODE: usize = u16::MAX as usize + 1;
const MAX_UPVALUES: usize = 256;

/// Internal names for `for-in` hidden locals; '%' can never appear in a
/// user identifier, so these cannot collide or be captured by name.
const ITER_LOCAL: &str = "%iter";
const INDEX_LOCAL: &str = "%i";
const RANGE_END_LOCAL: &str = "%end";
/// Hidden local holding the error object across a `try`'s catch clauses.
const ERR_LOCAL: &str = "%err";

struct Local {
    name: String,
    /// Stack slot (frame-relative). With temporaries pending on the stack
    /// (e.g. a `match` compiled as a call argument), a local's cell sits
    /// above them, so the slot is not simply its index in `locals`.
    slot: u8,
    depth: usize,
    mutable: bool,
}

struct FnCtx {
    proto: FnProto,
    locals: Vec<Local>,
    scope_depth: usize,
    is_script: bool,
    /// How many `try` blocks are open in this function right now; `return`
    /// and loop exits must unregister their handlers.
    try_depth: usize,
    /// Temporary stack cells above the locals region right now. Every
    /// expression leaves its result counted here; opcodes that consume
    /// operands decrement it. `declare_local` uses it to place a new
    /// local's cell at the true stack position.
    pending: usize,
}

struct LoopCtx {
    /// `fns.len()` when the loop was opened; `break`/`continue` are only
    /// valid when the innermost loop belongs to the function being compiled.
    fn_depth: usize,
    /// Locals live when the loop started; `break` unwinds to here (loop
    /// scope variables die with the loop).
    locals_at_entry: usize,
    /// Temps pending when the loop started (a loop inside a match-arm block
    /// has the enclosing expression's temps below it); `break` pops those
    /// pushed since, on top of the loop's locals.
    pending_at_entry: usize,
    /// `try` blocks open when the loop started; `break`/`continue` must
    /// unregister the handlers opened since then.
    try_depth_at_entry: usize,
    /// Locals after the loop's own scope was set up (e.g. after the `for`
    /// initializer); `continue` unwinds to here but keeps these alive.
    cont_locals: usize,
    breaks: Vec<usize>,
    conts: Vec<usize>,
    /// Known continue target (while loops jump straight to the condition).
    cont_target: Option<usize>,
}

/// Compile a program into the script prototype. `base_dir` is the
/// directory of the source file; `import` paths resolve against it.
pub fn compile(program: &[Stmt], base_dir: &Path) -> Result<Rc<FnProto>, RscpError> {
    compile_in_chain(program, base_dir, Vec::new(), "<script>".to_string())
}

/// Compile a module (or the script, with an empty chain). The chain holds
/// the canonical paths of the files currently being compiled, so a cycle
/// (`a` imports `b` imports `a`) is a compile error instead of a loop.
fn compile_in_chain(
    program: &[Stmt],
    base_dir: &Path,
    chain: Vec<PathBuf>,
    proto_name: String,
) -> Result<Rc<FnProto>, RscpError> {
    let mut c = Compiler {
        fns: vec![FnCtx {
            proto: FnProto {
                name: proto_name,
                arity: 0,
                upvalues: Vec::new(),
                chunk: Chunk::new(),
            },
            locals: vec![Local {
                name: String::new(),
                slot: 0,
                depth: 0,
                mutable: false,
            }],
            scope_depth: 0,
            is_script: true,
            try_depth: 0,
            pending: 0,
        }],
        loops: Vec::new(),
        top_names: Vec::new(),
        temp_n: 0,
        base_dir: base_dir.to_path_buf(),
        chain,
    };
    c.stmts(program)?;
    let line = program.last().map_or(1, |s| s.line);
    let col = program.last().map_or(1, |s| s.col);
    c.emit(Op::Return, line, col);
    let ctx = c.fns.pop().unwrap();
    Ok(Rc::new(ctx.proto))
}

struct Compiler {
    fns: Vec<FnCtx>,
    loops: Vec<LoopCtx>,
    /// Names already declared at the script top level (duplicate detection).
    top_names: Vec<String>,
    /// Counter for hidden `%mN`/`%rN` locals of nested match expressions.
    temp_n: usize,
    /// Directory of the file being compiled; `import` paths resolve here.
    base_dir: PathBuf,
    /// Canonical paths of the files being compiled (cycle detection).
    chain: Vec<PathBuf>,
}

impl Compiler {
    // ---- context helpers -------------------------------------------------

    fn cur(&mut self) -> &mut FnCtx {
        self.fns.last_mut().unwrap()
    }

    fn at_top_level(&self) -> bool {
        let f = self.fns.last().unwrap();
        f.is_script && f.scope_depth == 0
    }

    fn err(&self, msg: impl Into<String>, line: usize, col: usize) -> RscpError {
        RscpError::compile(msg, line, col)
    }

    // ---- temporary-stack bookkeeping ---------------------------------------
    //
    // `pending` mirrors how many temporary cells sit above the locals
    // region, so `declare_local` can compute true stack slots (a `match`
    // compiled as a call argument declares locals above earlier operands).

    fn push_temp(&mut self) {
        self.cur().pending += 1;
    }

    fn drop_temps(&mut self, n: usize) {
        let ctx = self.cur();
        ctx.pending = ctx.pending.saturating_sub(n);
    }

    // ---- emit helpers ------------------------------------------------------

    fn emit(&mut self, op: Op, line: usize, col: usize) -> usize {
        self.cur().proto.chunk.emit(op, line, col)
    }

    fn emit_u8(&mut self, op: Op, v: u8, line: usize, col: usize) -> usize {
        self.cur().proto.chunk.emit_op_u8(op, v, line, col)
    }

    fn emit_u8_u16(&mut self, op: Op, a: u8, v: u16, line: usize, col: usize) -> usize {
        self.cur().proto.chunk.emit_op_u8_u16(op, a, v, line, col)
    }

    fn emit_u16(&mut self, op: Op, v: u16, line: usize, col: usize) -> usize {
        self.cur().proto.chunk.emit_op_u16(op, v, line, col)
    }

    fn cur_len(&self) -> usize {
        self.fns.last().unwrap().proto.chunk.code.len()
    }

    fn emit_jump(&mut self, op: Op, line: usize, col: usize) -> Result<usize, RscpError> {
        if self.cur_len() >= MAX_CODE {
            return Err(self.err("function is too large (bytecode exceeds 64 KiB)", line, col));
        }
        Ok(self.emit_u16(op, 0, line, col))
    }

    fn emit_jump_to(&mut self, op: Op, target: usize, line: usize, col: usize) -> Result<(), RscpError> {
        if self.cur_len() >= MAX_CODE || target >= MAX_CODE {
            return Err(self.err("function is too large (bytecode exceeds 64 KiB)", line, col));
        }
        let site = self.emit_u16(op, 0, line, col);
        self.cur().proto.chunk.patch_u16(site, target);
        Ok(())
    }

    fn patch_jump(&mut self, site: usize, line: usize, col: usize) -> Result<(), RscpError> {
        let target = self.cur_len();
        if target >= MAX_CODE {
            return Err(self.err("function is too large (bytecode exceeds 64 KiB)", line, col));
        }
        self.cur().proto.chunk.patch_u16(site, target);
        Ok(())
    }

    /// Patch the u16 operand that starts at the absolute byte position
    /// `at` (used by the fused for-heads, whose target sits at opcode+4).
    fn patch_u16_at(&mut self, at: usize, line: usize, col: usize) -> Result<(), RscpError> {
        let target = self.cur_len();
        if target >= MAX_CODE {
            return Err(self.err("function is too large (bytecode exceeds 64 KiB)", line, col));
        }
        self.cur().proto.chunk.patch_u16(at, target);
        Ok(())
    }

    /// Emit a fused for-head: three u8 slots and a placeholder u16 target.
    fn emit_for_head(&mut self, op: Op, a: u8, b: u8, c: u8, line: usize, col: usize) -> Result<usize, RscpError> {
        if self.cur_len() >= MAX_CODE {
            return Err(self.err("function is too large (bytecode exceeds 64 KiB)", line, col));
        }
        Ok(self.cur().proto.chunk.emit_op_u8_u8_u8_u16(op, a, b, c, 0, line, col))
    }

    fn constant(&mut self, v: Value, line: usize, col: usize) -> Result<u16, RscpError> {
        if self.cur().proto.chunk.consts.len() >= MAX_CONSTS {
            return Err(self.err("too many constants in one function", line, col));
        }
        self.cur().proto.chunk.consts.push(v);
        Ok((self.cur().proto.chunk.consts.len() - 1) as u16)
    }

    fn string_const(&mut self, s: &str, line: usize, col: usize) -> Result<u16, RscpError> {
        let v = Value::str(s);
        self.constant(v, line, col)
    }

    // ---- scopes and locals ---------------------------------------------------

    fn begin_scope(&mut self) {
        self.cur().scope_depth += 1;
    }

    fn end_scope(&mut self, line: usize, col: usize) {
        let depth = self.cur().scope_depth;
        let mut n = 0usize;
        while self
            .cur()
            .locals
            .last()
            .map_or(false, |l| l.depth >= depth)
        {
            self.cur().locals.pop();
            n += 1;
        }
        if n > 0 {
            // Pops close any upvalues pointing at these slots.
            let n = n.min(u8::MAX as usize) as u8;
            self.emit_u8(Op::PopN, n, line, col);
        }
        self.cur().scope_depth -= 1;
    }

    /// End the current scope with the stack cleanup emitted explicitly by
    /// the caller — used by catch clauses, whose matched and guard-failed
    /// paths each need their own PopN (26.0.10.0).
    fn drop_clause_locals(&mut self) {
        let depth = self.cur().scope_depth;
        while self
            .cur()
            .locals
            .last()
            .map_or(false, |l| l.depth >= depth)
        {
            self.cur().locals.pop();
        }
        self.cur().scope_depth -= 1;
    }

    /// Number of locals currently declared in the function being compiled
    /// (including the reserved slot 0).
    fn cur_locals(&self) -> usize {
        self.fns.last().unwrap().locals.len()
    }

    /// Declare a local for the value that is currently on top of the stack.
    /// The cell may sit above pending temporaries, so the slot is derived
    /// from `locals.len() + pending`; declaring consumes one pending temp.
    fn declare_local(
        &mut self,
        name: &str,
        mutable: bool,
        line: usize,
        col: usize,
    ) -> Result<u8, RscpError> {
        let depth = self.cur().scope_depth;
        if self
            .cur()
            .locals
            .iter()
            .any(|l| l.depth == depth && l.name == name)
        {
            return Err(self.err(format!("'{name}' is already defined in this scope"), line, col));
        }
        let ctx = self.cur();
        if ctx.pending == 0 {
            return Err(self.err(
                "internal error: declare_local without a value on the stack",
                line,
                col,
            ));
        }
        let slot = ctx.locals.len() + ctx.pending - 1;
        if slot > MAX_LOCALS {
            return Err(self.err(format!("too many local variables (max is {MAX_LOCALS})"), line, col));
        }
        ctx.pending -= 1;
        ctx.locals.push(Local {
            name: name.to_string(),
            slot: slot as u8,
            depth,
            mutable,
        });
        Ok(slot as u8)
    }

    fn resolve_local(&self, name: &str) -> Option<u8> {
        let ctx = self.fns.last().unwrap();
        ctx.locals
            .iter()
            .rev()
            .find(|l| l.name == name)
            .map(|l| l.slot)
    }

    fn resolve_upvalue(&mut self, name: &str, line: usize, col: usize) -> Result<Option<u8>, RscpError> {
        if self.fns.len() < 2 {
            return Ok(None);
        }
        self.resolve_upvalue_from(self.fns.len() - 1, name, line, col)
    }

    fn resolve_upvalue_from(
        &mut self,
        fi: usize,
        name: &str,
        line: usize,
        col: usize,
    ) -> Result<Option<u8>, RscpError> {
        if fi == 0 {
            return Ok(None);
        }
        if let Some(l) = self.fns[fi - 1].locals.iter().rev().find(|l| l.name == name) {
            return self.add_upvalue(fi, true, l.slot, line, col).map(Some);
        }
        if let Some(up) = self.resolve_upvalue_from(fi - 1, name, line, col)? {
            return self.add_upvalue(fi, false, up, line, col).map(Some);
        }
        Ok(None)
    }

    fn add_upvalue(
        &mut self,
        fi: usize,
        is_local: bool,
        idx: u8,
        line: usize,
        col: usize,
    ) -> Result<u8, RscpError> {
        let ups = &mut self.fns[fi].proto.upvalues;
        for (i, &(l, x)) in ups.iter().enumerate() {
            if l == is_local && x == idx {
                return Ok(i as u8);
            }
        }
        if ups.len() >= MAX_UPVALUES {
            return Err(self.err("too many closure variables in one function", line, col));
        }
        ups.push((is_local, idx));
        Ok((ups.len() - 1) as u8)
    }

    // ---- statements ---------------------------------------------------------

    fn stmts(&mut self, ss: &[Stmt]) -> Result<(), RscpError> {
        for s in ss {
            self.stmt(s)?;
        }
        Ok(())
    }

    fn stmt(&mut self, s: &Stmt) -> Result<(), RscpError> {
        match &s.kind {
            StmtKind::Let { name, mutable, init } => {
                if self.at_top_level() {
                    if self.top_names.iter().any(|n| n == name) {
                        return Err(self.err(format!("'{name}' is already defined at the top level"), s.line, s.col));
                    }
                    self.top_names.push(name.clone());
                    self.expr(init)?;
                    let ci = self.string_const(name, s.line, s.col)?;
                    let op = if *mutable { Op::DefineGlobal } else { Op::DefineGlobalConst };
                    self.emit_u16(op, ci, s.line, s.col);
                    self.drop_temps(1);
                } else {
                    // Init first, then declare: `let x = x;` refers to an outer x.
                    self.expr(init)?;
                    self.declare_local(name, *mutable, s.line, s.col)?;
                }
            }
            StmtKind::Fn { name, func } => {
                let ci = self.function(func, Some(name))?;
                self.emit_closure(ci, s.line, s.col)?;
                self.push_temp();
                if self.at_top_level() {
                    if self.top_names.iter().any(|n| n == name) {
                        return Err(self.err(format!("'{name}' is already defined at the top level"), s.line, s.col));
                    }
                    self.top_names.push(name.clone());
                    let gi = self.string_const(name, s.line, s.col)?;
                    self.emit_u16(Op::DefineGlobalConst, gi, s.line, s.col);
                    self.drop_temps(1);
                } else {
                    // Named function bindings are immutable.
                    self.declare_local(name, false, s.line, s.col)?;
                }
            }
            StmtKind::Class { name, parent, methods } => {
                // A class object is a plain map built right in bytecode:
                //   {"__name__": <str>, "__isclass__": true,
                //    "__parent__": <class map or null>, <method>: <closure>}
                // Methods get `self` injected as parameter 0.
                if 3 + methods.len() > u16::MAX as usize {
                    return Err(self.err("class has too many members", s.line, s.col));
                }
                let k = self.string_const("__name__", s.line, s.col)?;
                self.emit_u16(Op::Constant, k, s.line, s.col);
                let v = self.string_const(name, s.line, s.col)?;
                self.emit_u16(Op::Constant, v, s.line, s.col);
                let k = self.string_const("__isclass__", s.line, s.col)?;
                self.emit_u16(Op::Constant, k, s.line, s.col);
                self.emit(Op::True, s.line, s.col);
                let k = self.string_const("__parent__", s.line, s.col)?;
                self.emit_u16(Op::Constant, k, s.line, s.col);
                match parent {
                    Some(p) => {
                        let gi = self.string_const(p, s.line, s.col)?;
                        self.emit_u16(Op::GetGlobal, gi, s.line, s.col);
                    }
                    None => {
                        self.emit(Op::Null, s.line, s.col);
                    }
                }
                for (mname, m) in methods {
                    let ki = self.string_const(mname, s.line, s.col)?;
                    self.emit_u16(Op::Constant, ki, s.line, s.col);
                    let mut lit = m.clone();
                    lit.params.insert(0, "self".to_string());
                    let ci = self.function(&lit, Some(mname))?;
                    self.emit_closure(ci, s.line, s.col)?;
                }
                self.emit_u16(Op::Map, (3 + methods.len()) as u16, s.line, s.col);
                self.push_temp();
                if self.at_top_level() {
                    if self.top_names.iter().any(|n| n == name) {
                        return Err(self.err(format!("'{name}' is already defined at the top level"), s.line, s.col));
                    }
                    self.top_names.push(name.clone());
                    let gi = self.string_const(name, s.line, s.col)?;
                    self.emit_u16(Op::DefineGlobalConst, gi, s.line, s.col);
                    self.drop_temps(1);
                } else {
                    // Class bindings are immutable, like fn bindings.
                    self.declare_local(name, false, s.line, s.col)?;
                }
            }
            StmtKind::Assign { target, op, value } => {
                self.assign(target, op.binary(), Some(value), s.line, s.col)?;
            }
            StmtKind::IncDec { target, plus } => {
                let bin = if *plus { BinaryOp::Add } else { BinaryOp::Sub };
                self.assign(target, Some(bin), None, s.line, s.col)?;
            }
            StmtKind::Expr(e) => {
                self.expr(e)?;
                self.emit(Op::Pop, s.line, s.col);
                self.drop_temps(1);
            }
            StmtKind::Block(stmts) => {
                self.begin_scope();
                self.stmts(stmts)?;
                self.end_scope(s.line, s.col);
            }
            StmtKind::If { cond, then, els } => {
                self.expr(cond)?;
                // Fused form (26.0.9.0): the jump pops the condition itself
                // on both paths, saving the Pop dispatch.
                let jelse = self.emit_jump(Op::JumpIfFalsePop, s.line, s.col)?;
                self.drop_temps(1);
                self.stmt(then)?;
                let jend = self.emit_jump(Op::Jump, s.line, s.col)?;
                self.patch_jump(jelse, s.line, s.col)?;
                self.drop_temps(1);
                if let Some(e) = els {
                    self.stmt(e)?;
                }
                self.patch_jump(jend, s.line, s.col)?;
            }
            StmtKind::While { cond, body } => {
                let cond_start = self.cur_len();
                self.expr(cond)?;
                let jend = self.emit_jump(Op::JumpIfFalsePop, s.line, s.col)?;
                self.drop_temps(1);

                let locals_at_entry = self.cur_locals();
                self.loops.push(LoopCtx {
                    fn_depth: self.fns.len(),
                    locals_at_entry,
                    pending_at_entry: self.fns.last().unwrap().pending,
                    try_depth_at_entry: self.fns.last().unwrap().try_depth,
                    cont_locals: locals_at_entry,
                    breaks: Vec::new(),
                    conts: Vec::new(),
                    cont_target: Some(cond_start),
                });
                self.stmt(body)?;
                let ctx = self.loops.pop().unwrap();

                self.emit_jump_to(Op::Loop, cond_start, s.line, s.col)?;
                self.patch_jump(jend, s.line, s.col)?;
                self.drop_temps(1);
                for b in ctx.breaks {
                    self.patch_jump(b, s.line, s.col)?;
                }
            }
            StmtKind::ForC { init, cond, step, body } => {
                let locals_at_entry = self.cur_locals();
                self.begin_scope();
                if let Some(i) = init {
                    self.stmt(i)?;
                }
                let cond_start = self.cur_len();
                match cond {
                    Some(c) => self.expr(c)?,
                    None => {
                        self.emit(Op::True, s.line, s.col);
                        self.push_temp();
                    }
                }
                let jend = self.emit_jump(Op::JumpIfFalsePop, s.line, s.col)?;
                self.drop_temps(1);

                self.loops.push(LoopCtx {
                    fn_depth: self.fns.len(),
                    locals_at_entry,
                    pending_at_entry: self.fns.last().unwrap().pending,
                    try_depth_at_entry: self.fns.last().unwrap().try_depth,
                    cont_locals: self.cur_locals(),
                    breaks: Vec::new(),
                    conts: Vec::new(),
                    cont_target: None,
                });
                self.stmt(body)?;

                let step_start = self.cur_len();
                if let Some(st) = step {
                    self.stmt(st)?;
                }
                let ctx = self.loops.pop().unwrap();

                self.emit_jump_to(Op::Loop, cond_start, s.line, s.col)?;
                self.patch_jump(jend, s.line, s.col)?;
                self.drop_temps(1);
                for c in ctx.conts {
                    self.patch_to(c, step_start);
                }
                self.end_scope(s.line, s.col);
                for b in ctx.breaks {
                    self.patch_jump(b, s.line, s.col)?;
                }
            }
            StmtKind::ForIn { mutable, name, iter, body } => {
                let locals_at_entry = self.cur_locals();
                self.begin_scope();
                if let ExprKind::Range { start, end, inclusive } = &iter.kind {
                    // `for i in a..b { }` — a counted loop over integers:
                    // hidden mutable counter %i from `start` while < (or <=) `end`.
                    let (iline, icol) = (iter.line, iter.col);
                    self.expr(start)?;
                    let idx_slot = self.declare_local(INDEX_LOCAL, true, iline, icol)?;
                    self.expr(end)?;
                    let end_slot = self.declare_local(RANGE_END_LOCAL, false, iline, icol)?;
                    // Placeholder cell for the loop variable, filled by the fused
                    // ForRange head at the top of each iteration.
                    self.emit(Op::Null, s.line, s.col);
                    self.push_temp();
                    let elem_slot = self.declare_local(name, *mutable, s.line, s.col)?;

                    let cond_start = self.cur_len();
                    // The whole loop head is one fused instruction (26.0.9.0):
                    // compare the counter with the end, refresh the loop
                    // variable, branch out when done.
                    let head_op = if *inclusive { Op::ForRangeIncl } else { Op::ForRangeExcl };
                    let head_site = self.emit_for_head(head_op, idx_slot, end_slot, elem_slot, s.line, s.col)?;

                    self.loops.push(LoopCtx {
                        fn_depth: self.fns.len(),
                        locals_at_entry,
                        pending_at_entry: self.fns.last().unwrap().pending,
                    try_depth_at_entry: self.fns.last().unwrap().try_depth,
                        cont_locals: self.cur_locals(),
                        breaks: Vec::new(),
                        conts: Vec::new(),
                        cont_target: None,
                    });

                    self.stmt(body)?;

                    let step_start = self.cur_len();
                    let one_ci = self.int_const(1, s.line, s.col)?;
                    self.emit_u8_u16(Op::IncLocal, idx_slot, one_ci, s.line, s.col);

                    let ctx = self.loops.pop().unwrap();
                    self.emit_jump_to(Op::Loop, cond_start, s.line, s.col)?;
                    self.patch_u16_at(head_site + 3, s.line, s.col)?;
                    for c in ctx.conts {
                        self.patch_to(c, step_start);
                    }
                    self.end_scope(s.line, s.col);
                    for b in ctx.breaks {
                        self.patch_jump(b, s.line, s.col)?;
                    }
                    return Ok(());
                }
                // Array/map iteration: hidden locals for the iterable and index.
                self.expr(iter)?;
                let iter_slot = self.declare_local(ITER_LOCAL, false, s.line, s.col)?;
                let zero_ci = self.int_const(0, s.line, s.col)?;
                self.emit_u16(Op::Constant, zero_ci, s.line, s.col);
                self.push_temp();
                let idx_slot = self.declare_local(INDEX_LOCAL, true, s.line, s.col)?;
                // Placeholder for the element variable: its slot is written
                // by SetLocal at the top of each iteration, so the stack must
                // own a cell for it from the start.
                self.emit(Op::Null, s.line, s.col);
                self.push_temp();
                let elem_slot = self.declare_local(name, *mutable, s.line, s.col)?;

                let cond_start = self.cur_len();
                // Fused array loop head (26.0.9.0): bounds check, element
                // load and loop-variable refresh in one instruction.
                let head_site = self.emit_for_head(Op::ForArray, iter_slot, idx_slot, elem_slot, s.line, s.col)?;

                self.loops.push(LoopCtx {
                    fn_depth: self.fns.len(),
                    locals_at_entry,
                    pending_at_entry: self.fns.last().unwrap().pending,
                    try_depth_at_entry: self.fns.last().unwrap().try_depth,
                    cont_locals: self.cur_locals(),
                    breaks: Vec::new(),
                    conts: Vec::new(),
                    cont_target: None,
                });

                self.stmt(body)?;

                // Increment the hidden index.
                let step_start = self.cur_len();
                let one_ci = self.int_const(1, s.line, s.col)?;
                self.emit_u8_u16(Op::IncLocal, idx_slot, one_ci, s.line, s.col);

                let ctx = self.loops.pop().unwrap();
                self.emit_jump_to(Op::Loop, cond_start, s.line, s.col)?;
                self.patch_u16_at(head_site + 3, s.line, s.col)?;
                for c in ctx.conts {
                    self.patch_to(c, step_start);
                }
                self.end_scope(s.line, s.col);
                for b in ctx.breaks {
                    self.patch_jump(b, s.line, s.col)?;
                }
            }
            StmtKind::Try { body, clauses } => {
                // One handler covers the whole clause chain: on error the VM
                // unwinds here with the error object on the stack (modeled
                // as one pending temp). Each clause may filter by code or a
                // `where` condition; when no clause matches, the error is
                // rethrown unchanged (26.0.10.0).
                let try_site = self.emit_u16(Op::TryCatch, 0, s.line, s.col);
                self.cur().try_depth += 1;
                self.stmt(body)?;
                self.cur().try_depth -= 1;
                self.emit(Op::PopHandler, s.line, s.col);
                let jend = self.emit_jump(Op::Jump, s.line, s.col)?;
                self.patch_jump(try_site, s.line, s.col)?;

                // The unwinder pushed the error object; it lives in a
                // hidden local for the guards, the bindings and the rethrow.
                self.push_temp();
                self.begin_scope();
                let err_slot = self.declare_local(ERR_LOCAL, false, s.line, s.col)?;

                let mut after_jumps = Vec::new();
                // The fail jump of the previous clause: patched to the next
                // clause's start (or to the rethrow after the last one).
                let mut pending_fail: Option<usize> = None;
                for clause in clauses {
                    if let Some(j) = pending_fail.take() {
                        self.patch_jump(j, s.line, s.col)?;
                    }
                    self.begin_scope();
                    // The user binding is a copy of the hidden error local.
                    let n_binding = if let Some(n) = &clause.name {
                        self.emit_u8(Op::GetLocal, err_slot, s.line, s.col);
                        self.push_temp();
                        self.declare_local(n, false, s.line, s.col)?;
                        1
                    } else {
                        0
                    };
                    // Optional guard: `code "X"` compiles to err.code == "X"
                    // (raw emits, not counted in `pending`); `where expr` is
                    // an ordinary expression over the binding.
                    let guard_fail = match &clause.guard {
                        Some(CatchGuard::Code(code)) => {
                            self.emit_u8(Op::GetLocal, err_slot, s.line, s.col);
                            let key_ci = self.string_const("code", s.line, s.col)?;
                            self.emit_u16(Op::Constant, key_ci, s.line, s.col);
                            self.emit(Op::IndexGet, s.line, s.col);
                            let v_ci = self.string_const(code, s.line, s.col)?;
                            self.emit_u16(Op::Constant, v_ci, s.line, s.col);
                            self.emit(Op::Equal, s.line, s.col);
                            Some(self.emit_jump(Op::JumpIfFalsePop, s.line, s.col)?)
                        }
                        Some(CatchGuard::Where(e)) => {
                            self.expr(e)?;
                            let j = self.emit_jump(Op::JumpIfFalsePop, s.line, s.col)?;
                            self.drop_temps(1);
                            Some(j)
                        }
                        None => None,
                    };
                    // The handler body (matched path).
                    self.stmt(&clause.handler)?;
                    let succ_j = self.emit_jump(Op::Jump, s.line, s.col)?;
                    // Guard failed: drop the binding copy, keep %err, try
                    // the next clause.
                    if let Some(gf) = guard_fail {
                        self.patch_jump(gf, s.line, s.col)?;
                        if n_binding > 0 {
                            self.emit_u8(Op::PopN, n_binding, s.line, s.col);
                        }
                        pending_fail = Some(self.emit_jump(Op::Jump, s.line, s.col)?);
                    }
                    // Matched path: the same cleanup plus the %err cell.
                    self.patch_jump(succ_j, s.line, s.col)?;
                    self.emit_u8(Op::PopN, n_binding + 1, s.line, s.col);
                    // Both runtime paths are done; the compiler-side scope
                    // bookkeeping closes once (the PopNs above are the
                    // per-path stack cleanups).
                    self.drop_clause_locals();
                    after_jumps.push(self.emit_jump(Op::Jump, s.line, s.col)?);
                }
                // No clause matched: rethrow the same error object.
                if let Some(j) = pending_fail {
                    self.patch_jump(j, s.line, s.col)?;
                }
                self.emit_u8(Op::GetLocal, err_slot, s.line, s.col);
                self.emit(Op::Throw, s.line, s.col);
                self.end_scope(s.line, s.col);

                for j in after_jumps {
                    self.patch_jump(j, s.line, s.col)?;
                }
                self.patch_jump(jend, s.line, s.col)?;
            }
            StmtKind::Throw(value) => {
                self.expr(value)?;
                self.emit(Op::Throw, s.line, s.col);
                self.drop_temps(1);
            }
            StmtKind::Import { path, name } => {
                self.compile_import(path, name, s.line, s.col)?;
            }
            StmtKind::Return(value) => {
                if self.fns.len() == 1 {
                    return Err(self.err("'return' outside of a function", s.line, s.col));
                }
                // The value is computed while the try handlers are still
                // active (an error in it is catchable), then the handlers
                // are unregistered before leaving.
                match value {
                    Some(e) => self.expr(e)?,
                    None => {
                        self.emit(Op::Null, s.line, s.col);
                        self.push_temp();
                    }
                }
                for _ in 0..self.cur().try_depth {
                    self.emit(Op::PopHandler, s.line, s.col);
                }
                self.emit(Op::Return, s.line, s.col);
                self.drop_temps(1);
            }
            StmtKind::Break => {
                if !self.loop_available() {
                    return Err(self.err("'break' outside of a loop", s.line, s.col));
                }
                let (n, temps, handlers) = {
                    let ctx = self.loops.last().unwrap();
                    (
                        self.cur_locals() - ctx.locals_at_entry,
                        self.fns.last().unwrap().pending.saturating_sub(ctx.pending_at_entry),
                        self.fns.last().unwrap().try_depth.saturating_sub(ctx.try_depth_at_entry),
                    )
                };
                // Leave any try blocks opened inside the loop first.
                for _ in 0..handlers {
                    self.emit(Op::PopHandler, s.line, s.col);
                }
                // Locals sit above any temps pushed since the loop opened,
                // so pop them first, then the temps.
                if n > 0 {
                    self.emit_u8(Op::PopN, n.min(u8::MAX as usize) as u8, s.line, s.col);
                }
                if temps > 0 {
                    self.emit_u8(Op::PopN, temps.min(u8::MAX as usize) as u8, s.line, s.col);
                }
                let site = self.emit_jump(Op::Jump, s.line, s.col)?;
                self.loops.last_mut().unwrap().breaks.push(site);
            }
            StmtKind::Continue => {
                if !self.loop_available() {
                    return Err(self.err("'continue' outside of a loop", s.line, s.col));
                }
                let (target, n, temps, handlers) = {
                    let ctx = self.loops.last().unwrap();
                    (
                        ctx.cont_target,
                        self.cur_locals() - ctx.cont_locals,
                        self.fns.last().unwrap().pending.saturating_sub(ctx.pending_at_entry),
                        self.fns.last().unwrap().try_depth.saturating_sub(ctx.try_depth_at_entry),
                    )
                };
                for _ in 0..handlers {
                    self.emit(Op::PopHandler, s.line, s.col);
                }
                if n > 0 {
                    self.emit_u8(Op::PopN, n.min(u8::MAX as usize) as u8, s.line, s.col);
                }
                if temps > 0 {
                    self.emit_u8(Op::PopN, temps.min(u8::MAX as usize) as u8, s.line, s.col);
                }
                match target {
                    Some(t) => self.emit_jump_to(Op::Jump, t, s.line, s.col)?,
                    None => {
                        let site = self.emit_jump(Op::Jump, s.line, s.col)?;
                        self.loops.last_mut().unwrap().conts.push(site);
                    }
                }
            }
        }
        Ok(())
    }

    fn loop_available(&self) -> bool {
        self.loops
            .last()
            .map_or(false, |l| l.fn_depth == self.fns.len())
    }

    /// Compile `import "path" [as name]`: resolve the file relative to the
    /// current file, reject cycles, recursively compile it, then emit code
    /// that runs it once (VM-cached by path) and binds its exports.
    fn compile_import(
        &mut self,
        path: &str,
        name: &str,
        line: usize,
        col: usize,
    ) -> Result<(), RscpError> {
        let full = self.base_dir.join(path);
        let canon = full.canonicalize().map_err(|_| {
            self.err(format!("cannot import '{path}': file not found"), line, col)
        })?;
        if self.chain.iter().any(|p| *p == canon) {
            return Err(self.err(
                format!("circular import of '{path}' (it is already being compiled)"),
                line,
                col,
            ));
        }
        let src = std::fs::read_to_string(&canon).map_err(|e| {
            self.err(format!("cannot import '{path}': {e}"), line, col)
        })?;
        let tokens = Lexer::new(&src).tokenize()?;
        let program = Parser::new(tokens).parse()?;
        let mut chain = self.chain.clone();
        chain.push(canon.clone());
        let module_dir = canon.parent().unwrap_or(Path::new(".")).to_path_buf();
        let proto = compile_in_chain(
            &program,
            &module_dir,
            chain,
            format!("<module {name}>"),
        )?;

        // [Constant proto][Constant path] Import [Constant name] DefineGlobal
        let ci = self.constant(Value::Proto(proto), line, col)?;
        self.emit_u16(Op::Constant, ci, line, col);
        self.push_temp();
        let path_str = canon.to_string_lossy().to_string();
        let pi = self.string_const(&path_str, line, col)?;
        self.emit_u16(Op::Constant, pi, line, col);
        self.push_temp();
        self.emit(Op::Import, line, col);
        self.drop_temps(2);
        self.push_temp(); // the module's export map
        // The map from Import is the value; the name rides in the operand.
        let ni = self.string_const(name, line, col)?;
        self.emit_u16(Op::DefineGlobalConst, ni, line, col);
        self.drop_temps(1);
        if self.top_names.iter().any(|n| n == name) {
            return Err(self.err(format!("'{name}' is already defined at the top level"), line, col));
        }
        self.top_names.push(name.to_string());
        Ok(())
    }

    fn patch_to(&mut self, site: usize, target: usize) {
        self.cur().proto.chunk.patch_u16(site, target);
    }

    /// Emit `Closure ci` followed by the prototype's upvalue capture
    /// descriptors: one (is_local, index) byte pair per captured variable.
    fn emit_closure(&mut self, ci: u16, line: usize, col: usize) -> Result<(), RscpError> {
        self.emit_u16(Op::Closure, ci, line, col);
        let ups: Vec<(bool, u8)> = match &self.cur().proto.chunk.consts[ci as usize] {
            Value::Proto(p) => p.upvalues.clone(),
            _ => return Err(self.err("internal error: Closure constant is not a prototype", line, col)),
        };
        for (is_local, idx) in ups {
            let chunk = &mut self.cur().proto.chunk;
            chunk.push_byte(is_local as u8, line, col);
            chunk.push_byte(idx, line, col);
        }
        Ok(())
    }

    fn int_const(&mut self, v: i64, line: usize, col: usize) -> Result<u16, RscpError> {
        self.constant(Value::Int(v), line, col)
    }

    // ---- assignment -----------------------------------------------------------

    /// Compile an assignment. `value == None` means `++`/`--` by 1.
    fn assign(
        &mut self,
        target: &Target,
        binop: Option<BinaryOp>,
        value: Option<&Expr>,
        line: usize,
        col: usize,
    ) -> Result<(), RscpError> {
        match target {
            Target::Ident { name, line: tl, col: tc } => {
                if let Some(bin) = binop {
                    self.load_ident(name, *tl, *tc)?;
                    match value {
                        Some(v) => self.expr(v)?,
                        None => {
                            let ci = self.int_const(1, *tl, *tc)?;
                            self.emit_u16(Op::Constant, ci, line, col);
                            self.push_temp();
                        }
                    }
                    self.emit_binop(bin, line, col)?;
                    self.drop_temps(1);
                } else {
                    self.expr(value.unwrap())?;
                }
                self.store_ident(name, *tl, *tc)?;
            }
            Target::Index { obj, idx } => {
                self.expr(obj)?;
                self.expr(idx)?;
                if let Some(bin) = binop {
                    // obj, idx stay on the stack; IndexGetKeep pushes the
                    // current value, the binary op combines it, IndexSet
                    // then consumes obj, idx and the new value.
                    self.emit(Op::IndexGetKeep, line, col);
                    self.push_temp();
                    match value {
                        Some(v) => self.expr(v)?,
                        None => {
                            let ci = self.int_const(1, line, col)?;
                            self.emit_u16(Op::Constant, ci, line, col);
                            self.push_temp();
                        }
                    }
                    self.emit_binop(bin, line, col)?;
                    self.drop_temps(1);
                } else {
                    self.expr(value.unwrap())?;
                }
                self.emit(Op::IndexSet, line, col);
                self.drop_temps(3);
            }
        }
        Ok(())
    }

    fn load_ident(&mut self, name: &str, line: usize, col: usize) -> Result<(), RscpError> {
        if let Some(slot) = self.resolve_local(name) {
            self.emit_u8(Op::GetLocal, slot, line, col);
        } else if let Some(up) = self.resolve_upvalue(name, line, col)? {
            self.emit_u8(Op::GetUpvalue, up, line, col);
        } else {
            let ci = self.string_const(name, line, col)?;
            self.emit_u16(Op::GetGlobal, ci, line, col);
        }
        self.push_temp();
        Ok(())
    }

    fn store_ident(&mut self, name: &str, line: usize, col: usize) -> Result<(), RscpError> {
        if let Some(slot) = self.resolve_local(name) {
            let immutable = self
                .fns
                .last()
                .unwrap()
                .locals
                .iter()
                .find(|l| l.slot == slot)
                .map_or(false, |l| !l.mutable);
            if immutable {
                return Err(self.err(
                    format!("cannot assign to immutable variable '{name}' (declared with 'let')"),
                    line,
                    col,
                ));
            }
            self.emit_u8(Op::SetLocal, slot, line, col);
        } else if let Some(up) = self.resolve_upvalue(name, line, col)? {
            self.emit_u8(Op::SetUpvalue, up, line, col);
        } else {
            let ci = self.string_const(name, line, col)?;
            self.emit_u16(Op::SetGlobal, ci, line, col);
        }
        self.drop_temps(1);
        Ok(())
    }

    // ---- expressions --------------------------------------------------------

    fn expr(&mut self, e: &Expr) -> Result<(), RscpError> {
        match &e.kind {
            ExprKind::Int(v) => {
                let ci = self.constant(Value::Int(*v), e.line, e.col)?;
                self.emit_u16(Op::Constant, ci, e.line, e.col);
                self.push_temp();
            }
            ExprKind::Float(v) => {
                let ci = self.constant(Value::Float(*v), e.line, e.col)?;
                self.emit_u16(Op::Constant, ci, e.line, e.col);
                self.push_temp();
            }
            ExprKind::Str(v) => {
                let ci = self.string_const(v, e.line, e.col)?;
                self.emit_u16(Op::Constant, ci, e.line, e.col);
                self.push_temp();
            }
            ExprKind::Bool(b) => {
                self.emit(if *b { Op::True } else { Op::False }, e.line, e.col);
                self.push_temp();
            }
            ExprKind::Null => {
                self.emit(Op::Null, e.line, e.col);
                self.push_temp();
            }
            ExprKind::Ident(name) => {
                self.load_ident(name, e.line, e.col)?;
            }
            ExprKind::Unary { op, expr } => {
                self.expr(expr)?;
                match op {
                    UnaryOp::Not => {
                        self.emit(Op::Not, e.line, e.col);
                    }
                    UnaryOp::Neg => {
                        self.emit(Op::Negate, e.line, e.col);
                    }
                    UnaryOp::BitNot => {
                        self.emit(Op::BitNot, e.line, e.col);
                    }
                }
            }
            ExprKind::Binary { op, lhs, rhs } => {
                self.expr(lhs)?;
                self.expr(rhs)?;
                self.emit_binop(*op, e.line, e.col)?;
                self.drop_temps(1); // two operands consumed, one result
            }
            ExprKind::Logical { op, lhs, rhs } => {
                self.expr(lhs)?;
                let jump = match op {
                    LogicalOp::And => self.emit_jump(Op::JumpIfFalsePeek, e.line, e.col)?,
                    LogicalOp::Or => self.emit_jump(Op::JumpIfTruePeek, e.line, e.col)?,
                };
                self.emit(Op::Pop, e.line, e.col);
                self.drop_temps(1); // lhs replaced by rhs below
                self.expr(rhs)?;
                self.patch_jump(jump, e.line, e.col)?;
            }
            ExprKind::Ternary { cond, then, els } => {
                self.expr(cond)?;
                // The fused form pops the condition on both paths; each
                // branch then leaves exactly one value (26.0.9.0).
                let jelse = self.emit_jump(Op::JumpIfFalsePop, e.line, e.col)?;
                self.drop_temps(1);
                self.expr(then)?;
                let jend = self.emit_jump(Op::Jump, e.line, e.col)?;
                self.patch_jump(jelse, e.line, e.col)?;
                self.drop_temps(1);
                self.expr(els)?;
                self.patch_jump(jend, e.line, e.col)?;
            }
            ExprKind::Match { value, arms } => {
                self.compile_match(value, arms, e.line, e.col)?;
            }
            ExprKind::FStr(parts) => {
                // A literal-only f-string collapses to a plain constant.
                if parts.len() == 1 {
                    if let FStrPart::Lit(s) = &parts[0] {
                        let ci = self.string_const(s, e.line, e.col)?;
                        self.emit_u16(Op::Constant, ci, e.line, e.col);
                        self.push_temp();
                        return Ok(());
                    }
                }
                if parts.len() > u8::MAX as usize {
                    return Err(self.err("f-string has too many parts (max is 255)", e.line, e.col));
                }
                for p in parts {
                    match p {
                        FStrPart::Lit(s) => {
                            let ci = self.string_const(&s, e.line, e.col)?;
                            self.emit_u16(Op::Constant, ci, e.line, e.col);
                            self.push_temp();
                        }
                        FStrPart::Expr(inner) => {
                            self.expr(&inner)?;
                            // ToString replaces the value in place.
                            self.emit(Op::ToString, e.line, e.col);
                        }
                    }
                }
                self.emit_u8(Op::StrJoin, parts.len() as u8, e.line, e.col);
                self.drop_temps(parts.len());
                self.push_temp();
            }
            ExprKind::Call { callee, args } => {
                if args.len() > u8::MAX as usize {
                    return Err(self.err(format!("too many arguments in a call (max is {})", u8::MAX), e.line, e.col));
                }
                // super.name(args) — the parent's method with self bound.
                if let ExprKind::Super(name) = &callee.kind {
                    let ni = self.string_const(name, e.line, e.col)?;
                    self.emit_u16(Op::SuperMethod, ni, e.line, e.col);
                    self.push_temp();
                    let this = Expr::new(ExprKind::Ident("self".to_string()), e.line, e.col);
                    self.expr(&this)?;
                    for a in args {
                        self.expr(a)?;
                    }
                    self.emit_u8(Op::Call, (args.len() + 1) as u8, e.line, e.col);
                    self.drop_temps(args.len() + 2);
                    self.push_temp();
                    return Ok(());
                }
                // obj.key(args) — a method call (self gets bound for
                // instances; a plain map's stored function stays unbound).
                if let ExprKind::Index { obj, idx } = &callee.kind {
                    if let ExprKind::Str(key) = &idx.kind {
                        self.expr(obj)?;
                        let ki = self.string_const(key, e.line, e.col)?;
                        self.emit_u16(Op::Constant, ki, e.line, e.col);
                        self.push_temp();
                        for a in args {
                            self.expr(a)?;
                        }
                        self.emit_u8(Op::CallMethod, args.len() as u8, e.line, e.col);
                        self.drop_temps(args.len() + 2);
                        self.push_temp();
                        return Ok(());
                    }
                }
                self.expr(callee)?;
                for a in args {
                    self.expr(a)?;
                }
                self.emit_u8(Op::Call, args.len() as u8, e.line, e.col);
                self.drop_temps(args.len() + 1); // callee + args consumed
                self.push_temp(); // the result
            }
            ExprKind::Index { obj, idx } => {
                self.expr(obj)?;
                self.expr(idx)?;
                self.emit(Op::IndexGet, e.line, e.col);
                self.drop_temps(1);
            }
            ExprKind::Slice { obj, start, end, step } => {
                self.expr(obj)?;
                for part in [start.as_deref(), end.as_deref(), step.as_deref()] {
                    match part {
                        Some(p) => self.expr(p)?,
                        None => {
                            self.emit(Op::Null, e.line, e.col);
                        }
                    }
                }
                self.emit(Op::SliceGet, e.line, e.col);
                self.drop_temps(3);
            }
            ExprKind::Super(name) => {
                return Err(self.err(
                    format!("super.{name}(...) can only be used as a call inside a method"),
                    e.line,
                    e.col,
                ));
            }
            ExprKind::Range { .. } => {
                return Err(self.err(
                    "a range ('a..b') can only be the iterable of a 'for' loop",
                    e.line,
                    e.col,
                ));
            }
            ExprKind::Array(items) => {
                if items.len() > u16::MAX as usize {
                    return Err(self.err("array literal is too large", e.line, e.col));
                }
                for item in items {
                    self.expr(item)?;
                }
                self.emit_u16(Op::Array, items.len() as u16, e.line, e.col);
                self.drop_temps(items.len());
                self.push_temp();
            }
            ExprKind::Map(pairs) => {
                if pairs.len() > u16::MAX as usize {
                    return Err(self.err("map literal is too large", e.line, e.col));
                }
                for (k, v) in pairs {
                    self.expr(k)?;
                    self.expr(v)?;
                }
                self.emit_u16(Op::Map, pairs.len() as u16, e.line, e.col);
                self.drop_temps(pairs.len() * 2);
                self.push_temp();
            }
            ExprKind::Func(lit) => {
                let ci = self.function(lit, None)?;
                self.emit_closure(ci, e.line, e.col)?;
                self.push_temp();
            }
        }
        Ok(())
    }

    fn emit_binop(&mut self, op: BinaryOp, line: usize, col: usize) -> Result<(), RscpError> {
        let opcode = match op {
            BinaryOp::Add => Op::Add,
            BinaryOp::Sub => Op::Sub,
            BinaryOp::Mul => Op::Mul,
            BinaryOp::Div => Op::Div,
            BinaryOp::Mod => Op::Mod,
            BinaryOp::Pow => Op::Pow,
            BinaryOp::InstanceOf => Op::InstanceOf,
            BinaryOp::BitAnd => Op::BitAnd,
            BinaryOp::BitOr => Op::BitOr,
            BinaryOp::BitXor => Op::BitXor,
            BinaryOp::Shl => Op::Shl,
            BinaryOp::Shr => Op::Shr,
            BinaryOp::Eq => Op::Equal,
            BinaryOp::Lt => Op::Less,
            BinaryOp::Le => Op::Le,
            BinaryOp::Gt => Op::Greater,
            BinaryOp::Ge => Op::Ge,
            BinaryOp::Ne => {
                self.emit(Op::Equal, line, col);
                self.emit(Op::Not, line, col);
                return Ok(());
            }
        };
        self.emit(opcode, line, col);
        Ok(())
    }

    /// Compile `match value { arms }` as an expression: the result is left
    /// on the stack with no hidden slots underneath (see the body comment).
    fn compile_match(
        &mut self,
        value: &Expr,
        arms: &[MatchArm],
        line: usize,
        col: usize,
    ) -> Result<(), RscpError> {
        // The scrutinee lives in a hidden `%mN` local, the arm value in a
        // hidden `%rN` local (so arm scopes can close their bindings before
        // the value is produced). Both are forgotten again at the end:
        // `PopNUnder 2` drops their cells from under the result, keeping the
        // stack contiguous for surrounding expressions (`x += match ...`).
        let locals_at_start = self.cur_locals();
        self.expr(value)?;
        let m_slot = self.declare_local(&format!("%m{}", self.temp_n), false, line, col)?;
        self.emit(Op::Null, line, col);
        self.push_temp();
        let r_slot = self.declare_local(&format!("%r{}", self.temp_n), false, line, col)?;
        self.temp_n += 1;

        let mut end_jumps: Vec<usize> = Vec::new();
        let mut next_jumps: Vec<usize> = Vec::new(); // to the next arm / fallthrough

        for arm in arms {
            // Jump sites from the previous arm's failure handlers.
            for j in next_jumps.drain(..) {
                self.patch_jump(j, line, col)?;
            }

            let mut jt_sites: Vec<usize> = Vec::new(); // alternation: true -> stub
            let mut jf_sites: Vec<usize> = Vec::new(); // last test: false -> next arm
            let last = arm.patterns.len() - 1;
            for (i, p) in arm.patterns.iter().enumerate() {
                if matches!(p, Pattern::Binding(_) | Pattern::Wildcard) {
                    continue; // always matches; the parser keeps them alone
                }
                self.test_pattern(p, m_slot, line, col)?;
                if i < last {
                    let jt = self.emit_jump(Op::JumpIfTruePeek, line, col)?;
                    jt_sites.push(jt);
                    self.emit(Op::Pop, line, col); // false: try the next pattern
                } else {
                    let jf = self.emit_jump(Op::JumpIfFalsePeek, line, col)?;
                    jf_sites.push(jf);
                    self.emit(Op::Pop, line, col); // true: run this arm
                }
            }
            let body_start = self.cur_len();

            // Arm scope, binding, guard.
            let locals_before = self.cur_locals();
            self.begin_scope();
            if let Pattern::Binding(name) = &arm.patterns[0] {
                self.emit_u8(Op::GetLocal, m_slot, line, col);
                self.push_temp();
                self.declare_local(name, false, line, col)?;
            }
            let mut guard_fail: Option<usize> = None;
            let mut guard_pops = 0usize;
            if let Some(g) = &arm.guard {
                self.expr(g)?;
                guard_fail = Some(self.emit_jump(Op::JumpIfFalsePop, line, col)?);
                self.drop_temps(1);
                guard_pops = self.cur_locals() - locals_before; // the binding, if any
            }

            // Body: an expression, or a block whose last expression statement
            // is the arm's value.
            match &arm.body {
                MatchBody::Expr(e) => self.expr(e)?,
                MatchBody::Block(stmts) => self.block_value(stmts, line, col)?,
            }
            self.emit_u8(Op::SetLocal, r_slot, line, col);
            self.drop_temps(1);
            self.end_scope(line, col);
            end_jumps.push(self.emit_jump(Op::Jump, line, col)?);

            // Alternation true-paths jump here with the test bool still
            // peeked on the stack: pop it and enter the body. (Test bools
            // are raw emits, never counted in `pending`.)
            if !jt_sites.is_empty() {
                for jt in jt_sites {
                    self.patch_jump(jt, line, col)?;
                }
                self.emit(Op::Pop, line, col);
                self.emit_jump_to(Op::Jump, body_start, line, col)?;
            }

            // Failure handlers land here, after the successful path jumped away.
            for &jf in &jf_sites {
                self.patch_jump(jf, line, col)?;
            }
            if !jf_sites.is_empty() {
                self.emit(Op::Pop, line, col); // the failed test bool (peeked)
                next_jumps.push(self.emit_jump(Op::Jump, line, col)?);
            }
            if let Some(gf) = guard_fail {
                self.patch_jump(gf, line, col)?;
                // The guard bool was already consumed by JumpIfFalsePop on
                // both paths (26.0.9.0); only the binding cells remain.
                if guard_pops > 0 {
                    self.emit_u8(Op::PopN, guard_pops as u8, line, col);
                }
                next_jumps.push(self.emit_jump(Op::Jump, line, col)?);
            }
        }
        for j in next_jumps.drain(..) {
            self.patch_jump(j, line, col)?;
        }

        // No arm matched: a catchable error with code NO_ARM (26.0.10.0 —
        // used to go through panic(), which reported code PANIC).
        let e_ci = self.string_const("error", line, col)?;
        self.emit_u16(Op::GetGlobal, e_ci, line, col);
        self.push_temp();
        let code_ci = self.string_const("NO_ARM", line, col)?;
        self.emit_u16(Op::Constant, code_ci, line, col);
        self.push_temp();
        let msg_ci = self.string_const("match: no arm matched the value", line, col)?;
        self.emit_u16(Op::Constant, msg_ci, line, col);
        self.push_temp();
        self.emit_u8(Op::Call, 2, line, col);
        self.drop_temps(3);
        self.push_temp();
        self.emit(Op::Throw, line, col);
        self.drop_temps(1);

        for j in end_jumps {
            self.patch_jump(j, line, col)?;
        }
        self.emit_u8(Op::GetLocal, r_slot, line, col);
        self.push_temp();
        // Drop the two hidden cells from under the result and forget them,
        // so the enclosing scope does not pop them a second time.
        self.emit_u8(Op::PopNUnder, 2, line, col);
        self.cur().locals.truncate(locals_at_start);
        Ok(())
    }

    /// Emit a comparison of the scrutinee local `m_slot` against one
    /// literal or range pattern, leaving the test bool on the stack.
    fn test_pattern(
        &mut self,
        p: &Pattern,
        m_slot: u8,
        line: usize,
        col: usize,
    ) -> Result<(), RscpError> {
        match p {
            Pattern::Int(v) => {
                self.emit_u8(Op::GetLocal, m_slot, line, col);
                let ci = self.int_const(*v, line, col)?;
                self.emit_u16(Op::Constant, ci, line, col);
                self.emit(Op::Equal, line, col);
            }
            Pattern::Float(v) => {
                self.emit_u8(Op::GetLocal, m_slot, line, col);
                let ci = self.constant(Value::Float(*v), line, col)?;
                self.emit_u16(Op::Constant, ci, line, col);
                self.emit(Op::Equal, line, col);
            }
            Pattern::Str(s) => {
                self.emit_u8(Op::GetLocal, m_slot, line, col);
                let ci = self.string_const(s, line, col)?;
                self.emit_u16(Op::Constant, ci, line, col);
                self.emit(Op::Equal, line, col);
            }
            Pattern::Bool(b) => {
                self.emit_u8(Op::GetLocal, m_slot, line, col);
                self.emit(if *b { Op::True } else { Op::False }, line, col);
                self.emit(Op::Equal, line, col);
            }
            Pattern::Null => {
                self.emit_u8(Op::GetLocal, m_slot, line, col);
                self.emit(Op::Null, line, col);
                self.emit(Op::Equal, line, col);
            }
            Pattern::Range { lo, hi, inclusive } => {
                // lo <= m && m (<= or <) hi, with &&'s peek-jump shape so
                // exactly one bool is on the stack at the end.
                self.emit_u8(Op::GetLocal, m_slot, line, col);
                let lo_ci = self.int_const(*lo, line, col)?;
                self.emit_u16(Op::Constant, lo_ci, line, col);
                self.emit(Op::Ge, line, col);
                let jf = self.emit_jump(Op::JumpIfFalsePeek, line, col)?;
                self.emit(Op::Pop, line, col);
                self.emit_u8(Op::GetLocal, m_slot, line, col);
                let hi_ci = self.int_const(*hi, line, col)?;
                self.emit_u16(Op::Constant, hi_ci, line, col);
                self.emit(if *inclusive { Op::Le } else { Op::Less }, line, col);
                self.patch_jump(jf, line, col)?;
            }
            Pattern::Binding(_) | Pattern::Wildcard => {}
        }
        Ok(())
    }

    /// Compile a match-arm block body, leaving its value on the stack: the
    /// value of the last statement when it is an expression, else null.
    fn block_value(&mut self, stmts: &[Stmt], line: usize, col: usize) -> Result<(), RscpError> {
        match stmts.split_last() {
            None => {
                self.emit(Op::Null, line, col);
                self.push_temp();
            }
            Some((last, rest)) => {
                self.stmts(rest)?;
                match &last.kind {
                    StmtKind::Expr(e) => self.expr(e)?,
                    _ => {
                        self.stmt(last)?;
                        self.emit(Op::Null, line, col);
                        self.push_temp();
                    }
                }
            }
        }
        Ok(())
    }

    /// Compile a function literal into a prototype, register it in the
    /// enclosing constant pool and return its index.
    fn function(&mut self, lit: &FuncLit, name: Option<&str>) -> Result<u16, RscpError> {
        let (line, col) = (lit.line, lit.col);
        if lit.params.len() > u8::MAX as usize {
            return Err(self.err(format!("too many parameters (max is {})", u8::MAX), line, col));
        }
        let mut ctx = FnCtx {
            proto: FnProto {
                name: name.unwrap_or("").to_string(),
                arity: lit.params.len() as u8,
                upvalues: Vec::new(),
                chunk: Chunk::new(),
            },
            // Slot 0 is reserved for the running closure itself.
            locals: vec![Local {
                name: String::new(),
                slot: 0,
                depth: 1,
                mutable: false,
            }],
            scope_depth: 1,
            is_script: false,
            try_depth: 0,
            pending: 0,
        };
        for (i, p) in lit.params.iter().enumerate() {
            ctx.locals.push(Local {
                name: p.clone(),
                slot: i as u8 + 1,
                depth: 1,
                mutable: true, // parameters are assignable
            });
        }
        self.fns.push(ctx);
        self.stmts(&lit.body)?;
        // Implicit `return null;`
        let last_line = lit.body.last().map_or(line, |s| s.line);
        let last_col = lit.body.last().map_or(col, |s| s.col);
        self.emit(Op::Null, last_line, last_col);
        self.emit(Op::Return, last_line, last_col);
        let done = self.fns.pop().unwrap();
        self.constant(Value::Proto(Rc::new(done.proto)), line, col)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::lexer::Lexer;
    use crate::parser::Parser;

    fn compile_src(src: &str) -> Rc<FnProto> {
        let tokens = Lexer::new(src).tokenize().unwrap();
        let program = Parser::new(tokens).parse().unwrap();
        compile(&program, Path::new("")).unwrap()
    }

    #[test]
    fn globals_and_constants() {
        let proto = compile_src("let a = 42; var b = \"hi\";");
        let code = &proto.chunk.code;
        assert_eq!(code[0], Op::Constant as u8);
        // 'a' is immutable -> DefineGlobalConst
        let ops: Vec<u8> = code.clone();
        assert!(ops.windows(1).any(|w| w[0] == Op::DefineGlobalConst as u8));
        assert!(ops.windows(1).any(|w| w[0] == Op::DefineGlobal as u8));
    }

    #[test]
    fn locals_use_slots() {
        let proto = compile_src("fn f(x) { var y = x + 1; y = y + 2; return y; }");
        // Script constants: the prototype and the name "f" for DefineGlobalConst.
        assert_eq!(proto.chunk.consts.len(), 2);
        let f = match &proto.chunk.consts[0] {
            Value::Proto(p) => p.clone(),
            _ => panic!("expected proto"),
        };
        assert_eq!(f.arity, 1);
        assert_eq!(f.name, "f");
        assert!(f.chunk.code.contains(&(Op::GetLocal as u8)));
        assert!(f.chunk.code.contains(&(Op::SetLocal as u8)));
        assert!(f.chunk.code.contains(&(Op::Return as u8)));
    }

    #[test]
    fn closure_captures() {
        let proto = compile_src("fn outer() { var c = 0; fn inner() { c++; } return inner; }");
        let outer = match &proto.chunk.consts[0] {
            Value::Proto(p) => p.clone(),
            _ => panic!(),
        };
        assert_eq!(outer.upvalues.len(), 0);
        let inner = outer
            .chunk
            .consts
            .iter()
            .find_map(|c| match c {
                Value::Proto(p) if p.name == "inner" => Some(p.clone()),
                _ => None,
            })
            .unwrap();
        assert_eq!(inner.upvalues, vec![(true, 1)]); // local slot 1 = c
    }

    #[test]
    fn loop_jumps() {
        let proto = compile_src("var i = 0; while i < 3 { i++; }");
        let ops = &proto.chunk.code;
        assert!(ops.contains(&(Op::Loop as u8)));
        // Statement conditions use the fused form (26.0.9.0): the jump
        // itself pops the bool.
        assert!(ops.contains(&(Op::JumpIfFalsePop as u8)));
    }

    #[test]
    fn range_loop_compiles_to_counted_loop() {
        // `for i in 0..10 { }` must not allocate an array...
        let proto = compile_src("var t = 0\nfor i in 0..10 {\n    t += i\n}\nfor j in 0..=2 { t += j }\n");
        assert!(!proto.chunk.code.contains(&(Op::Array as u8)));
        assert!(proto.chunk.code.contains(&(Op::Loop as u8)));
        // ...and its head is one fused instruction (26.0.9.0), with the
        // counter bumped by IncLocal.
        assert!(proto.chunk.code.contains(&(Op::ForRangeExcl as u8)));
        assert!(proto.chunk.code.contains(&(Op::ForRangeIncl as u8)));
        assert!(proto.chunk.code.contains(&(Op::IncLocal as u8)));
    }

    #[test]
    fn array_loop_compiles_to_fused_head() {
        let proto = compile_src("var s = 0\nfor v in [1, 2, 3] {\n    s += v\n}\n");
        assert!(proto.chunk.code.contains(&(Op::ForArray as u8)));
        assert!(proto.chunk.code.contains(&(Op::IncLocal as u8)));
    }

    #[test]
    fn range_outside_for_rejected() {
        for src in ["var r = 1..10\n", "var x = 0\nx = 2..=5\n", "println(0..1)\n"] {
            let tokens = Lexer::new(src).tokenize().unwrap();
            let program = Parser::new(tokens).parse().unwrap();
            assert!(compile(&program, Path::new("")).is_err(), "expected error for: {src}");
        }
    }

    #[test]
    fn light_style_compiles() {
        // The whole 2026.2.0.0 feature set in one program.
        let src = "\
fn add(a, b) -> a + b
let double = |x| x * 2
var total = 0
for i in 0..=9 {
    if i % 2 == 0 { continue }
    total += double(i)
}
loop {
    total += 1
    if total > 50 { break }
}
while total > 30 {
    total -= add(1, 0)
}
";
        let proto = compile_src(src);
        assert!(proto.chunk.code.contains(&(Op::Loop as u8)));
    }

    #[test]
    fn compile_errors() {
        let cases = [
            "let x = 1; let x = 2;",
            "fn f() {} fn f() {}",
            "break;",
            "continue;",
            "return 1;",
            "fn f() { let a = 1; let a = 2; }",
        ];
        for src in cases {
            let tokens = Lexer::new(src).tokenize().unwrap();
            let program = Parser::new(tokens).parse().unwrap();
            assert!(compile(&program, Path::new("")).is_err(), "expected error for: {src}");
        }
    }
}
