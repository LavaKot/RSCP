//! Built-in functions implemented in Rust.
//!
//! Every native is registered as an immutable global, so user code can
//! shadow a builtin with its own top-level declaration (the compiler's
//! duplicate check fires first in file mode — so shadowing happens only in
//! the REPL, where redefinition is allowed).

use std::rc::Rc;
use std::cell::RefCell;
use std::time::{SystemTime, UNIX_EPOCH};

use crate::value::Value;
use crate::vm::Vm;

pub fn install(vm: &mut Vm) {
    vm.define_native("print", n_println); // print ends the line (Python style)
    vm.define_native("println", n_println); // an alias of print
    vm.define_native("write", n_write); // the no-newline form
    vm.define_native("len", n_len);
    vm.define_native("str", n_str);
    vm.define_native("int", n_int);
    vm.define_native("float", n_float);
    vm.define_native("type", n_type);
    vm.define_native("abs", n_abs);
    vm.define_native("min", n_min);
    vm.define_native("max", n_max);
    vm.define_native("sqrt", n_sqrt);
    vm.define_native("pow", n_pow);
    vm.define_native("rand", n_rand);
    vm.define_native("clock", n_clock);
    vm.define_native("push", n_push);
    vm.define_native("pop", n_pop);
    vm.define_native("keys", n_keys);
    vm.define_native("has", n_has);
    vm.define_native("assert", n_assert);
    vm.define_native("panic", n_panic);
    vm.define_native("upper", n_upper);
    vm.define_native("lower", n_lower);
    vm.define_native("trim", n_trim);
    vm.define_native("split", n_split);
    vm.define_native("join", n_join);
    vm.define_native("replace", n_replace);
    vm.define_native("contains", n_contains);
    vm.define_native("starts_with", n_starts_with);
    vm.define_native("ends_with", n_ends_with);
    vm.define_native("slice", n_slice);
    vm.define_native("find", n_find);
    vm.define_native("repeat", n_repeat);
    vm.define_native("ord", n_ord);
    vm.define_native("chr", n_chr);
}

fn join_display(args: &[Value]) -> String {
    args.iter()
        .map(|v| v.display_string(0))
        .collect::<Vec<_>>()
        .join(" ")
}

/// `write(a, ...)` — print without a trailing newline.
fn n_write(vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    if !vm.quiet {
        print!("{}", join_display(&args));
    }
    Ok(Value::Null)
}

/// `print(a, ...)` / `println(a, ...)` — print and end the line.
/// Since 2026.5.5 `print` is the Python-style primary name.
fn n_println(vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    if !vm.quiet {
        println!("{}", join_display(&args));
    }
    Ok(Value::Null)
}

fn n_len(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    let v = one_arg("len", &args)?;
    let n = match v {
        Value::Str(s) => s.chars().count() as i64,
        Value::Array(a) => a.borrow().len() as i64,
        Value::Map(m) => m.borrow().len() as i64,
        other => {
            return Err(format!(
                "len: expected a string, array or map, got {}",
                other.type_name()
            ))
        }
    };
    Ok(Value::Int(n))
}

fn n_str(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    let v = one_arg("str", &args)?;
    Ok(Value::str(v.display_string(0)))
}

fn n_int(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    let v = one_arg("int", &args)?;
    match v {
        Value::Int(i) => Ok(Value::Int(i)),
        Value::Float(f) => {
            if f.is_nan() || f.is_infinite() || f >= 9.223372036854776e18 || f < -9.223372036854776e18 {
                Err(format!("int: value {f:?} is out of range"))
            } else {
                Ok(Value::Int(f.trunc() as i64))
            }
        }
        Value::Str(s) => s
            .trim()
            .parse::<i64>()
            .map(Value::Int)
            .map_err(|_| format!("int: cannot convert '{s}' to an integer")),
        other => Err(format!(
            "int: expected a number or a numeric string, got {}",
            other.type_name()
        )),
    }
}

fn n_float(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    let v = one_arg("float", &args)?;
    match v {
        Value::Int(i) => Ok(Value::Float(i as f64)),
        Value::Float(f) => Ok(Value::Float(f)),
        Value::Str(s) => s
            .trim()
            .parse::<f64>()
            .map(Value::Float)
            .map_err(|_| format!("float: cannot convert '{s}' to a float")),
        other => Err(format!(
            "float: expected a number or a numeric string, got {}",
            other.type_name()
        )),
    }
}

fn n_type(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    let v = one_arg("type", &args)?;
    Ok(Value::str(v.type_name()))
}

fn n_abs(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    let v = one_arg("abs", &args)?;
    match v {
        Value::Int(i) => i
            .checked_abs()
            .map(Value::Int)
            .ok_or_else(|| "abs: integer overflow".to_string()),
        Value::Float(f) => Ok(Value::Float(f.abs())),
        other => Err(format!(
            "abs: expected a number, got {}",
            other.type_name()
        )),
    }
}

fn two_numbers(name: &str, args: &[Value]) -> Result<(Value, Value), String> {
    if args.len() != 2 {
        return Err(format!("{name}: expected 2 arguments, got {}", args.len()));
    }
    for a in &args[..2] {
        if !matches!(a, Value::Int(_) | Value::Float(_)) {
            return Err(format!(
                "{name}: expected numbers, got {}",
                a.type_name()
            ));
        }
    }
    Ok((args[0].clone(), args[1].clone()))
}

fn n_min(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    let (a, b) = two_numbers("min", &args)?;
    match Value::num_cmp(&a, &b) {
        Some(std::cmp::Ordering::Greater) => Ok(b),
        _ => Ok(a),
    }
}

fn n_max(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    let (a, b) = two_numbers("max", &args)?;
    match Value::num_cmp(&a, &b) {
        Some(std::cmp::Ordering::Less) => Ok(b),
        _ => Ok(a),
    }
}

fn n_sqrt(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    let v = one_arg("sqrt", &args)?;
    match v {
        Value::Int(i) => Ok(Value::Float((i as f64).sqrt())),
        Value::Float(f) => Ok(Value::Float(f.sqrt())),
        other => Err(format!(
            "sqrt: expected a number, got {}",
            other.type_name()
        )),
    }
}

fn n_pow(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    let (a, b) = two_numbers("pow", &args)?;
    let x = match a {
        Value::Int(i) => i as f64,
        Value::Float(f) => f,
        _ => unreachable!(),
    };
    let y = match b {
        Value::Int(i) => i as f64,
        Value::Float(f) => f,
        _ => unreachable!(),
    };
    Ok(Value::Float(x.powf(y)))
}

fn n_rand(vm: &mut Vm, _args: Vec<Value>) -> Result<Value, String> {
    Ok(Value::Float(vm.next_rand()))
}

fn n_clock(_vm: &mut Vm, _args: Vec<Value>) -> Result<Value, String> {
    let secs = SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .map(|d| d.as_secs_f64())
        .unwrap_or(0.0);
    Ok(Value::Float(secs))
}

fn n_push(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    if args.len() != 2 {
        return Err(format!("push: expected 2 arguments (array, value), got {}", args.len()));
    }
    match &args[0] {
        Value::Array(a) => {
            a.borrow_mut().push(args[1].clone());
            Ok(Value::Null)
        }
        other => Err(format!(
            "push: expected an array, got {}",
            other.type_name()
        )),
    }
}

fn n_pop(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    let v = one_arg("pop", &args)?;
    match v {
        Value::Array(a) => match a.borrow_mut().pop() {
            Some(v) => Ok(v),
            None => Err("pop: array is empty".to_string()),
        },
        other => Err(format!(
            "pop: expected an array, got {}",
            other.type_name()
        )),
    }
}

fn n_keys(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    let v = one_arg("keys", &args)?;
    match v {
        Value::Map(m) => {
            let mut ks: Vec<String> = m.borrow().keys().cloned().collect();
            ks.sort();
            let items: Vec<Value> = ks.into_iter().map(Value::str).collect();
            Ok(Value::Array(Rc::new(RefCell::new(items))))
        }
        other => Err(format!(
            "keys: expected a map, got {}",
            other.type_name()
        )),
    }
}

fn n_has(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    if args.len() != 2 {
        return Err(format!("has: expected 2 arguments (map, key), got {}", args.len()));
    }
    match (&args[0], &args[1]) {
        (Value::Map(m), Value::Str(k)) => Ok(Value::Bool(m.borrow().contains_key(&**k))),
        (Value::Map(_), other) => Err(format!(
            "has: the key must be a string, got {}",
            other.type_name()
        )),
        (other, _) => Err(format!(
            "has: expected a map, got {}",
            other.type_name()
        )),
    }
}

fn n_assert(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    if args.is_empty() || args.len() > 2 {
        return Err(format!(
            "assert: expected 1 or 2 arguments, got {}",
            args.len()
        ));
    }
    match &args[0] {
        Value::Bool(true) => Ok(Value::Null),
        Value::Bool(false) => {
            if args.len() == 2 {
                Err(format!("assertion failed: {}", args[1].display_string(0)))
            } else {
                Err("assertion failed".to_string())
            }
        }
        other => Err(format!(
            "assert: expected a bool, got {}",
            other.type_name()
        )),
    }
}

/// Abort with a message: `panic("oops")` raises a runtime error carrying the
/// text (catchable with `try`/`catch`, fatal otherwise).
fn n_panic(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    if args.len() > 1 {
        return Err(format!("panic: expected 0 or 1 arguments, got {}", args.len()));
    }
    match args.len() {
        0 => Err("panic".to_string()),
        _ => Err(args[0].display_string(0)),
    }
}

// ---- string and sequence helpers ------------------------------------------

fn one_string(name: &str, args: &[Value]) -> Result<Rc<str>, String> {
    let v = one_arg(name, args)?;
    match v {
        Value::Str(s) => Ok(s),
        other => Err(format!("{name}: expected a string, got {}", other.type_name())),
    }
}

fn two_strings(name: &str, args: &[Value]) -> Result<(Rc<str>, Rc<str>), String> {
    if args.len() != 2 {
        return Err(format!("{name}: expected 2 arguments, got {}", args.len()));
    }
    match (&args[0], &args[1]) {
        (Value::Str(a), Value::Str(b)) => Ok((a.clone(), b.clone())),
        (other, _) => Err(format!("{name}: expected strings, got {}", other.type_name())),
    }
}

fn n_upper(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    let s = one_string("upper", &args)?;
    Ok(Value::str(s.to_uppercase()))
}

fn n_lower(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    let s = one_string("lower", &args)?;
    Ok(Value::str(s.to_lowercase()))
}

fn n_trim(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    let s = one_string("trim", &args)?;
    Ok(Value::str(s.trim()))
}

fn n_split(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    let (s, sep) = two_strings("split", &args)?;
    if sep.is_empty() {
        return Err("split: the separator must not be empty".to_string());
    }
    let parts: Vec<Value> = s.split(sep.as_ref()).map(Value::str).collect();
    Ok(Value::Array(Rc::new(RefCell::new(parts))))
}

fn n_join(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    if args.len() != 2 {
        return Err(format!("join: expected 2 arguments (array, separator), got {}", args.len()));
    }
    let sep = match &args[1] {
        Value::Str(s) => s.clone(),
        other => return Err(format!("join: the separator must be a string, got {}", other.type_name())),
    };
    match &args[0] {
        Value::Array(a) => {
            let parts: Vec<String> = a.borrow().iter().map(|v| v.display_string(0)).collect();
            Ok(Value::str(parts.join(sep.as_ref())))
        }
        other => Err(format!("join: expected an array, got {}", other.type_name())),
    }
}

fn n_replace(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    if args.len() != 3 {
        return Err(format!("replace: expected 3 arguments (string, from, to), got {}", args.len()));
    }
    let s = match &args[0] {
        Value::Str(s) => s.clone(),
        other => return Err(format!("replace: expected a string, got {}", other.type_name())),
    };
    let (from, to) = match (&args[1], &args[2]) {
        (Value::Str(a), Value::Str(b)) => (a.clone(), b.clone()),
        (other, _) => return Err(format!("replace: from/to must be strings, got {}", other.type_name())),
    };
    if from.is_empty() {
        return Err("replace: 'from' must not be empty".to_string());
    }
    Ok(Value::str(s.replace(from.as_ref(), to.as_ref())))
}

fn n_contains(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    match (&args.get(0), &args.get(1)) {
        (Some(Value::Array(a)), Some(v)) => {
            let found = a.borrow().iter().any(|item| item.equals(v));
            Ok(Value::Bool(found))
        }
        (Some(Value::Str(_)), Some(_)) => {
            let (s, sub) = two_strings("contains", &args)?;
            Ok(Value::Bool(s.contains(sub.as_ref())))
        }
        (Some(other), _) => Err(format!(
            "contains: expected a string or array, got {}",
            other.type_name()
        )),
        _ => Err(format!("contains: expected 2 arguments, got {}", args.len())),
    }
}

fn n_starts_with(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    let (s, prefix) = two_strings("starts_with", &args)?;
    Ok(Value::Bool(s.starts_with(prefix.as_ref())))
}

fn n_ends_with(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    let (s, suffix) = two_strings("ends_with", &args)?;
    Ok(Value::Bool(s.ends_with(suffix.as_ref())))
}

/// Clamp a Python-style slice index (negatives count from the end) into
/// `0..=len` for a collection of `len` elements.
fn clamp_slice_index(i: i64, len: usize, what: &str) -> Result<usize, String> {
    let len = len as i64;
    let i = if i < 0 { i + len } else { i };
    if i < 0 {
        return Ok(0);
    }
    if i > len {
        return Ok(len as usize);
    }
    let _ = what;
    Ok(i as usize)
}

/// slice(s, a, b) / slice(arr, a, b): a substring/subarray, `b` exclusive,
/// negative indices count from the end, out-of-range clamps (Python-style).
fn n_slice(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    if args.len() != 3 {
        return Err(format!("slice: expected 3 arguments (value, start, end), got {}", args.len()));
    }
    let (a, b) = match (&args[1], &args[2]) {
        (Value::Int(a), Value::Int(b)) => (*a, *b),
        (other, _) => return Err(format!("slice: the bounds must be ints, got {}", other.type_name())),
    };
    match &args[0] {
        Value::Str(s) => {
            let chars: Vec<char> = s.chars().collect();
            let lo = clamp_slice_index(a, chars.len(), "string")?;
            let hi = clamp_slice_index(b, chars.len(), "string")?.max(lo);
            Ok(Value::str(chars[lo..hi].iter().collect::<String>()))
        }
        Value::Array(items) => {
            let len = items.borrow().len();
            let lo = clamp_slice_index(a, len, "array")?;
            let hi = clamp_slice_index(b, len, "array")?.max(lo);
            let part: Vec<Value> = items.borrow()[lo..hi].to_vec();
            Ok(Value::Array(Rc::new(RefCell::new(part))))
        }
        other => Err(format!("slice: expected a string or array, got {}", other.type_name())),
    }
}

/// find(s, sub): index of the first occurrence, or -1.
fn n_find(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    let (s, sub) = two_strings("find", &args)?;
    match s.find(sub.as_ref()) {
        Some(byte_pos) => Ok(Value::Int(s[..byte_pos].chars().count() as i64)),
        None => Ok(Value::Int(-1)),
    }
}

fn n_repeat(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    if args.len() != 2 {
        return Err(format!("repeat: expected 2 arguments, got {}", args.len()));
    }
    let s = match &args[0] {
        Value::Str(s) => s.clone(),
        other => return Err(format!("repeat: expected a string, got {}", other.type_name())),
    };
    let n = match &args[1] {
        Value::Int(i) if *i >= 0 => *i as usize,
        Value::Int(_) => return Err("repeat: the count must be >= 0".to_string()),
        other => return Err(format!("repeat: the count must be an int, got {}", other.type_name())),
    };
    if (s.chars().count() as u64) * (n as u64) > 1_000_000 {
        return Err("repeat: the result would be too large (max 1 000 000 chars)".to_string());
    }
    Ok(Value::str(s.repeat(n)))
}

/// ord(s): the code point of the first character.
fn n_ord(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    let s = one_string("ord", &args)?;
    match s.chars().next() {
        Some(c) => Ok(Value::Int(c as i64)),
        None => Err("ord: the string is empty".to_string()),
    }
}

/// chr(i): the character with that code point.
fn n_chr(_vm: &mut Vm, args: Vec<Value>) -> Result<Value, String> {
    let v = one_arg("chr", &args)?;
    match v {
        Value::Int(i) => match u32::try_from(i).ok().and_then(char::from_u32) {
            Some(c) => Ok(Value::str(c.to_string())),
            None => Err(format!("chr: {i} is not a valid Unicode code point")),
        },
        other => Err(format!("chr: expected an int, got {}", other.type_name())),
    }
}

fn one_arg(name: &str, args: &[Value]) -> Result<Value, String> {
    if args.len() != 1 {
        Err(format!("{name}: expected 1 argument, got {}", args.len()))
    } else {
        Ok(args[0].clone())
    }
}

