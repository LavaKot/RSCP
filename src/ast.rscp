//! Abstract syntax tree for RSCP.
//!
//! Every node carries the (line, col) of its first token so that the
//! compiler can report precise errors.

/// Unary operators.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum UnaryOp {
    Not, // !
    Neg, // unary -
    BitNot, // ~
}

/// Binary operators.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum BinaryOp {
    Add,
    Sub,
    Mul,
    Div,
    FloorDiv,
    Mod,
    Pow,
    BitAnd,
    BitOr,
    BitXor,
    Shl,
    Shr,
    Eq,
    Ne,
    Lt,
    Le,
    Gt,
    Ge,
    /// a instanceof B — instance-of test against a class
    InstanceOf,
}

/// Logical operators (short-circuiting).
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum LogicalOp {
    And, // &&
    Or,  // ||
}

/// Assignment operators.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum AssignOp {
    Set,      // =
    AddSet,   // +=
    SubSet,   // -=
    MulSet,   // *=
    DivSet,   // /=
    ModSet,   // %=
    BitAndSet, // &=
    BitOrSet,  // |=
    BitXorSet, // ^=
    ShlSet,    // <<=
    ShrSet,    // >>=
    PowSet,    // **=
}

impl AssignOp {
    /// The arithmetic operator for compound assignment, if any.
    pub fn binary(self) -> Option<BinaryOp> {
        match self {
            AssignOp::Set => None,
            AssignOp::AddSet => Some(BinaryOp::Add),
            AssignOp::SubSet => Some(BinaryOp::Sub),
            AssignOp::MulSet => Some(BinaryOp::Mul),
            AssignOp::DivSet => Some(BinaryOp::Div),
            AssignOp::ModSet => Some(BinaryOp::Mod),
            AssignOp::BitAndSet => Some(BinaryOp::BitAnd),
            AssignOp::BitOrSet => Some(BinaryOp::BitOr),
            AssignOp::BitXorSet => Some(BinaryOp::BitXor),
            AssignOp::ShlSet => Some(BinaryOp::Shl),
            AssignOp::ShrSet => Some(BinaryOp::Shr),
            AssignOp::PowSet => Some(BinaryOp::Pow),
        }
    }
}

/// A function literal: parameter list plus body statements.
/// Used both for named `fn` declarations and anonymous `fn` expressions.
#[derive(Debug, Clone)]
pub struct FuncLit {
    pub params: Vec<String>,
    pub body: Vec<Stmt>,
    pub line: usize,
    pub col: usize,
}

/// Assignment target (lvalue).
#[derive(Debug, Clone)]
pub enum Target {
    Ident { name: String, line: usize, col: usize },
    Index { obj: Expr, idx: Expr },
}

/// A pattern of one `match` arm.
#[derive(Debug, Clone)]
pub enum Pattern {
    Int(i64),
    Float(f64),
    Str(String),
    Bool(bool),
    Null,
    /// `a..b` (exclusive) / `a..=b` (inclusive) over integers.
    Range { lo: i64, hi: i64, inclusive: bool },
    /// Binds the matched value to a name for the arm body/guard.
    Binding(String),
    /// `_` or `else`: matches anything.
    Wildcard,
    /// `Shape.Circle` / `Shape.Rect(w, h)` — an enum-variant pattern
    /// (26.0.11.0). Payload elements may be literals, bindings or `_`
    /// (26.0.12.0): `Ast.Bin("+", l, r)`.
    EnumVariant {
        enum_name: String,
        variant: String,
        fields: Vec<VariantField>,
    },
}

/// One element inside an enum-variant pattern's parentheses.
#[derive(Debug, Clone)]
pub enum VariantField {
    /// A literal to compare the payload element with.
    Lit(Pattern),
    /// Bind the payload element to a name.
    Bind(String),
    /// Ignore the payload element (`_`).
    Wild,
}

/// The body of a `match` arm: an expression, or a block whose last
/// expression statement is the arm's value.
#[derive(Debug, Clone)]
pub enum MatchBody {
    Expr(Expr),
    Block(Vec<Stmt>),
}

/// One `match` arm: `patterns (| patterns)* [if guard] => body`.
#[derive(Debug, Clone)]
pub struct MatchArm {
    pub patterns: Vec<Pattern>,
    pub guard: Option<Expr>,
    pub body: MatchBody,
}

/// One chunk of an f-string expression: literal text or a sub-expression.
#[derive(Debug, Clone)]
pub enum FStrPart {
    Lit(String),
    Expr(Expr),
}

/// An expression node.
#[derive(Debug, Clone)]
pub struct Expr {
    pub line: usize,
    pub col: usize,
    pub kind: ExprKind,
}

#[derive(Debug, Clone)]
pub enum ExprKind {
    Int(i64),
    Float(f64),
    Str(String),
    Bool(bool),
    Null,
    Ident(String),
    Unary { op: UnaryOp, expr: Box<Expr> },
    Binary { op: BinaryOp, lhs: Box<Expr>, rhs: Box<Expr> },
    Logical { op: LogicalOp, lhs: Box<Expr>, rhs: Box<Expr> },
    Ternary { cond: Box<Expr>, then: Box<Expr>, els: Box<Expr> },
    /// `match value { arms }` — an expression producing the matched arm's value.
    Match { value: Box<Expr>, arms: Vec<MatchArm> },
    /// f"hello {name}" — literal chunks and interpolated expressions.
    FStr(Vec<FStrPart>),
    Call { callee: Box<Expr>, args: Vec<Expr> },
    Index { obj: Box<Expr>, idx: Box<Expr> },
    /// obj[start:end:step] — Python-style; any part may be absent.
    Slice {
        obj: Box<Expr>,
        start: Option<Box<Expr>>,
        end: Option<Box<Expr>>,
        step: Option<Box<Expr>>,
    },
    /// `start..end` (exclusive) or `start..=end` (inclusive).
    /// Only valid as the iterable of a `for` loop.
    Range { start: Box<Expr>, end: Box<Expr>, inclusive: bool },
    Array(Vec<Expr>),
    Map(Vec<(Expr, Expr)>),
    Func(Box<FuncLit>),
    /// super.name — only valid as the callee of a call (inside a method).
    Super(String),
}

impl Expr {
    pub fn new(kind: ExprKind, line: usize, col: usize) -> Self {
        Expr { line, col, kind }
    }

    /// Move every child expression into `out`, replacing each with a cheap
    /// leaf. Deep spines (`a+a+a…` / `a[0][0]…` 200k nodes) are built by
    /// iterative parser loops, and the default recursive drop glue for
    /// those overflowed the Rust stack (26.0.12.11).
    fn drain_children(&mut self, out: &mut Vec<Expr>) {
        let leaf = || Expr { line: 0, col: 0, kind: ExprKind::Null };
        macro_rules! take {
            ($e:expr) => {
                out.push(std::mem::replace($e, leaf()))
            };
        }
        macro_rules! take_box {
            ($b:expr) => {
                take!(&mut **$b)
            };
        }
        macro_rules! take_opt {
            ($o:expr) => {
                if let Some(b) = $o {
                    take!(b)
                }
            };
        }
        match &mut self.kind {
            ExprKind::Unary { expr, .. } => take_box!(expr),
            ExprKind::Binary { lhs, rhs, .. } | ExprKind::Logical { lhs, rhs, .. } => {
                take_box!(lhs);
                take_box!(rhs);
            }
            ExprKind::Ternary { cond, then, els } => {
                take_box!(cond);
                take_box!(then);
                take_box!(els);
            }
            ExprKind::Match { value, arms } => {
                take_box!(value);
                for arm in arms {
                    if let Some(g) = &mut arm.guard {
                        take!(g);
                    }
                    if let MatchBody::Expr(e) = &mut arm.body {
                        take!(e);
                    }
                    // Block bodies hold Stmts: their nesting is capped by the
                    // parser's MAX_DEPTH, so their drop glue is safe.
                }
            }
            ExprKind::FStr(parts) => {
                for p in parts {
                    if let FStrPart::Expr(e) = p {
                        take!(e);
                    }
                }
            }
            ExprKind::Call { callee, args } => {
                take_box!(callee);
                for a in args {
                    take!(a);
                }
            }
            ExprKind::Index { obj, idx } => {
                take_box!(obj);
                take_box!(idx);
            }
            ExprKind::Slice { obj, start, end, step } => {
                take_box!(obj);
                take_opt!(start);
                take_opt!(end);
                take_opt!(step);
            }
            ExprKind::Range { start, end, .. } => {
                take_box!(start);
                take_box!(end);
            }
            ExprKind::Array(items) => {
                for a in items {
                    take!(a);
                }
            }
            ExprKind::Map(pairs) => {
                for (k, v) in pairs {
                    take!(k);
                    take!(v);
                }
            }
            // Func bodies are Vec<Stmt>; statement nesting is capped by the
            // parser's MAX_DEPTH, so their drop glue is safe.
            ExprKind::Func(_)
            | ExprKind::Int(_)
            | ExprKind::Float(_)
            | ExprKind::Str(_)
            | ExprKind::Bool(_)
            | ExprKind::Null
            | ExprKind::Ident(_)
            | ExprKind::Super(_) => {}
        }
    }
}

impl Drop for Expr {
    fn drop(&mut self) {
        // Tear the tree down with an explicit work stack: the default
        // recursive drop glue overflowed on deep spines (26.0.12.11).
        let mut work = Vec::new();
        self.drain_children(&mut work);
        while let Some(mut e) = work.pop() {
            e.drain_children(&mut work);
            // e drops here; its own Drop finds only leaf children left.
        }
    }
}

/// A statement node.
#[derive(Debug, Clone)]
pub struct Stmt {
    pub line: usize,
    pub col: usize,
    pub kind: StmtKind,
}

#[derive(Debug, Clone)]
pub enum StmtKind {
    /// `let x = e;` (immutable binding) or `var x = e;` (mutable binding).
    Let { name: String, mutable: bool, init: Expr },
    /// `x = e;`, `x += e;`, `a[i] = e;`, ...
    Assign { target: Target, op: AssignOp, value: Expr },
    /// `x++;` / `x--;` / `a[i]++;`
    IncDec { target: Target, plus: bool },
    /// Expression used as a statement; its value is discarded.
    Expr(Expr),
    Block(Vec<Stmt>),
    If { cond: Expr, then: Box<Stmt>, els: Option<Box<Stmt>> },
    While { cond: Expr, body: Box<Stmt> },
    /// C-style `for (init; cond; step) body` (parentheses required).
    ForC {
        init: Option<Box<Stmt>>,
        cond: Option<Expr>,
        step: Option<Box<Stmt>>,
        body: Box<Stmt>,
    },
    /// `for (let x in arr) body` or the Rust-style `for x in arr body`
    /// (the loop variable is a fresh binding each iteration).
    ForIn {
        mutable: bool,
        name: String,
        iter: Expr,
        body: Box<Stmt>,
    },
    /// Named function declaration: `fn name(p1, p2) { ... }`.
    Fn { name: String, func: FuncLit },
    /// `class Name(Parent) { fn method(...) { } ... }` (2026.6.0). Methods
    /// never list `self`: the compiler injects it as parameter 0.
    Class {
        name: String,
        parent: Option<String>,
        /// Declared fields (26.0.12.6): `class Token { kind, text, pos ; ... }`.
        /// Opt-in: empty keeps the old field-less behavior.
        fields: Vec<String>,
        methods: Vec<(String, FuncLit)>,
    },
    /// `enum Shape { Circle, Rect(w, h) }` (26.0.11.0). Unit variants are
    /// values, payload variants are constructor functions; `match` patterns
    /// can destructure them and the compiler checks exhaustiveness.
    Enum {
        name: String,
        variants: Vec<(String, Vec<String>)>,
    },
    /// `try { body } catch ... { handler }` — runtime errors in `body` jump
    /// to the first clause whose guard accepts them; the error object
    /// (a map with `code`/`message`/`detail`) is bound to the clause name.
    /// When no clause matches, the error is rethrown unchanged (26.0.10.0).
    Try {
        body: Box<Stmt>,
        clauses: Vec<CatchClause>,
    },
    /// `throw expr` — raise a typed error: error objects travel unchanged,
    /// maps may carry `code`/`message`, everything else becomes code "USER".
    Throw(Expr),
    /// `import "path.rscp" [as name]` — run the module at this point and
    /// bind its exported top-level names as an immutable map.
    Import { path: String, name: String },
    Return(Option<Expr>),
    Break,
    Continue,
}

/// One `catch` clause of a `try` statement (26.0.10.0).
#[derive(Debug, Clone)]
pub struct CatchClause {
    /// The local that receives the error object (None for `catch { }`).
    pub name: Option<String>,
    /// `catch e code "DIV_ZERO"` or `catch e where e.code == "..."`.
    pub guard: Option<CatchGuard>,
    /// The handler block.
    pub handler: Box<Stmt>,
}

/// The filter of a `catch` clause.
#[derive(Debug, Clone)]
pub enum CatchGuard {
    /// `code "X"` — the error's code must equal this string.
    Code(String),
    /// `where expr` — the expression must evaluate to true.
    Where(Expr),
}

impl Stmt {
    pub fn new(kind: StmtKind, line: usize, col: usize) -> Self {
        Stmt { line, col, kind }
    }
}
