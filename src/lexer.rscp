//! Lexer: converts RSCP source text into a flat token stream.
//!
//! Positions are 1-based. `line` advances on '\n'; `col` counts characters.
//! Supported literals: integers (decimal, hex, `_` separators), floats
//! (fractional part and/or exponent), and strings — single- or
//! double-quoted, with a triple-quoted multiline form and 1-2 prefix
//! letters (f/r/b/u), plus `\xNN` and `\u{...}` escapes.
//! Comments run from '#' to the end of the line — Python style, no block
//! comments (since 2026.5.1).
//!
//! Semicolons are optional: when a newline follows a token that can end a
//! statement (Go-style automatic semicolon insertion), a `;` is synthesized
//! unless the next token cannot begin a new statement.

use crate::errors::RscpError;
use crate::token::{keyword, FStrPart, Lit, Token, TokenType};

/// Token types after which a newline terminates the statement
/// (Go's semicolon insertion rule).
fn ends_statement(ty: TokenType) -> bool {
    use TokenType::*;
    matches!(
        ty,
        Ident | Int | Float | Str | Bytes | FStr | True | False | Null | Return | Break
            | Continue | RParen | RBracket | RBrace | PlusPlus | MinusMinus
    )
}

/// Token types that never begin a new statement, so a newline right before
/// them is a continuation, not a statement end (e.g. the `}` or `]` closing
/// a multiline literal, a `,` between arguments, an `else`, ...).
fn continues_expression(ty: TokenType) -> bool {
    use TokenType::*;
    matches!(
        ty,
        RBrace | RBracket | RParen | Comma | Colon | Semicolon | Question | DotDot | DotDotEq
            | Dot | Arrow | FatArrow | Else | Catch
    )
}

/// The `;` synthesized by automatic semicolon insertion. `lexeme` is "\n" so
/// `rscp tokens` output makes the origin visible.
fn synthetic_semicolon(line: usize, col: usize) -> Token {
    Token {
        ty: TokenType::Semicolon,
        lexeme: "\n".to_string(),
        lit: None,
        line,
        col,
    }
}

pub struct Lexer<'src> {
    src: &'src str,
    pos: usize, // byte offset, always on a char boundary
    line: usize,
    col: usize,
}

impl<'src> Lexer<'src> {
    pub fn new(src: &'src str) -> Self {
        Lexer { src, pos: 0, line: 1, col: 1 }
    }

    /// Tokenize the whole source.
    pub fn tokenize(mut self) -> Result<Vec<Token>, RscpError> {
        let mut tokens: Vec<Token> = Vec::new();
        let mut newline = false; // a newline was crossed since the last token
        while let Some(c) = self.peek() {
            match c {
                ' ' | '\t' | '\r' => {
                    self.advance();
                }
                '\n' => {
                    self.advance();
                    newline = true;
                }
                '#' => self.line_comment(),
                _ => {
                    let tok = self.scan_token()?;
                    if newline
                        && tokens.last().map_or(false, |t| ends_statement(t.ty))
                        && !continues_expression(tok.ty)
                    {
                        let (l, c) = (tok.line, tok.col);
                        tokens.push(synthetic_semicolon(l, c));
                    }
                    newline = false;
                    tokens.push(tok);
                }
            }
        }
        // A semicolon is also inserted at the end of the input, so files and
        // REPL lines that omit the trailing ';' are still complete programs.
        if tokens.last().map_or(false, |t| ends_statement(t.ty)) {
            let (l, c) = (self.line, self.col);
            tokens.push(synthetic_semicolon(l, c));
        }
        tokens.push(Token {
            ty: TokenType::Eof,
            lexeme: String::new(),
            lit: None,
            line: self.line,
            col: self.col,
        });
        Ok(tokens)
    }

    /// Scan one non-trivia token: identifier, number, string or operator.
    fn scan_token(&mut self) -> Result<Token, RscpError> {
        match self.peek() {
            Some(c) if c.is_ascii_alphabetic() || c == '_' => self.identifier(),
            Some(c) if c.is_ascii_digit() => self.number(),
            Some('"') | Some('\'') => self.string_literal(self.pos, self.line, self.col, ""),
            Some('.') if self.peek_second().map_or(false, |c| c.is_ascii_digit()) => self.number(),
            _ => self.operator(),
        }
    }

    // ---- low-level cursor helpers -------------------------------------

    fn peek(&self) -> Option<char> {
        self.src[self.pos..].chars().next()
    }

    fn peek_second(&self) -> Option<char> {
        self.src[self.pos..].chars().nth(1)
    }

    fn peek_third(&self) -> Option<char> {
        self.src[self.pos..].chars().nth(2)
    }

    fn advance(&mut self) -> Option<char> {
        let c = self.src[self.pos..].chars().next()?;
        self.pos += c.len_utf8();
        if c == '\n' {
            self.line += 1;
            self.col = 1;
        } else {
            self.col += 1;
        }
        Some(c)
    }

    fn tok(&self, ty: TokenType, start: usize, line: usize, col: usize, lit: Option<Lit>) -> Token {
        Token {
            ty,
            lexeme: self.src[start..self.pos].to_string(),
            lit,
            line,
            col,
        }
    }

    // ---- token scanners -------------------------------------------------

    fn line_comment(&mut self) {
        while let Some(c) = self.peek() {
            if c == '\n' {
                break;
            }
            self.advance();
        }
    }

    fn identifier(&mut self) -> Result<Token, RscpError> {
        let (start, line, col) = (self.pos, self.line, self.col);
        while let Some(c) = self.peek() {
            if c.is_ascii_alphanumeric() || c == '_' {
                self.advance();
            } else {
                break;
            }
        }
        let text = &self.src[start..self.pos];
        // A 1-2 letter run of f/r/b/u directly before a quote starts a
        // prefixed string literal: f"...", r'...', rb"...", u"..."
        if (1..=2).contains(&text.len())
            && text.chars().all(|c| matches!(c, 'f' | 'F' | 'r' | 'R' | 'b' | 'B' | 'u' | 'U'))
            && matches!(self.peek(), Some('"' | '\''))
        {
            return self.string_literal(start, line, col, text);
        }
        let ty = keyword(text).unwrap_or(TokenType::Ident);
        Ok(self.tok(ty, start, line, col, None))
    }

    /// Parse a string prefix ("", "f", "rb", ...) into (raw, bytes, fstring).
    /// `u` is a no-op compatibility prefix, like Python 3. Invalid
    /// combinations (fb, uu, ...) return None.
    fn string_flags(prefix: &str) -> Option<(bool, bool, bool)> {
        let (mut raw, mut bytes, mut fstr) = (false, false, false);
        for c in prefix.chars() {
            match c {
                'r' | 'R' if !raw => raw = true,
                'f' | 'F' if !fstr => fstr = true,
                'b' | 'B' if !bytes => bytes = true,
                'u' | 'U' if !bytes => {}
                _ => return None,
            }
        }
        if fstr && bytes {
            return None; // f-bytes makes no sense
        }
        Some((raw, bytes, fstr))
    }

    /// Scan a string literal: `'...'` or `"..."`, a triple-quoted form for
    /// multiline bodies, and 1-2 prefix letters from f/r/b/u. Raw strings
    /// keep every backslash verbatim; bytes literals (b"...") carry their
    /// UTF-8 byte values and become arrays at parse time.
    fn string_literal(
        &mut self,
        start: usize,
        line: usize,
        col: usize,
        prefix: &str,
    ) -> Result<Token, RscpError> {
        let (raw, bytes, fstr) = Self::string_flags(prefix)
            .ok_or_else(|| RscpError::lex(format!("invalid string prefix '{prefix}'"), line, col))?;
        let quote = self.peek().unwrap();
        let triple = self.peek_second() == Some(quote) && self.peek_third() == Some(quote);
        self.advance(); // the opening quote (first of 1-3)
        if triple {
            self.advance();
            self.advance();
        }
        let unterminated = || {
            let mut close = String::new();
            for _ in 0..if triple { 3 } else { 1 } {
                close.push(quote);
            }
            RscpError::lex(format!("unterminated string literal (missing '{close}')"), line, col)
        };
        let mut parts: Vec<FStrPart> = Vec::new();
        let mut value = String::new();
        loop {
            let c = match self.peek() {
                None => return Err(unterminated()),
                Some('\n') if !triple => return Err(unterminated()),
                Some(c) => c,
            };
            // The closing quote (three in a row inside a triple-quoted body).
            if c == quote {
                if !triple {
                    self.advance();
                    return Ok(self.finish_string(start, line, col, bytes, fstr, parts, value));
                }
                if self.peek_second() == Some(quote) && self.peek_third() == Some(quote) {
                    self.advance();
                    self.advance();
                    self.advance();
                    return Ok(self.finish_string(start, line, col, bytes, fstr, parts, value));
                }
                value.push(c);
                self.advance();
                continue;
            }
            // Escapes; raw strings keep the backslash and the next char.
            if c == '\\' {
                if raw {
                    self.advance();
                    match self.peek() {
                        None => return Err(unterminated()),
                        Some(e) => {
                            value.push('\\');
                            value.push(e);
                            self.advance();
                        }
                    }
                    continue;
                }
                let (el, ec) = (self.line, self.col);
                self.advance(); // the backslash
                value.push(self.scan_escape(el, ec)?);
                continue;
            }
            // f-string holes: {expr}, with {{ and }} as literal braces.
            if fstr && c == '{' {
                if self.peek_second() == Some('{') {
                    self.advance();
                    self.advance();
                    value.push('{');
                    continue;
                }
                if !value.is_empty() {
                    parts.push(FStrPart::Lit(std::mem::take(&mut value)));
                }
                let (eline, ecol) = (self.line, self.col + 1);
                self.advance(); // '{'
                let expr_start = self.pos;
                let mut depth = 1usize;
                loop {
                    match self.peek() {
                        None | Some('\n') if !triple => {
                            return Err(RscpError::lex(
                                "unterminated '{' in f-string (missing '}')",
                                line,
                                col,
                            ))
                        }
                        None => return Err(unterminated()),
                        Some('{') => {
                            depth += 1;
                            self.advance();
                        }
                        Some('}') => {
                            depth -= 1;
                            self.advance();
                            if depth == 0 {
                                break;
                            }
                        }
                        // Copy nested string literals inside the hole verbatim
                        // (either quote style, escapes skipped) so the re-lexer
                        // sees them whole.
                        Some('"') | Some('\'') => {
                            let q = self.peek().unwrap();
                            self.advance();
                            loop {
                                match self.peek() {
                                    Some('\\') => {
                                        self.advance();
                                        self.advance();
                                    }
                                    Some(c) if c == q => {
                                        self.advance();
                                        break;
                                    }
                                    Some('\n') | None => {
                                        return Err(RscpError::lex(
                                            "unterminated string inside f-string",
                                            line,
                                            col,
                                        ))
                                    }
                                    Some(_) => {
                                        self.advance();
                                    }
                                }
                            }
                        }
                        Some(_) => {
                            self.advance();
                        }
                    }
                }
                let src = self.src[expr_start..self.pos - 1].trim().to_string();
                if src.is_empty() {
                    return Err(RscpError::lex("empty '{}' expression in f-string", eline, ecol));
                }
                parts.push(FStrPart::Expr(src, eline, ecol));
                continue;
            }
            if fstr && c == '}' && self.peek_second() == Some('}') {
                self.advance();
                self.advance();
                value.push('}');
                continue;
            }
            value.push(c);
            self.advance();
        }
    }

    /// Build the token for a finished string body.
    fn finish_string(
        &self,
        start: usize,
        line: usize,
        col: usize,
        bytes: bool,
        fstr: bool,
        mut parts: Vec<FStrPart>,
        value: String,
    ) -> Token {
        if fstr {
            if value.is_empty() && parts.is_empty() {
                parts.push(FStrPart::Lit(String::new()));
            } else if !value.is_empty() {
                parts.push(FStrPart::Lit(value));
            }
            self.tok(TokenType::FStr, start, line, col, Some(Lit::FStr(parts)))
        } else if bytes {
            self.tok(
                TokenType::Bytes,
                start,
                line,
                col,
                Some(Lit::Bytes(value.as_bytes().to_vec())),
            )
        } else {
            self.tok(TokenType::Str, start, line, col, Some(Lit::Str(value)))
        }
    }

    /// Decode one escape sequence; the leading backslash is consumed.
    fn scan_escape(&mut self, el: usize, ec: usize) -> Result<char, RscpError> {
        let err = |m: String| Err(RscpError::lex(m, el, ec));
        match self.advance() {
            Some('n') => Ok('\n'),
            Some('t') => Ok('\t'),
            Some('r') => Ok('\r'),
            Some('0') => Ok('\0'),
            Some('a') => Ok('\u{7}'),
            Some('b') => Ok('\u{8}'),
            Some('f') => Ok('\u{c}'),
            Some('v') => Ok('\u{b}'),
            Some('e') => Ok('\u{1b}'),
            Some('\\') => Ok('\\'),
            Some('\'') => Ok('\''),
            Some('"') => Ok('"'),
            Some('x') => {
                let mut v = 0u32;
                for _ in 0..2 {
                    match self.peek() {
                        Some(c) if c.is_ascii_hexdigit() => {
                            v = v * 16 + c.to_digit(16).unwrap();
                            self.advance();
                        }
                        _ => return err("\\x needs two hex digits, as in \\x41".to_string()),
                    }
                }
                Ok(char::from_u32(v).unwrap())
            }
            Some('u') => {
                if self.peek() != Some('{') {
                    return err("\\u needs braces with 1-6 hex digits, as in \\u{1F600}".to_string());
                }
                self.advance(); // {
                let mut v = 0u32;
                let mut n = 0;
                while let Some(c) = self.peek().filter(|c| c.is_ascii_hexdigit()) {
                    v = v * 16 + c.to_digit(16).unwrap();
                    n += 1;
                    if n > 6 {
                        return err("\\u{...} needs 1-6 hex digits".to_string());
                    }
                    self.advance();
                }
                if n == 0 || self.peek() != Some('}') {
                    return err("\\u{...} needs 1-6 hex digits".to_string());
                }
                self.advance(); // }
                char::from_u32(v).ok_or_else(|| {
                    RscpError::lex(format!("\\u{{{v:x}}} is not a valid Unicode character"), el, ec)
                })
            }
            Some(other) => err(format!("unknown escape sequence '\\{other}'")),
            None => err("unterminated string literal".to_string()),
        }
    }
    fn number(&mut self) -> Result<Token, RscpError> {
        let (start, line, col) = (self.pos, self.line, self.col);

        // Radix integers: 0x1F, 0b1010, 0o17 (case-insensitive prefix, `_` separators)
        if self.peek() == Some('0') {
            let (radix, name) = match self.peek_second() {
                Some('x' | 'X') => (16, "hex"),
                Some('b' | 'B') => (2, "binary"),
                Some('o' | 'O') => (8, "octal"),
                _ => (0, ""),
            };
            if radix != 0 {
                self.advance(); // 0
                self.advance(); // prefix
                let digits_start = self.pos;
                let valid = |c: char| c.is_digit(radix) || c == '_';
                while matches!(self.peek(), Some(c) if valid(c)) {
                    self.advance();
                }
                let digits: String = self.src[digits_start..self.pos]
                    .chars()
                    .filter(|&c| c != '_')
                    .collect();
                if digits.is_empty() {
                    return Err(RscpError::lex(
                        format!("invalid {name} literal: no digits after the prefix"),
                        line,
                        col,
                    ));
                }
                if self.starts_identifier()
                    || matches!(self.peek(), Some(c) if c.is_ascii_digit())
                {
                    return Err(RscpError::lex(
                        format!("invalid characters after {name} literal"),
                        self.line,
                        self.col,
                    ));
                }
                let value = i64::from_str_radix(&digits, radix).map_err(|_| {
                    RscpError::lex(format!("{name} integer literal is too large"), line, col)
                })?;
                return Ok(self.tok(TokenType::Int, start, line, col, Some(Lit::Int(value))));
            }
        }

        let mut is_float = false;
        while matches!(self.peek(), Some(c) if c.is_ascii_digit() || c == '_') {
            self.advance();
        }
        // A '.' starts the fraction unless it is the first dot of a range
        // (`1..5` is the int 1 followed by '..').
        if self.peek() == Some('.') && self.peek_second() != Some('.') {
            is_float = true;
            self.advance();
            while matches!(self.peek(), Some(c) if c.is_ascii_digit() || c == '_') {
                self.advance();
            }
        }
        if matches!(self.peek(), Some('e' | 'E')) {
            // Only treat as exponent when followed by digits or sign+digits.
            let second = self.peek_second();
            let exponent = match second {
                Some(c) if c.is_ascii_digit() => true,
                Some('+') | Some('-') => {
                    let mut it = self.src[self.pos..].chars();
                    it.next();
                    it.next();
                    matches!(it.next(), Some(c) if c.is_ascii_digit())
                }
                _ => false,
            };
            if exponent {
                is_float = true;
                self.advance(); // e
                if matches!(self.peek(), Some('+' | '-')) {
                    self.advance();
                }
                while matches!(self.peek(), Some(c) if c.is_ascii_digit() || c == '_') {
                    self.advance();
                }
            }
        }
        if self.starts_identifier() {
            return Err(RscpError::lex(
                "invalid characters after number literal",
                self.line,
                self.col,
            ));
        }

        let mut text: String = self.src[start..self.pos]
            .chars()
            .filter(|&c| c != '_')
            .collect();
        let lit = if is_float {
            if text.ends_with('.') {
                text.push('0'); // "5." -> "5.0"
            }
            if text.starts_with('.') {
                text.insert(0, '0'); // ".5" -> "0.5"
            }
            let value: f64 = text
                .parse()
                .map_err(|_| RscpError::lex("invalid float literal", line, col))?;
            Lit::Float(value)
        } else {
            let value: i64 = text
                .parse()
                .map_err(|_| RscpError::lex("integer literal is too large (max is i64)", line, col))?;
            Lit::Int(value)
        };
        Ok(self.tok(
            if is_float { TokenType::Float } else { TokenType::Int },
            start,
            line,
            col,
            Some(lit),
        ))
    }

    /// True when the cursor sits on a character that can start an identifier.
    fn starts_identifier(&self) -> bool {
        matches!(self.peek(), Some(c) if c.is_ascii_alphabetic() || c == '_')
    }


    fn operator(&mut self) -> Result<Token, RscpError> {
        use TokenType::*;
        let (start, line, col) = (self.pos, self.line, self.col);
        let c = self.advance().unwrap();
        let second = self.peek();

        let ty = match c {
            '(' => LParen,
            ')' => RParen,
            '{' => LBrace,
            '}' => RBrace,
            '[' => LBracket,
            ']' => RBracket,
            ',' => Comma,
            ';' => Semicolon,
            ':' => Colon,
            '?' => Question,
            '.' => match second {
                Some('.') => {
                    self.advance();
                    if self.peek() == Some('=') {
                        self.advance();
                        DotDotEq
                    } else {
                        DotDot
                    }
                }
                // `m.key` — property access (a lone '.' is never valid).
                Some(c) if c.is_ascii_alphabetic() || c == '_' => Dot,
                _ => {
                    return Err(RscpError::lex(
                        "unexpected character '.' (a lone '.' is not valid; use '..' for ranges or '.' for map.key access)",
                        line,
                        col,
                    ))
                }
            },
            '+' => match second {
                Some('+') => {
                    self.advance();
                    PlusPlus
                }
                Some('=') => {
                    self.advance();
                    PlusAssign
                }
                _ => Plus,
            },
            '-' => match second {
                Some('-') => {
                    self.advance();
                    MinusMinus
                }
                Some('=') => {
                    self.advance();
                    MinusAssign
                }
                Some('>') => {
                    self.advance();
                    Arrow
                }
                _ => Minus,
            },
            '*' => match second {
                Some('=') => {
                    self.advance();
                    StarAssign
                }
                Some('*') => {
                    self.advance();
                    if self.peek() == Some('=') {
                        self.advance();
                        StarStarAssign
                    } else {
                        StarStar
                    }
                }
                _ => Star,
            },
            '/' => match second {
                Some('=') => {
                    self.advance();
                    SlashAssign
                }
                _ => Slash,
            },
            '%' => match second {
                Some('=') => {
                    self.advance();
                    PercentAssign
                }
                _ => Percent,
            },
            '&' => match second {
                Some('&') => {
                    self.advance();
                    AndAnd
                }
                Some('=') => {
                    self.advance();
                    AmpAssign
                }
                _ => Amp,
            },
            '|' => match second {
                Some('|') => {
                    self.advance();
                    OrOr
                }
                Some('=') => {
                    self.advance();
                    PipeAssign
                }
                // A single '|' opens the parameter list of a short closure.
                _ => Pipe,
            },
            '^' => match second {
                Some('=') => {
                    self.advance();
                    CaretAssign
                }
                _ => Caret,
            },
            '~' => Tilde,
            '=' => match second {
                Some('=') => {
                    self.advance();
                    EqEq
                }
                Some('>') => {
                    self.advance();
                    FatArrow
                }
                _ => Assign,
            },
            '!' => match second {
                Some('=') => {
                    self.advance();
                    NotEq
                }
                _ => Not,
            },
            '<' => match second {
                Some('=') => {
                    self.advance();
                    Le
                }
                Some('<') => {
                    self.advance();
                    if self.peek() == Some('=') {
                        self.advance();
                        ShlAssign
                    } else {
                        Shl
                    }
                }
                _ => Lt,
            },
            '>' => match second {
                Some('=') => {
                    self.advance();
                    Ge
                }
                Some('>') => {
                    self.advance();
                    if self.peek() == Some('=') {
                        self.advance();
                        ShrAssign
                    } else {
                        Shr
                    }
                }
                _ => Gt,
            },
            other => {
                return Err(RscpError::lex(
                    format!("unexpected character '{other}'"),
                    line,
                    col,
                ))
            }
        };
        Ok(self.tok(ty, start, line, col, None))
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::token::TokenType::*;

    fn lex(src: &str) -> Vec<Token> {
        Lexer::new(src).tokenize().unwrap()
    }

    fn types(src: &str) -> Vec<TokenType> {
        // Ignore the `;` synthesized by automatic insertion so tests can
        // focus on the written tokens.
        lex(src)
            .into_iter()
            .filter(|t| t.lexeme != "\n")
            .map(|t| t.ty)
            .collect()
    }

    #[test]
    fn keywords_and_idents() {
        let ts = types("let var fn true false null while for in loop match");
        assert_eq!(
            ts,
            vec![Let, Var, Fn, True, False, Null, While, For, In, Loop, Match, Eof]
        );
        // Word forms of the logical operators (2026.5.2).
        let ts = types("and or not");
        assert_eq!(ts, vec![And, Or, NotWord, Eof]);
        let ts = types("letx for_ _if fn2 loopx matchy notx andy orz");
        assert_eq!(
            ts,
            vec![Ident, Ident, Ident, Ident, Ident, Ident, Ident, Ident, Ident, Eof]
        );
    }

    #[test]
    fn positions() {
        let ts = lex("let x = 1;\n  var y;");
        assert_eq!((ts[0].line, ts[0].col), (1, 1)); // let
        assert_eq!((ts[1].line, ts[1].col), (1, 5)); // x
        assert_eq!((ts[3].line, ts[3].col), (1, 9)); // 1
        assert_eq!((ts[5].line, ts[5].col), (2, 3)); // var
        assert_eq!((ts[6].line, ts[6].col), (2, 7)); // y
    }

    #[test]
    fn numbers() {
        let ts = lex("42 1.5 .5 5. 1e3 1.5e-2 0x1F 0xFF_AA 1_000 0b101 0o17 0B_1010");
        let lits: Vec<String> = ts
            .iter()
            .filter(|t| t.lit.is_some())
            .map(|t| match t.lit.as_ref().unwrap() {
                Lit::Int(i) => format!("i{i}"),
                Lit::Float(f) => format!("f{f:?}"),
                Lit::Str(s) => format!("s{s}"),
                Lit::Bytes(_) => "bs".to_string(),
                Lit::FStr(_) => "fs".to_string(),
            })
            .collect();
        assert_eq!(
            lits,
            vec![
                "i42", "f1.5", "f0.5", "f5.0", "f1000.0", "f0.015", "i31", "i65450", "i1000",
                "i5", "i15", "i10"
            ]
        );
    }

    #[test]
    fn strings_and_escapes() {
        let ts = lex("\"a\\nb\\t\\\\ \\\"c\\\" \\0\\r\"");
        match &ts[0].lit {
            Some(Lit::Str(s)) => assert_eq!(s, "a\nb\t\\ \"c\" \0\r"),
            other => panic!("bad lit: {other:?}"),
        }
        // Single quotes (2026.5.3); either quote can host the other one.
        let ts = lex("'a \"b\" \\n\\'c\\''");
        match &ts[0].lit {
            Some(Lit::Str(s)) => assert_eq!(s, "a \"b\" \n'c'"),
            other => panic!("bad lit: {other:?}"),
        }
        // The new 2026.5.3 escapes: \xNN, \u{...}, \a \b \f \v \e.
        let ts = lex("\"\\x41\\u{1F600}\\a\\b\\f\\v\\e\"");
        match &ts[0].lit {
            Some(Lit::Str(s)) => assert_eq!(s, "A\u{1F600}\u{7}\u{8}\u{c}\u{b}\u{1b}"),
            other => panic!("bad lit: {other:?}"),
        }
        // Raw strings keep backslashes; u is a no-op compatibility prefix.
        let ts = lex("r\"a\\nb\" u'x\\ty' R\"q\"");
        match &ts[0].lit {
            Some(Lit::Str(s)) => assert_eq!(s, "a\\nb"),
            other => panic!("bad lit: {other:?}"),
        }
        match &ts[1].lit {
            Some(Lit::Str(s)) => assert_eq!(s, "x\ty"), // u is a no-op: \t is a real tab
            other => panic!("bad lit: {other:?}"),
        }
        match &ts[2].lit {
            Some(Lit::Str(s)) => assert_eq!(s, "q"), // R"q" — raw, uppercase prefix
            other => panic!("bad lit: {other:?}"),
        }
        // Bytes carry UTF-8 byte values.
        let ts = lex("b\"hi\"");
        match &ts[0].lit {
            Some(Lit::Bytes(b)) => assert_eq!(b, &[104, 105]),
            other => panic!("bad lit: {other:?}"),
        }
        // Triple-quoted strings span lines.
        let ts = lex("\"\"\"a\nb\n\"\"\"");
        match &ts[0].lit {
            Some(Lit::Str(s)) => assert_eq!(s, "a\nb\n"),
            other => panic!("bad lit: {other:?}"),
        }
        // f-strings: prefix letters combine (fr), either quote style.
        let ts = lex("f'{n}' fr\"x\"");
        assert_eq!(ts[0].ty, FStr);
        assert_eq!(ts[1].ty, FStr);
    }

    #[test]
    fn operators() {
        let ts = types("+ ++ += == = != <= < && || ! ++-- -> .. ..= | |x| =>");
        assert_eq!(
            ts,
            vec![
                Plus, PlusPlus, PlusAssign, EqEq, Assign, NotEq, Le, Lt, AndAnd, OrOr, Not,
                PlusPlus, MinusMinus, Arrow, DotDot, DotDotEq, Pipe, Pipe, Ident, Pipe,
                FatArrow, Eof
            ]
        );
        // Bitwise operators and their compound forms.
        let ts = types("& &= | |= ^ ^= ~ << <<= >> >>= 1 & 2");
        assert_eq!(
            ts,
            vec![
                Amp, AmpAssign, Pipe, PipeAssign, Caret, CaretAssign, Tilde, Shl, ShlAssign,
                Shr, ShrAssign, Int, Amp, Int, Eof
            ]
        );
        // Exponentiation.
        let ts = types("2 ** 3  2 **= 3  2 * 3");
        assert_eq!(ts, vec![Int, StarStar, Int, Int, StarStarAssign, Int, Int, Star, Int, Eof]);
    }

    #[test]
    fn ranges_not_floats() {
        // `1..5` must lex as int 1, '..', int 5 — not as floats.
        let ts = types("1..5 0..=9 1.5..2");
        assert_eq!(ts, vec![Int, DotDot, Int, Int, DotDotEq, Int, Float, DotDot, Int, Eof]);
    }

    #[test]
    fn comments() {
        // '#' comments run to the end of the line (since 2026.5.1).
        let ts = lex("# line\n1 # trailing");
        let kinds: Vec<crate::token::TokenType> = ts.iter().map(|t| t.ty).collect();
        assert_eq!(kinds, vec![crate::token::TokenType::Int, crate::token::TokenType::Semicolon, crate::token::TokenType::Eof]);
        assert_eq!((ts[0].line, ts[0].col), (2, 1));
        // A '#' comment swallows the rest of the line, so the next token
        // starts on the following line.
        let ts = lex("1 # two\n2");
        let kinds: Vec<crate::token::TokenType> = ts.iter().map(|t| t.ty).collect();
        assert_eq!(kinds, vec![crate::token::TokenType::Int, crate::token::TokenType::Semicolon, crate::token::TokenType::Int, crate::token::TokenType::Semicolon, crate::token::TokenType::Eof]);
        // Division still lexes as Slash.
        let ts = lex("1 / 2");
        let kinds: Vec<crate::token::TokenType> = ts.iter().map(|t| t.ty).collect();
        assert_eq!(kinds, vec![crate::token::TokenType::Int, crate::token::TokenType::Slash, crate::token::TokenType::Int, crate::token::TokenType::Semicolon, crate::token::TokenType::Eof]);
    }

    #[test]
    fn asi_inserts_at_newline() {
        // A value at end of line -> a ';' is synthesized.
        let ts = lex("let x = 1\nlet y = 2\n");
        let semis = ts.iter().filter(|t| t.ty == Semicolon).count();
        assert_eq!(semis, 2); // one per line (plus none needed at EOF)
        // Explicit ';' still works and is not duplicated.
        let ts = lex("let x = 1;\nlet y = 2;\n");
        let semis = ts.iter().filter(|t| t.ty == Semicolon).count();
        assert_eq!(semis, 2);
    }

    #[test]
    fn asi_at_end_of_input() {
        // No trailing newline: the input still ends with a synthesized ';'.
        let ts = lex("var x = 1");
        assert_eq!(ts[ts.len() - 2].ty, Semicolon);
        // Incomplete constructs are left open for the REPL.
        let ts = lex("let x = 1 +");
        assert_eq!(ts.last().unwrap().ty, Eof);
        assert!(!ts.iter().any(|t| t.ty == Semicolon));
    }

    #[test]
    fn asi_continues_lines() {
        // Operator/closer at line start: continuation, no insertion *inside*
        // the construct (a final ';' before end of input is expected).
        let inner = |src: &str| -> usize {
            let ts = lex(src);
            let last_is_semi = ts.len() >= 2 && ts[ts.len() - 2].ty == Semicolon;
            let total = ts.iter().filter(|t| t.ty == Semicolon).count();
            total - if last_is_semi { 1 } else { 0 }
        };
        for src in [
            "var x = 1 +\n    2",
            "var m = {\n    \"a\": 1,\n}",
            "var a = [\n    1,\n    2,\n]",
            "f(\n    a,\n    b,\n)",
            "if done {\n    break\n} else {\n    continue\n}",
            "var y = a[\n    1\n]",
            "let f = |x|\n    x + 1",
        ] {
            assert_eq!(inner(src), 0, "unexpected insertion inside:\n{src}");
        }
        // A plain value at end of line does terminate the statement.
        assert_eq!(inner("var x = 1\nvar y = 2"), 1);
    }

    #[test]
    fn errors() {
        assert!(Lexer::new("\"unterminated").tokenize().is_err());
        assert!(Lexer::new("\"bad \\q escape\"").tokenize().is_err());
        assert!(Lexer::new("# a comment is never a lex error").tokenize().is_ok());
        assert!(Lexer::new("'unterminated").tokenize().is_err());
        assert!(Lexer::new("\"\"\"never closed").tokenize().is_err());
        assert!(Lexer::new("\"\\x4\"").tokenize().is_err()); // \x needs two hex digits
        assert!(Lexer::new("\"\\u{}\"").tokenize().is_err());
        assert!(Lexer::new("\"\\u{110000}\"").tokenize().is_err()); // out of Unicode range
        assert!(Lexer::new("fb\"x\"").tokenize().is_err()); // f and b cannot combine
        assert!(Lexer::new("let a = $;").tokenize().is_err());
        assert!(Lexer::new("0x").tokenize().is_err());
        assert!(Lexer::new("0b").tokenize().is_err());
        assert!(Lexer::new("0b12").tokenize().is_err()); // '2' is not a binary digit
        assert!(Lexer::new("0o8").tokenize().is_err()); // '8' is not an octal digit
        assert!(Lexer::new("99999999999999999999999").tokenize().is_err());
        assert!(Lexer::new("let a = .;").tokenize().is_err()); // lone '.'
    }
}
