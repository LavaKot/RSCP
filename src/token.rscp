//! Token definitions for the RSCP language.

/// Literal values attached to tokens by the lexer.
#[derive(Debug, Clone, PartialEq)]
pub enum Lit {
    Int(i64),
    Float(f64),
    Str(String),
    /// b"..." — the UTF-8 byte values of a bytes literal.
    Bytes(Vec<u8>),
    /// An f-string: literal chunks alternating with raw expression sources
    /// plus the position where each expression starts.
    FStr(Vec<FStrPart>),
}

/// One chunk of an f-string literal.
#[derive(Debug, Clone, PartialEq)]
pub enum FStrPart {
    /// Literal text (escapes already processed, `{{`/`}}` unescaped).
    Lit(String),
    /// Raw expression source and its (line, col) in the original file.
    Expr(String, usize, usize),
}

/// Every lexical token type in RSCP.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum TokenType {
    // Literals and identifiers
    Int,
    Float,
    Str,
    Bytes,
    FStr,
    Ident,
    // Keywords
    Fn,
    Let,
    Var,
    True,
    False,
    Null,
    If,
    Else,
    While,
    Loop,
    For,
    In,
    Match,
    Try,
    Catch,
    Throw,
    Import,
    As,
    Class,
    Enum,
    SelfKw,
    Super,
    InstanceOf,
    Return,
    Break,
    Continue,
    // Delimiters
    LParen,
    RParen,
    LBrace,
    RBrace,
    LBracket,
    RBracket,
    Comma,
    Semicolon,
    Colon,
    Question,
    Arrow,
    FatArrow,
    DotDot,
    DotDotEq,
    Pipe,
    /// `.` property access: `map.key` (only before an identifier)
    Dot,
    // Assignment operators
    Assign,
    PlusAssign,
    MinusAssign,
    StarAssign,
    SlashAssign,
    PercentAssign,
    AmpAssign,
    PipeAssign,
    CaretAssign,
    ShlAssign,
    ShrAssign,
    StarStarAssign,
    // Arithmetic operators
    Plus,
    Minus,
    Star,
    StarStar,
    Slash,
    Percent,
    // Bitwise operators
    Amp,
    Caret,
    Tilde,
    Shl,
    Shr,
    PlusPlus,
    MinusMinus,
    // Comparison operators
    EqEq,
    NotEq,
    Lt,
    Le,
    Gt,
    Ge,
    // Logical operators
    AndAnd,
    OrOr,
    Not,
    // Word forms of the logical operators (since 2026.5.2): and, or, not
    And,
    Or,
    NotWord,
    // End of input
    Eof,
    /// A `#` comment, produced only by `tokenize_keep_comments` (for fmt).
    Comment,
}

impl TokenType {
    /// Human-readable name used in parser error messages.
    pub fn describe(self) -> String {
        use TokenType::*;
        let s = match self {
            Int => "an integer literal",
            Float => "a float literal",
            Str => "a string literal",
            Bytes => "a bytes literal (b\"...\")",
            FStr => "an f-string literal",
            Ident => "an identifier",
            Fn => "'fn'",
            Let => "'let'",
            Var => "'var'",
            True => "'true'",
            False => "'false'",
            Null => "'null'",
            If => "'if'",
            Else => "'else'",
            While => "'while'",
            Loop => "'loop'",
            For => "'for'",
            In => "'in'",
            Match => "'match'",
            Try => "'try'",
            Catch => "'catch'",
            Throw => "'throw'",
            Import => "'import'",
            As => "'as'",
            Class => "'class'",
            Enum => "'enum'",
            SelfKw => "'self'",
            Super => "'super'",
            InstanceOf => "'instanceof'",
            Return => "'return'",
            Break => "'break'",
            Continue => "'continue'",
            LParen => "'('",
            RParen => "')'",
            LBrace => "'{'",
            RBrace => "'}'",
            LBracket => "'['",
            RBracket => "']'",
            Comma => "','",
            Semicolon => "';'",
            Colon => "':'",
            Question => "'?'",
            Arrow => "'->'",
            FatArrow => "'=>'",
            DotDot => "'..'",
            DotDotEq => "'..='",
            Dot => "'.'",
            Pipe => "'|'",
            Assign => "'='",
            PlusAssign => "'+='",
            MinusAssign => "'-='",
            StarAssign => "'*='",
            SlashAssign => "'/='",
            PercentAssign => "'%='",
            AmpAssign => "'&='",
            PipeAssign => "'|='",
            CaretAssign => "'^='",
            ShlAssign => "'<<='",
            ShrAssign => "'>>='",
            StarStarAssign => "'**='",
            Plus => "'+'",
            Minus => "'-'",
            Star => "'*'",
            StarStar => "'**'",
            Slash => "'/'",
            Percent => "'%'",
            Amp => "'&'",
            Caret => "'^'",
            Tilde => "'~'",
            Shl => "'<<'",
            Shr => "'>>'",
            PlusPlus => "'++'",
            MinusMinus => "'--'",
            EqEq => "'=='",
            NotEq => "'!='",
            Lt => "'<'",
            Le => "'<='",
            Gt => "'>'",
            Ge => "'>='",
            AndAnd => "'&&'",
            OrOr => "'||'",
            Not => "'!'",
            And => "'and'",
            Or => "'or'",
            NotWord => "'not'",
            Eof => "end of input",
            Comment => "a comment",
        };
        s.to_string()
    }
}

/// A single token with its source position (1-based line and column).
#[derive(Debug, Clone)]
pub struct Token {
    pub ty: TokenType,
    pub lexeme: String,
    pub lit: Option<Lit>,
    pub line: usize,
    pub col: usize,
}

/// Map an identifier to a keyword token type, if it is one.
pub fn keyword(ident: &str) -> Option<TokenType> {
    use TokenType::*;
    Some(match ident {
        "fn" => Fn,
        "let" => Let,
        "var" => Var,
        "true" => True,
        "false" => False,
        "null" => Null,
        "nil" => Null, // synonyms since 2026.5.5
        "none" => Null,
        "if" => If,
        "else" => Else,
        "while" => While,
        "loop" => Loop,
        "for" => For,
        "in" => In,
        "match" => Match,
        "try" => Try,
        "catch" => Catch,
        "throw" => Throw,
        "import" => Import,
        "as" => As,
        "class" => Class,
        "enum" => Enum,
        "self" => SelfKw,
        "super" => Super,
        "instanceof" => InstanceOf,
        "return" => Return,
        "break" => Break,
        "continue" => Continue,
        "and" => And,
        "or" => Or,
        "not" => NotWord,
        _ => return None,
    })
}
