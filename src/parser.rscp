//! Recursive-descent parser with precedence climbing for binary operators.
//!
//! Produces an AST from the token stream. Stops at the first error
//! (carrying its position), except that the REPL can ask whether the error
//! was caused by end of input to keep reading lines.

use crate::ast::*;
use crate::errors::RscpError;
use crate::lexer::Lexer;
use crate::token::{Lit, Token, TokenType};

/// Maximum nesting depth of statements/expressions, to protect the Rust
/// stack from pathological input such as thousands of nested parentheses.
const MAX_DEPTH: usize = 300;

const MAX_PARAMS: usize = 255;
const MAX_ARGS: usize = 255;

type PResult<T> = Result<T, RscpError>;

/// Re-lex and parse one f-string interpolation. The fragment lives on a
/// single source line, so every token's position shifts by the hole's
/// (line, col); errors are remapped the same way.
fn parse_interp(src: &str, line: usize, col: usize) -> PResult<Expr> {
    let remap = |e: RscpError| -> RscpError {
        let shift = |c: usize| col + c.saturating_sub(1);
        match e {
            RscpError::Lex { msg, col: c, .. } => RscpError::lex(msg, line, shift(c)),
            // The f-string literal itself is closed, so "need more input"
            // would be wrong — report it as a plain error.
            RscpError::Parse { msg, col: c, .. } => {
                RscpError::parse(msg, line, shift(c), false)
            }
            other => other,
        }
    };
    let mut tokens = Lexer::new(src).tokenize().map_err(remap)?;
    for t in &mut tokens {
        t.line = line;
        t.col = col + t.col.saturating_sub(1);
    }
    let stmts = Parser::new(tokens).parse().map_err(remap)?;
    match stmts.as_slice() {
        [s] => match &s.kind {
            StmtKind::Expr(e) => Ok(e.clone()),
            _ => Err(RscpError::parse(
                "an f-string interpolation must be a single expression",
                line,
                col,
                false,
            )),
        },
        _ => Err(RscpError::parse(
            "an f-string interpolation must be a single expression",
            line,
            col,
            false,
        )),
    }
}

pub struct Parser {
    tokens: Vec<Token>,
    pos: usize,
    depth: usize,
    /// Inside a `match` arm guard: `=>` closes the guard, so `x => ...`
    /// must not parse as an arrow closure there (26.0.11.0).
    no_arrow: usize,
}

impl Parser {
    pub fn new(tokens: Vec<Token>) -> Self {
        Parser { tokens, pos: 0, depth: 0, no_arrow: 0 }
    }

    /// Parse a whole program (a list of statements) up to end of input.
    pub fn parse(mut self) -> PResult<Vec<Stmt>> {
        let mut stmts = Vec::new();
        while !self.at_eof() {
            if self.match_ty(TokenType::Semicolon).is_some() {
                continue; // empty statement (explicit or inserted)
            }
            let s = self.statement()?;
            stmts.push(s);
        }
        Ok(stmts)
    }

    // ---- cursor helpers --------------------------------------------------

    fn peek(&self) -> &Token {
        &self.tokens[self.pos.min(self.tokens.len() - 1)]
    }

    fn peek_ty(&self) -> TokenType {
        self.peek().ty
    }

    fn peek_at(&self, n: usize) -> &Token {
        let i = (self.pos + n).min(self.tokens.len() - 1);
        &self.tokens[i]
    }

    fn at_eof(&self) -> bool {
        self.peek_ty() == TokenType::Eof
    }

    fn advance(&mut self) -> Token {
        let t = self.tokens[self.pos.min(self.tokens.len() - 1)].clone();
        if self.pos < self.tokens.len() - 1 {
            self.pos += 1;
        }
        t
    }

    fn check(&self, ty: TokenType) -> bool {
        self.peek_ty() == ty
    }

    fn match_ty(&mut self, ty: TokenType) -> Option<Token> {
        if self.check(ty) {
            Some(self.advance())
        } else {
            None
        }
    }

    fn expect(&mut self, ty: TokenType, what: &str) -> PResult<Token> {
        if self.check(ty) {
            Ok(self.advance())
        } else {
            Err(self.error_here(format!("expected {what}, found {}", self.peek_ty().describe())))
        }
    }

    fn error_here(&self, msg: impl Into<String>) -> RscpError {
        let t = self.peek();
        RscpError::parse(msg, t.line, t.col, t.ty == TokenType::Eof)
    }

    fn error_at(&self, tok: &Token, msg: impl Into<String>) -> RscpError {
        RscpError::parse(msg, tok.line, tok.col, false)
    }

    /// A friendly error for pre-2026.5.1 `//` and `/* */` comments: they are
    /// no longer lexed away, so they surface as stray '/' tokens.
    fn old_comment_hint(&self) -> Option<RscpError> {
        if self.peek_ty() == TokenType::Slash {
            if self.peek_at(1).ty == TokenType::Slash {
                return Some(self.error_here(
                    "line comments start with '#', not '//' (since 2026.5.1)",
                ));
            }
            if self.peek_at(1).ty == TokenType::Star {
                return Some(self.error_here(
                    "block comments '/* */' were removed in 2026.5.1; use '#' line comments",
                ));
            }
        }
        None
    }

    /// Terminate a statement: a `;` (explicit or inserted), the `}` of
    /// the enclosing block, or a continuation keyword (`else`, `catch`)
    /// directly after a brace-less single-statement body, where semicolon
    /// insertion is suppressed before them.
    fn end_statement(&mut self, what: &str) -> PResult<()> {
        if self.match_ty(TokenType::Semicolon).is_some() {
            return Ok(());
        }
        if matches!(self.peek_ty(), TokenType::RBrace | TokenType::Else | TokenType::Catch) {
            return Ok(());
        }
        if let Some(e) = self.old_comment_hint() {
            return Err(e);
        }
        Err(self.error_here(format!(
            "expected ';' (or '}}') {what}"
        )))
    }

    fn enter(&mut self) -> PResult<()> {
        self.depth += 1;
        if self.depth > MAX_DEPTH {
            Err(self.error_here("nesting is too deep"))
        } else {
            Ok(())
        }
    }

    fn leave(&mut self) {
        self.depth -= 1;
    }

    // ---- statements --------------------------------------------------------

    fn statement(&mut self) -> PResult<Stmt> {
        self.enter()?;
        let r = self.statement_inner();
        self.leave();
        r
    }

    fn statement_inner(&mut self) -> PResult<Stmt> {
        use TokenType::*;
        match self.peek_ty() {
            Let | Var => {
                let s = self.declaration()?;
                self.end_statement("after declaration")?;
                Ok(s)
            }
            Fn => self.fn_statement(),
            Class => self.class_statement(),
            Enum => self.enum_statement(),
            If => self.if_statement(),
            While => self.while_statement(),
            Loop => self.loop_statement(),
            For => self.for_statement(),
            Try => self.try_statement(),
            Throw => self.throw_statement(),
            Import => self.import_statement(),
            Return => self.return_statement(),
            Break => {
                let t = self.advance();
                self.end_statement("after 'break'")?;
                Ok(Stmt::new(StmtKind::Break, t.line, t.col))
            }
            Continue => {
                let t = self.advance();
                self.end_statement("after 'continue'")?;
                Ok(Stmt::new(StmtKind::Continue, t.line, t.col))
            }
            LBrace => {
                let t = self.peek().clone();
                let stmts = self.block()?;
                Ok(Stmt::new(StmtKind::Block(stmts), t.line, t.col))
            }
            _ => self.expr_or_assign_statement(true),
        }
    }

    /// `let`/`var` declaration without the trailing semicolon
    /// (the caller decides whether a `;` follows).
    fn declaration(&mut self) -> PResult<Stmt> {
        let kw = self.advance(); // let | var
        self.declaration_after(kw)
    }

    fn fn_statement(&mut self) -> PResult<Stmt> {
        let kw = self.advance(); // fn
        let name = self.expect(TokenType::Ident, "a function name after 'fn'")?;
        let func = self.func_body()?;
        Ok(Stmt::new(
            StmtKind::Fn {
                name: name.lexeme.clone(),
                func,
            },
            kw.line,
            kw.col,
        ))
    }

    /// `class Name(Parent) { fn init(...) { } fn method(...) { } }`.
    /// A class body holds only `fn` methods; `self` is injected by the
    /// compiler, so methods never list it in their parameters.
    fn class_statement(&mut self) -> PResult<Stmt> {
        let kw = self.advance(); // class
        let name = self.expect(TokenType::Ident, "a class name after 'class'")?;
        let parent = if self.match_ty(TokenType::LParen).is_some() {
            let p = self.expect(TokenType::Ident, "a parent class name")?;
            self.expect(TokenType::RParen, "')' after the parent class name")?;
            Some(p.lexeme.clone())
        } else {
            None
        };
        if !self.check(TokenType::LBrace) {
            return Err(self.error_here("'{' to open the class body"));
        }
        self.advance(); // {
        let mut methods: Vec<(String, FuncLit)> = Vec::new();
        loop {
            if self.check(TokenType::RBrace) {
                break;
            }
            if self.at_eof() {
                return Err(self.error_here("unterminated class body: expected '}'"));
            }
            if self.match_ty(TokenType::Semicolon).is_some() {
                continue; // empty statement
            }
            self.expect(TokenType::Fn, "'fn' (a class body holds only methods)")?;
            let mname = self.expect(TokenType::Ident, "a method name after 'fn'")?;
            if methods.iter().any(|(n, _)| n == &mname.lexeme) {
                return Err(self.error_at(&mname, format!("duplicate method '{}'", mname.lexeme)));
            }
            let func = self.func_body()?;
            methods.push((mname.lexeme.clone(), func));
        }
        self.advance(); // }
        Ok(Stmt::new(
            StmtKind::Class { name: name.lexeme.clone(), parent, methods },
            kw.line,
            kw.col,
        ))
    }

    /// `enum Name { Unit, Tuple(a, b), ... }` (26.0.11.0). Unit variants
    /// become values, tuple variants become constructor functions.
    fn enum_statement(&mut self) -> PResult<Stmt> {
        let kw = self.advance(); // enum
        let name = self.expect(TokenType::Ident, "an enum name after 'enum'")?;
        if !self.check(TokenType::LBrace) {
            return Err(self.error_here("'{' to open the enum body"));
        }
        self.advance(); // {
        let mut variants: Vec<(String, Vec<String>)> = Vec::new();
        loop {
            if self.check(TokenType::RBrace) {
                break;
            }
            if self.at_eof() {
                return Err(self.error_here("unterminated enum body: expected '}'"));
            }
            if self.match_ty(TokenType::Semicolon).is_some() || self.match_ty(TokenType::Comma).is_some() {
                continue;
            }
            let vname = self.expect(TokenType::Ident, "a variant name")?;
            if variants.iter().any(|(n, _)| n == &vname.lexeme) {
                return Err(self.error_at(&vname, format!("duplicate enum variant '{}'", vname.lexeme)));
            }
            let mut params: Vec<String> = Vec::new();
            if self.match_ty(TokenType::LParen).is_some() {
                loop {
                    if self.check(TokenType::RParen) {
                        break;
                    }
                    let p = self.expect(TokenType::Ident, "a variant parameter name")?;
                    if params.iter().any(|x| x == &p.lexeme) {
                        return Err(self.error_at(&p, format!("duplicate parameter '{}' in enum variant", p.lexeme)));
                    }
                    params.push(p.lexeme.clone());
                    if self.match_ty(TokenType::Comma).is_some() {
                        continue;
                    }
                    break;
                }
                self.expect(TokenType::RParen, "')' after the variant parameters")?;
            }
            variants.push((vname.lexeme.clone(), params));
            if self.match_ty(TokenType::Comma).is_some() {
                continue;
            }
            if !self.check(TokenType::RBrace) {
                return Err(self.error_here("',' or '}' after an enum variant"));
            }
        }
        self.advance(); // }
        if variants.is_empty() {
            return Err(self.error_at(&name, "an enum needs at least one variant"));
        }
        Ok(Stmt::new(
            StmtKind::Enum { name: name.lexeme.clone(), variants },
            kw.line,
            kw.col,
        ))
    }

    /// Everything after the `fn` keyword: `(params) { body }` or, lighter,
    /// `(params) -> expression` (an implicit `return`).
    fn func_body(&mut self) -> PResult<FuncLit> {
        let open = self.expect(TokenType::LParen, "'(' after function name")?;
        let params = self.param_list(TokenType::RParen)?;
        self.expect(TokenType::RParen, "')' after parameters")?;
        if self.match_ty(TokenType::Arrow).is_some() {
            let value = self.expression()?;
            let body = vec![Stmt::new(
                StmtKind::Return(Some(value)),
                open.line,
                open.col,
            )];
            return Ok(FuncLit { params, body, line: open.line, col: open.col });
        }
        let body = self.block()?;
        Ok(FuncLit { params, body, line: open.line, col: open.col })
    }

    /// Comma-separated parameter names up to (not including) `end`.
    fn param_list(&mut self, end: TokenType) -> PResult<Vec<String>> {
        let mut params: Vec<String> = Vec::new();
        if !self.check(end) {
            loop {
                let p = self.expect(TokenType::Ident, "a parameter name")?;
                if params.iter().any(|x| *x == p.lexeme) {
                    return Err(self.error_at(&p, format!("duplicate parameter '{}'", p.lexeme)));
                }
                params.push(p.lexeme.clone());
                if params.len() > MAX_PARAMS {
                    return Err(self.error_at(&p, format!("too many parameters (max is {MAX_PARAMS})")));
                }
                if self.match_ty(TokenType::Comma).is_none() {
                    break;
                }
                if self.check(end) {
                    break; // trailing comma is allowed
                }
            }
        }
        Ok(params)
    }

    fn if_statement(&mut self) -> PResult<Stmt> {
        let kw = self.advance(); // if
        let cond = self.condition("if")?;
        let then = Box::new(self.body_statement("if")?);
        // `else` may sit on its own line: skip the ';' inserted at the
        // previous line end (and any explicit empty statements).
        while self.match_ty(TokenType::Semicolon).is_some() {}
        let els = if self.match_ty(TokenType::Else).is_some() {
            if self.check(TokenType::If) {
                Some(Box::new(self.if_statement()?))
            } else {
                Some(Box::new(self.body_statement("else")?))
            }
        } else {
            None
        };
        Ok(Stmt::new(StmtKind::If { cond, then, els }, kw.line, kw.col))
    }

    fn while_statement(&mut self) -> PResult<Stmt> {
        let kw = self.advance(); // while
        let cond = self.condition("while")?;
        let body = Box::new(self.body_statement("while")?);
        Ok(Stmt::new(StmtKind::While { cond, body }, kw.line, kw.col))
    }

    /// `loop { body }` — an infinite loop (Rust-style `while true`).
    /// A single statement without braces is allowed since 2026.5.6.
    fn loop_statement(&mut self) -> PResult<Stmt> {
        let kw = self.advance(); // loop
        let body = Box::new(self.body_statement("loop")?);
        let cond = Expr::new(ExprKind::Bool(true), kw.line, kw.col);
        Ok(Stmt::new(StmtKind::While { cond, body }, kw.line, kw.col))
    }

    /// The condition of `if`/`while`: any expression, written plain.
    /// Parentheses around the whole condition are a syntax error since
    /// 2026.5.2 (`if x > 5 {`, never `if (x > 5) {`).
    fn condition(&mut self, kw: &str) -> PResult<Expr> {
        if self.peek_ty() == TokenType::LParen {
            // Only flag `(cond) {` — parens that are part of a larger
            // expression (`if (a + b) * c > 0 {`) must keep working.
            if let Some(close) = self.find_matching_paren() {
                let after = self.tokens[(close + 1).min(self.tokens.len() - 1)].ty;
                if matches!(after, TokenType::LBrace | TokenType::Semicolon | TokenType::Eof) {
                    let open = self.peek().clone();
                    return Err(self.error_at(
                        &open,
                        format!(
                            "parentheses around the '{kw}' condition are not allowed (since 2026.5.2) — write it plain: {kw} x > 5 {{ ... }}"
                        ),
                    ));
                }
            }
        }
        self.expression()
    }

    /// The body of `if`/`else`/`while`/`loop`/`for`: a `{ }` block, or a
    /// single statement without braces on the same line (2026.5.6):
    /// `if ok print(x)`.
    fn body_statement(&mut self, kw: &str) -> PResult<Stmt> {
        if self.check(TokenType::LBrace) {
            return self.block_statement();
        }
        if matches!(self.peek_ty(), TokenType::Semicolon | TokenType::Eof) {
            return Err(self.error_here(format!(
                "the '{kw}' body is missing: '{{' opens a block, or put one statement on the same line"
            )));
        }
        self.statement()
    }

    /// Index of the `)` matching the `(` at the cursor, or None when the
    /// parens never close before end of input.
    fn find_matching_paren(&self) -> Option<usize> {
        let mut depth = 0usize;
        let mut i = self.pos;
        loop {
            let t = &self.tokens[i.min(self.tokens.len() - 1)];
            match t.ty {
                TokenType::LParen => depth += 1,
                TokenType::RParen => {
                    depth -= 1;
                    if depth == 0 {
                        return Some(i);
                    }
                }
                TokenType::Eof => return None,
                _ => {}
            }
            i += 1;
        }
    }

    fn for_statement(&mut self) -> PResult<Stmt> {
        let kw = self.advance(); // for

        // Rust-style, no parentheses: `for x in iter { }`,
        // optionally `for let x in iter { }` / `for var x in iter { }`.
        if !self.check(TokenType::LParen) {
            let mutable = if let Some(kw2) = self.match_let_var() {
                kw2.ty == TokenType::Var
            } else {
                false // implicit fresh binding, like Rust's `for x in ...`
            };
            let name = self.expect(TokenType::Ident, "a loop variable name after 'for'")?;
            self.expect(TokenType::In, "'in' after the loop variable")?;
            let iter = self.expression()?;
            let body = Box::new(self.body_statement("for")?);
            return Ok(Stmt::new(
                StmtKind::ForIn {
                    mutable,
                    name: name.lexeme.clone(),
                    iter,
                    body,
                },
                kw.line,
                kw.col,
            ));
        }

        // Parenthesized forms (all of 0.1.x): `for (let x in arr) { }` and
        // the C-style `for (init; cond; step) { }`.
        self.expect(TokenType::LParen, "'(' after 'for'")?;

        // Distinguish `for (let x in arr)` from `for (let i = 0; ...)`.
        let is_for_in = matches!(self.peek_ty(), TokenType::Let | TokenType::Var)
            && self.peek_at(1).ty == TokenType::Ident
            && self.peek_at(2).ty == TokenType::In;

        if is_for_in {
            let decl = self.advance();
            let mutable = decl.ty == TokenType::Var;
            let name = self.expect(TokenType::Ident, "a loop variable name")?;
            self.expect(TokenType::In, "'in' after the loop variable")?;
            let iter = self.expression()?;
            self.expect(TokenType::RParen, "')' after 'for-in' iterable")?;
            if !self.check(TokenType::LBrace) {
                return Err(self.error_here("'{' to open the 'for' body (braces are required)"));
            }
            let body = Box::new(self.block_statement()?);
            return Ok(Stmt::new(
                StmtKind::ForIn {
                    mutable,
                    name: name.lexeme.clone(),
                    iter,
                    body,
                },
                kw.line,
                kw.col,
            ));
        }

        // C-style for: (init; cond; step) — keep the header on one line;
        // the new `for i in a..b { }` form replaces it in most code.
        let init = if self.match_ty(TokenType::Semicolon).is_some() {
            None
        } else {
            let s = if let Some(_kw2) = self.match_let_var() {
                self.declaration_after(_kw2)?
            } else {
                self.expr_or_assign_statement(false)?
            };
            self.expect(TokenType::Semicolon, "';' after the 'for' initializer")?;
            Some(Box::new(s))
        };
        let cond = if self.check(TokenType::Semicolon) {
            None
        } else {
            Some(self.expression()?)
        };
        self.expect(TokenType::Semicolon, "';' after the 'for' condition")?;
        let step = if self.check(TokenType::RParen) {
            None
        } else {
            Some(Box::new(self.expr_or_assign_statement(false)?))
        };
        self.expect(TokenType::RParen, "')' after the 'for' clauses")?;
        if !self.check(TokenType::LBrace) {
            return Err(self.error_here("'{' to open the 'for' body (braces are required)"));
        }
        let body = Box::new(self.block_statement()?);

        Ok(Stmt::new(
            StmtKind::ForC { init, cond, step, body },
            kw.line,
            kw.col,
        ))
    }

    /// Consume a `let`/`var` keyword if present.
    fn match_let_var(&mut self) -> Option<Token> {
        if matches!(self.peek_ty(), TokenType::Let | TokenType::Var) {
            Some(self.advance())
        } else {
            None
        }
    }

    /// `let`/`var` declaration when the keyword was already consumed.
    /// Since 2026.5.5 `var x` (no initializer) declares x as `null`.
    fn declaration_after(&mut self, kw: Token) -> PResult<Stmt> {
        let mutable = kw.ty == TokenType::Var;
        let name = self.expect(TokenType::Ident, "a variable name after 'let'/'var'")?;
        if self.match_ty(TokenType::Assign).is_none() {
            if mutable {
                return Ok(Stmt::new(
                    StmtKind::Let {
                        name: name.lexeme.clone(),
                        mutable,
                        init: Expr::new(ExprKind::Null, kw.line, kw.col),
                    },
                    kw.line,
                    kw.col,
                ));
            }
            return Err(self.error_at(
                &name,
                "an immutable 'let' always needs an initializer — write 'var x' for a null placeholder (since 2026.5.5)",
            ));
        }
        let init = self.expression()?;
        Ok(Stmt::new(
            StmtKind::Let {
                name: name.lexeme.clone(),
                mutable,
                init,
            },
            kw.line,
            kw.col,
        ))
    }

    /// `try { body } catch ... { handler }` — `catch` may sit on its own
    /// line after the body (semicolon insertion never fires before it).
    /// Since 26.0.10.0 a try carries one or more catch clauses, each with an
    /// optional guard: `catch e code "DIV_ZERO" { }` or
    /// `catch e where e.detail.idx < 0 { }`. `code` and `where` are
    /// contextual keywords — they are only special right here.
    fn try_statement(&mut self) -> PResult<Stmt> {
        let kw = self.advance(); // try
        if !self.check(TokenType::LBrace) {
            return Err(self.error_here("'{' to open the 'try' body (braces are required)"));
        }
        let body = Box::new(self.block_statement()?);
        while self.match_ty(TokenType::Semicolon).is_some() {}
        self.expect(TokenType::Catch, "'catch' after the 'try' block")?;

        let mut clauses = Vec::new();
        loop {
            while self.match_ty(TokenType::Semicolon).is_some() {}
            let name = if self.check(TokenType::Ident) && !self.guard_keyword_ahead() {
                Some(self.advance().lexeme.clone())
            } else {
                None
            };
            let guard = self.catch_guard(name.is_some())?;
            if !self.check(TokenType::LBrace) {
                return Err(self.error_here("'{' to open the 'catch' body (braces are required)"));
            }
            let handler = Box::new(self.block_statement()?);
            clauses.push(CatchClause { name, guard, handler });
            // another `catch` clause may follow on the same or the next line
            while self.match_ty(TokenType::Semicolon).is_some() {}
            if !self.check(TokenType::Catch) {
                break;
            }
            self.advance();
        }
        Ok(Stmt::new(StmtKind::Try { body, clauses }, kw.line, kw.col))
    }

    /// True when the upcoming `code`/`where` starts a catch guard rather
    /// than a binding name (`code` only when a string literal follows).
    fn guard_keyword_ahead(&self) -> bool {
        if !self.check(TokenType::Ident) {
            return false;
        }
        let lex = self.peek().lexeme.as_str();
        if lex == "where" {
            return true;
        }
        lex == "code" && self.peek_at(1).ty == TokenType::Str
    }

    /// The optional filter after `catch [name]`: `code "X"` or `where expr`.
    /// `code`/`where` are contextual: `code` only counts when a string
    /// literal follows it.
    fn catch_guard(&mut self, has_name: bool) -> PResult<Option<CatchGuard>> {
        if self.check(TokenType::Ident) && self.peek().lexeme == "code" {
            if self.peek_at(1).ty == TokenType::Str {
                self.advance(); // the contextual `code`
                let s = self.expect(TokenType::Str, "the error code string")?;
                return match s.lit {
                    Some(Lit::Str(code)) => Ok(Some(CatchGuard::Code(code))),
                    _ => Err(self.error_here("internal error: string token without a literal")),
                };
            }
            if has_name {
                return Err(self.error_here(
                    "'code' must be followed by an error-code string literal",
                ));
            }
        }
        if self.check(TokenType::Ident) && self.peek().lexeme == "where" {
            if !has_name {
                return Err(self.error_here(
                    "'catch where' needs a binding: write 'catch e where ...'",
                ));
            }
            self.advance(); // the contextual `where`
            let e = self.expression()?;
            return Ok(Some(CatchGuard::Where(e)));
        }
        Ok(None)
    }

    /// `import "file.rscp"` — bind the module's exports to the file stem,
    /// or to the name after `as`.
    fn import_statement(&mut self) -> PResult<Stmt> {
        let kw = self.advance(); // import
        let path_tok = self.expect(TokenType::Str, "a string path after 'import'")?;
        let path = match &path_tok.lit {
            Some(Lit::Str(s)) => s.clone(),
            _ => unreachable!(),
        };
        let name = if self.match_ty(TokenType::As).is_some() {
            self.expect(TokenType::Ident, "a module name after 'as'")?
                .lexeme
                .clone()
        } else {
            // Default: the file stem without the extension.
            let stem = path.rsplit(['/', '\\']).next().unwrap_or(&path);
            let stem = stem.split('.').next().unwrap_or(stem);
            if stem.is_empty()
                || !stem.chars().next().map_or(false, |c| c.is_ascii_alphabetic() || c == '_')
                || !stem.chars().all(|c| c.is_ascii_alphanumeric() || c == '_')
            {
                return Err(self.error_at(
                    &path_tok,
                    format!(
                        "cannot derive a module name from '{path}' (the file stem must look like an identifier); use 'import \"{path}\" as name'"
                    ),
                ));
            }
            stem.to_string()
        };
        self.end_statement("after 'import'")?;
        Ok(Stmt::new(StmtKind::Import { path, name }, kw.line, kw.col))
    }

    fn throw_statement(&mut self) -> PResult<Stmt> {
        let kw = self.advance(); // throw
        let value = self.expression()?;
        self.end_statement("after 'throw'")?;
        Ok(Stmt::new(StmtKind::Throw(value), kw.line, kw.col))
    }

    fn return_statement(&mut self) -> PResult<Stmt> {
        let kw = self.advance(); // return
        let value = if matches!(self.peek_ty(), TokenType::Semicolon | TokenType::RBrace) {
            None
        } else {
            Some(self.expression()?)
        };
        self.end_statement("after 'return'")?;
        Ok(Stmt::new(StmtKind::Return(value), kw.line, kw.col))
    }

    fn block_statement(&mut self) -> PResult<Stmt> {
        let open = self.peek().clone();
        let stmts = self.block()?;
        Ok(Stmt::new(StmtKind::Block(stmts), open.line, open.col))
    }

    fn block(&mut self) -> PResult<Vec<Stmt>> {
        self.enter()?;
        let r = (|| {
            self.expect(TokenType::LBrace, "'{'")?;
            let mut stmts = Vec::new();
            while !self.check(TokenType::RBrace) {
                if self.at_eof() {
                    return Err(self.error_here("unterminated block: expected '}'"));
                }
                if self.match_ty(TokenType::Semicolon).is_some() {
                    continue; // empty statement
                }
                stmts.push(self.statement()?);
            }
            self.advance(); // }
            Ok(stmts)
        })();
        self.leave();
        r
    }

    /// An expression, an assignment, or an increment/decrement.
    /// `want_semi` controls whether a terminating `;` is consumed.
    fn expr_or_assign_statement(&mut self, want_semi: bool) -> PResult<Stmt> {
        use TokenType::*;
        let expr = self.expression()?;

        if let Some(op_tok) = self.match_assign_op() {
            let target = self.to_target(expr, &op_tok)?;
            let value = self.expression()?;
            let op = match op_tok.ty {
                Assign => AssignOp::Set,
                PlusAssign => AssignOp::AddSet,
                MinusAssign => AssignOp::SubSet,
                StarAssign => AssignOp::MulSet,
                SlashAssign => AssignOp::DivSet,
                PercentAssign => AssignOp::ModSet,
                AmpAssign => AssignOp::BitAndSet,
                PipeAssign => AssignOp::BitOrSet,
                CaretAssign => AssignOp::BitXorSet,
                ShlAssign => AssignOp::ShlSet,
                ShrAssign => AssignOp::ShrSet,
                StarStarAssign => AssignOp::PowSet,
                _ => unreachable!(),
            };
            if want_semi {
                self.end_statement("after assignment")?;
            }
            Ok(Stmt::new(
                StmtKind::Assign { target, op, value },
                op_tok.line,
                op_tok.col,
            ))
        } else if let Some(op_tok) = self
            .match_ty(PlusPlus)
            .or_else(|| self.match_ty(MinusMinus))
        {
            let target = self.to_target(expr, &op_tok)?;
            if want_semi {
                self.end_statement("after '++'/'--'")?;
            }
            Ok(Stmt::new(
                StmtKind::IncDec { target, plus: op_tok.ty == PlusPlus },
                op_tok.line,
                op_tok.col,
            ))
        } else {
            if want_semi {
                self.end_statement("after expression")?;
            }
            let tok = self.peek().clone();
            Ok(Stmt::new(StmtKind::Expr(expr), tok.line, tok.col))
        }
    }

    fn match_assign_op(&mut self) -> Option<Token> {
        use TokenType::*;
        for ty in [
            Assign,
            PlusAssign,
            MinusAssign,
            StarAssign,
            SlashAssign,
            PercentAssign,
            AmpAssign,
            PipeAssign,
            CaretAssign,
            ShlAssign,
            ShrAssign,
            StarStarAssign,
        ] {
            if let Some(t) = self.match_ty(ty) {
                return Some(t);
            }
        }
        None
    }

    fn to_target(&self, expr: Expr, op_tok: &Token) -> PResult<Target> {
        let (eline, ecol) = (expr.line, expr.col);
        match expr.kind {
            ExprKind::Ident(name) => Ok(Target::Ident { name, line: eline, col: ecol }),
            ExprKind::Index { obj, idx } => Ok(Target::Index { obj: *obj, idx: *idx }),
            _ => Err(RscpError::parse(
                format!(
                    "invalid assignment target (the left side of '{}' must be a variable or an index)",
                    op_tok.lexeme
                ),
                eline,
                ecol,
                false,
            )),
        }
    }

    // ---- expressions ---------------------------------------------------------

    fn expression(&mut self) -> PResult<Expr> {
        self.enter()?;
        let r = self.ternary();
        self.leave();
        r
    }

    fn ternary(&mut self) -> PResult<Expr> {
        let cond = self.range_expr()?;
        if let Some(q) = self.match_ty(TokenType::Question) {
            let then = self.expression()?;
            self.expect(TokenType::Colon, "':' in ternary expression")?;
            let els = self.ternary()?; // right-associative
            Ok(Expr::new(
                ExprKind::Ternary {
                    cond: Box::new(cond),
                    then: Box::new(then),
                    els: Box::new(els),
                },
                q.line,
                q.col,
            ))
        } else {
            Ok(cond)
        }
    }

    /// `a..b` (exclusive) or `a..=b` (inclusive). Ranges are only valid as
    /// the iterable of a `for` loop; that rule is enforced by the compiler.
    fn range_expr(&mut self) -> PResult<Expr> {
        let start = self.logic_or()?;
        if matches!(self.peek_ty(), TokenType::DotDot | TokenType::DotDotEq) {
            let tok = self.advance();
            let end = self.logic_or()?;
            return Ok(Expr::new(
                ExprKind::Range {
                    start: Box::new(start),
                    end: Box::new(end),
                    inclusive: tok.ty == TokenType::DotDotEq,
                },
                tok.line,
                tok.col,
            ));
        }
        Ok(start)
    }

    fn logic_or(&mut self) -> PResult<Expr> {
        let mut lhs = self.logic_and()?;
        while matches!(self.peek_ty(), TokenType::OrOr | TokenType::Or) {
            let op = self.advance();
            let rhs = self.logic_and()?;
            lhs = Expr::new(
                ExprKind::Logical {
                    op: LogicalOp::Or,
                    lhs: Box::new(lhs),
                    rhs: Box::new(rhs),
                },
                op.line,
                op.col,
            );
        }
        Ok(lhs)
    }

    fn logic_and(&mut self) -> PResult<Expr> {
        let mut lhs = self.equality()?;
        while matches!(self.peek_ty(), TokenType::AndAnd | TokenType::And) {
            let op = self.advance();
            let rhs = self.equality()?;
            lhs = Expr::new(
                ExprKind::Logical {
                    op: LogicalOp::And,
                    lhs: Box::new(lhs),
                    rhs: Box::new(rhs),
                },
                op.line,
                op.col,
            );
        }
        Ok(lhs)
    }

    /// `a | b` — bitwise or. A single `|` only reaches here in infix
    /// position; in prefix position it opens a short closure. Like Rust,
    /// `&`, `^`, `|` bind tighter than comparisons and looser than shifts.
    fn bit_or(&mut self) -> PResult<Expr> {
        let mut lhs = self.bit_xor()?;
        while let Some(op) = self.match_ty(TokenType::Pipe) {
            let rhs = self.bit_xor()?;
            lhs = Expr::new(
                ExprKind::Binary { op: BinaryOp::BitOr, lhs: Box::new(lhs), rhs: Box::new(rhs) },
                op.line,
                op.col,
            );
        }
        Ok(lhs)
    }

    fn bit_xor(&mut self) -> PResult<Expr> {
        let mut lhs = self.bit_and()?;
        while let Some(op) = self.match_ty(TokenType::Caret) {
            let rhs = self.bit_and()?;
            lhs = Expr::new(
                ExprKind::Binary { op: BinaryOp::BitXor, lhs: Box::new(lhs), rhs: Box::new(rhs) },
                op.line,
                op.col,
            );
        }
        Ok(lhs)
    }

    fn bit_and(&mut self) -> PResult<Expr> {
        let mut lhs = self.shift()?;
        while let Some(op) = self.match_ty(TokenType::Amp) {
            let rhs = self.shift()?;
            lhs = Expr::new(
                ExprKind::Binary { op: BinaryOp::BitAnd, lhs: Box::new(lhs), rhs: Box::new(rhs) },
                op.line,
                op.col,
            );
        }
        Ok(lhs)
    }

    fn equality(&mut self) -> PResult<Expr> {
        let mut lhs = self.comparison()?;
        loop {
            let op = match self.peek_ty() {
                TokenType::EqEq => BinaryOp::Eq,
                TokenType::NotEq => BinaryOp::Ne,
                _ => return Ok(lhs),
            };
            let tok = self.advance();
            let rhs = self.comparison()?;
            lhs = Expr::new(
                ExprKind::Binary { op, lhs: Box::new(lhs), rhs: Box::new(rhs) },
                tok.line,
                tok.col,
            );
        }
    }

    fn comparison(&mut self) -> PResult<Expr> {
        let mut lhs = self.bit_or()?;
        loop {
            let op = match self.peek_ty() {
                TokenType::Lt => BinaryOp::Lt,
                TokenType::Le => BinaryOp::Le,
                TokenType::Gt => BinaryOp::Gt,
                TokenType::Ge => BinaryOp::Ge,
                TokenType::InstanceOf => BinaryOp::InstanceOf,
                _ => return Ok(lhs),
            };
            let tok = self.advance();
            let rhs = self.bit_or()?;
            lhs = Expr::new(
                ExprKind::Binary { op, lhs: Box::new(lhs), rhs: Box::new(rhs) },
                tok.line,
                tok.col,
            );
        }
    }

    fn shift(&mut self) -> PResult<Expr> {
        let mut lhs = self.term()?;
        loop {
            let op = match self.peek_ty() {
                TokenType::Shl => BinaryOp::Shl,
                TokenType::Shr => BinaryOp::Shr,
                _ => return Ok(lhs),
            };
            let tok = self.advance();
            let rhs = self.term()?;
            lhs = Expr::new(
                ExprKind::Binary { op, lhs: Box::new(lhs), rhs: Box::new(rhs) },
                tok.line,
                tok.col,
            );
        }
    }

    fn term(&mut self) -> PResult<Expr> {
        let mut lhs = self.factor()?;
        loop {
            let op = match self.peek_ty() {
                TokenType::Plus => BinaryOp::Add,
                TokenType::Minus => BinaryOp::Sub,
                _ => return Ok(lhs),
            };
            let tok = self.advance();
            let rhs = self.factor()?;
            lhs = Expr::new(
                ExprKind::Binary { op, lhs: Box::new(lhs), rhs: Box::new(rhs) },
                tok.line,
                tok.col,
            );
        }
    }

    fn factor(&mut self) -> PResult<Expr> {
        let mut lhs = self.unary()?;
        loop {
            let op = match self.peek_ty() {
                TokenType::Star => BinaryOp::Mul,
                TokenType::Slash => {
                    // `a /* c */` — block comments were removed in 2026.5.1
                    // and keep their migration hint. `//` is floor division
                    // since 26.0.12.5: the lexer folds it into one token, so
                    // the hint's line-comment branch can no longer fire.
                    if let Some(e) = self.old_comment_hint() {
                        return Err(e);
                    }
                    BinaryOp::Div
                }
                TokenType::SlashSlash => BinaryOp::FloorDiv,
                TokenType::Percent => BinaryOp::Mod,
                _ => return Ok(lhs),
            };
            let tok = self.advance();
            let rhs = self.unary()?;
            lhs = Expr::new(
                ExprKind::Binary { op, lhs: Box::new(lhs), rhs: Box::new(rhs) },
                tok.line,
                tok.col,
            );
        }
    }

    fn unary(&mut self) -> PResult<Expr> {
        let op = match self.peek_ty() {
            TokenType::Not | TokenType::NotWord => Some(UnaryOp::Not),
            TokenType::Minus => Some(UnaryOp::Neg),
            TokenType::Tilde => Some(UnaryOp::BitNot),
            _ => None,
        };
        if let Some(op) = op {
            let tok = self.advance();
            let expr = self.unary()?;
            Ok(Expr::new(
                ExprKind::Unary { op, expr: Box::new(expr) },
                tok.line,
                tok.col,
            ))
        } else {
            self.power()
        }
    }

    /// `a ** b` — exponentiation, right-associative (`2**3**2` is `2**9`)
    /// and binding tighter than unary minus, like Python: `-2**2` is `-4`.
    fn power(&mut self) -> PResult<Expr> {
        let base = self.postfix()?;
        if let Some(op) = self.match_ty(TokenType::StarStar) {
            let rhs = self.unary()?; // allows `-x` and chained `**`
            return Ok(Expr::new(
                ExprKind::Binary { op: BinaryOp::Pow, lhs: Box::new(base), rhs: Box::new(rhs) },
                op.line,
                op.col,
            ));
        }
        Ok(base)
    }

    fn postfix(&mut self) -> PResult<Expr> {
        let mut expr = self.primary()?;
        loop {
            match self.peek_ty() {
                TokenType::LParen => {
                    let tok = self.advance();
                    let mut args = Vec::new();
                    if !self.check(TokenType::RParen) {
                        loop {
                            args.push(self.expression()?);
                            if args.len() > MAX_ARGS {
                                return Err(self.error_here(format!(
                                    "too many arguments in a call (max is {MAX_ARGS})"
                                )));
                            }
                            if self.match_ty(TokenType::Comma).is_none() {
                                break;
                            }
                            if self.check(TokenType::RParen) {
                                break; // trailing comma is allowed
                            }
                        }
                    }
                    self.expect(TokenType::RParen, "')' after arguments")?;
                    expr = Expr::new(
                        ExprKind::Call { callee: Box::new(expr), args },
                        tok.line,
                        tok.col,
                    );
                }
                TokenType::LBracket => {
                    let tok = self.advance();
                    // Python-style slices (2026.5.4): a[start:end[:step]],
                    // any part optional. A lone expression is a plain index;
                    // the ternary's ':' is consumed inside expression().
                    let start = if self.check(TokenType::Colon) || self.check(TokenType::RBracket) {
                        None
                    } else {
                        Some(self.expression()?)
                    };
                    if self.match_ty(TokenType::Colon).is_some() {
                        let end =
                            if self.check(TokenType::Colon) || self.check(TokenType::RBracket) {
                                None
                            } else {
                                Some(self.expression()?)
                            };
                        let step = if self.match_ty(TokenType::Colon).is_some() {
                            if self.check(TokenType::RBracket) {
                                None
                            } else {
                                Some(self.expression()?)
                            }
                        } else {
                            None
                        };
                        self.expect(TokenType::RBracket, "']' after the slice")?;
                        expr = Expr::new(
                            ExprKind::Slice {
                                obj: Box::new(expr),
                                start: start.map(Box::new),
                                end: end.map(Box::new),
                                step: step.map(Box::new),
                            },
                            tok.line,
                            tok.col,
                        );
                    } else {
                        let idx = match start {
                            Some(e) => e,
                            None => {
                                return Err(self.error_here(
                                    "an index or a slice between '[' and ']'",
                                ))
                            }
                        };
                        self.expect(TokenType::RBracket, "']' after index")?;
                        expr = Expr::new(
                            ExprKind::Index { obj: Box::new(expr), idx: Box::new(idx) },
                            tok.line,
                            tok.col,
                        );
                    }
                }
                // `m.key` — sugar for `m["key"]`.
                TokenType::Dot => {
                    let tok = self.advance();
                    let name = self.expect(TokenType::Ident, "a property name after '.'")?;
                    let idx = Expr::new(ExprKind::Str(name.lexeme.clone()), name.line, name.col);
                    expr = Expr::new(
                        ExprKind::Index { obj: Box::new(expr), idx: Box::new(idx) },
                        tok.line,
                        tok.col,
                    );
                }
                _ => return Ok(expr),
            }
        }
    }

    fn primary(&mut self) -> PResult<Expr> {
        use TokenType::*;
        let tok = self.peek().clone();
        let (line, col) = (tok.line, tok.col);
        match tok.ty {
            Int => {
                self.advance();
                let v = match tok.lit {
                    Some(Lit::Int(i)) => i,
                    _ => unreachable!(),
                };
                Ok(Expr::new(ExprKind::Int(v), line, col))
            }
            Float => {
                self.advance();
                let v = match tok.lit {
                    Some(Lit::Float(f)) => f,
                    _ => unreachable!(),
                };
                Ok(Expr::new(ExprKind::Float(v), line, col))
            }
            Str => {
                self.advance();
                let v = match tok.lit {
                    Some(Lit::Str(s)) => s,
                    _ => unreachable!(),
                };
                Ok(Expr::new(ExprKind::Str(v), line, col))
            }
            Bytes => {
                // b"..." — an array of UTF-8 byte values (2026.5.3).
                self.advance();
                let bytes = match tok.lit {
                    Some(Lit::Bytes(b)) => b,
                    _ => unreachable!(),
                };
                let items = bytes
                    .into_iter()
                    .map(|b| Expr::new(ExprKind::Int(i64::from(b)), line, col))
                    .collect();
                Ok(Expr::new(ExprKind::Array(items), line, col))
            }
            FStr => {
                self.advance();
                let raw = match tok.lit {
                    Some(Lit::FStr(raw)) => raw,
                    _ => unreachable!(),
                };
                let mut parts = Vec::with_capacity(raw.len());
                for p in raw {
                    parts.push(match p {
                        crate::token::FStrPart::Lit(s) => FStrPart::Lit(s),
                        crate::token::FStrPart::Expr(src, eline, ecol) => {
                            FStrPart::Expr(parse_interp(&src, eline, ecol)?)
                        }
                    });
                }
                Ok(Expr::new(ExprKind::FStr(parts), line, col))
            }
            True => {
                self.advance();
                Ok(Expr::new(ExprKind::Bool(true), line, col))
            }
            False => {
                self.advance();
                Ok(Expr::new(ExprKind::Bool(false), line, col))
            }
            Null => {
                self.advance();
                Ok(Expr::new(ExprKind::Null, line, col))
            }
            Ident => {
                // `x => expr` — a one-parameter arrow closure (2026.5.6).
                // Not inside a match guard: there `=>` ends the guard.
                if self.peek_at(1).ty == TokenType::FatArrow && self.no_arrow == 0 {
                    let name = self.advance(); // x
                    self.advance(); // =>
                    let body = self.arrow_body(name.line, name.col)?;
                    return Ok(Expr::new(
                        ExprKind::Func(Box::new(FuncLit {
                            params: vec![name.lexeme.clone()],
                            body,
                            line: name.line,
                            col: name.col,
                        })),
                        name.line,
                        name.col,
                    ));
                }
                self.advance();
                Ok(Expr::new(ExprKind::Ident(tok.lexeme.clone()), line, col))
            }
            LParen => {
                // `(x, y) => expr` — an arrow closure (2026.5.6). Told apart
                // from a parenthesized expression by the '=>' after the
                // matching ')' (not inside a match guard).
                if self.no_arrow == 0 {
                    if let Some(close) = self.find_matching_paren() {
                        if self.tokens[(close + 1).min(self.tokens.len() - 1)].ty
                            == TokenType::FatArrow
                        {
                            return self.arrow_closure();
                        }
                    }
                }
                self.advance();
                let e = self.expression()?;
                self.expect(RParen, "')' after parenthesized expression")?;
                Ok(e)
            }
            LBracket => {
                self.advance();
                let mut items = Vec::new();
                if !self.check(RBracket) {
                    loop {
                        items.push(self.expression()?);
                        if self.match_ty(Comma).is_none() {
                            break;
                        }
                        if self.check(RBracket) {
                            break; // trailing comma is allowed
                        }
                    }
                }
                self.expect(RBracket, "']' after array literal")?;
                Ok(Expr::new(ExprKind::Array(items), line, col))
            }
            LBrace => {
                self.advance();
                let mut pairs = Vec::new();
                if !self.check(RBrace) {
                    loop {
                        let key = self.expression()?;
                        self.expect(Colon, "':' after map key")?;
                        let value = self.expression()?;
                        pairs.push((key, value));
                        if self.match_ty(Comma).is_none() {
                            break;
                        }
                        if self.check(RBrace) {
                            break; // trailing comma is allowed
                        }
                    }
                }
                self.expect(RBrace, "'}' after map literal")?;
                Ok(Expr::new(ExprKind::Map(pairs), line, col))
            }
            Fn => {
                self.advance();
                let func = self.func_body()?;
                Ok(Expr::new(ExprKind::Func(Box::new(func)), line, col))
            }
            // `self` is an ordinary local: the compiler injects it as
            // parameter 0 of every method.
            SelfKw => {
                self.advance();
                Ok(Expr::new(ExprKind::Ident("self".to_string()), line, col))
            }
            // Only `super.name(...)` calls exist; the compiler special-cases
            // them where the call is built.
            Super => {
                self.advance();
                self.expect(TokenType::Dot, "'.' after 'super'")?;
                let name = self.expect(TokenType::Ident, "a method name after 'super.'")?;
                Ok(Expr::new(ExprKind::Super(name.lexeme.clone()), line, col))
            }
            // Short closures: `|x| expr`, `|x, y| expr`, `|x| { ... }`, `|| expr`.
            Pipe => self.short_closure(),
            OrOr => self.short_closure(),
            // `match value { arms }` — an expression.
            Match => {
                self.advance();
                self.match_expression()
            }
            _ => {
                if let Some(e) = self.old_comment_hint() {
                    return Err(e);
                }
                Err(self.error_here(format!(
                    "unexpected {} in an expression",
                    tok.ty.describe()
                )))
            }
        }
    }

    /// `match value { pattern (| pattern)* [if cond] => body, ... }`.
    /// The `{` must stay on the same line as the matched value.
    fn match_expression(&mut self) -> PResult<Expr> {
        let value = self.expression()?;
        if !self.check(TokenType::LBrace) {
            return Err(self.error_here(
                "'{' to open the match body (braces are required, and the '{' belongs on the same line as the value)",
            ));
        }
        self.advance(); // {
        let mut arms: Vec<MatchArm> = Vec::new();
        loop {
            if self.check(TokenType::RBrace) {
                break; // trailing comma before the closing brace
            }
            if self.at_eof() {
                return Err(self.error_here("unterminated match: expected '}'"));
            }
            // pattern (| pattern)*
            let mut patterns = vec![self.pattern()?];
            while self.match_ty(TokenType::Pipe).is_some() {
                patterns.push(self.pattern()?);
            }
            if patterns.len() > 1 {
                for p in &patterns {
                    if matches!(p, Pattern::Binding(_) | Pattern::Wildcard) {
                        return Err(self.error_here(
                            "a binding or catch-all pattern cannot be combined with '|'",
                        ));
                    }
                }
            }
            let guard = if self.match_ty(TokenType::If).is_some() {
                // `=>` terminates the guard: parse it without arrow
                // closures (`k if done => 1` guards on `done`, it is not
                // the closure `done => 1`).
                self.no_arrow += 1;
                let g = self.expression();
                self.no_arrow -= 1;
                Some(g?)
            } else {
                None
            };
            self.expect(TokenType::FatArrow, "'=>' after the match pattern")?;
            let body = if self.check(TokenType::LBrace) {
                MatchBody::Block(self.block()?)
            } else {
                MatchBody::Expr(self.expression()?)
            };
            arms.push(MatchArm { patterns, guard, body });
            // Arms are separated by a comma, or simply by a newline
            // (Rust-style): a block-bodied arm ends with '}', so semicolon
            // insertion may add a ';' before the next arm — skip those.
            while self.match_ty(TokenType::Semicolon).is_some() {}
            if self.match_ty(TokenType::Comma).is_none() && self.check(TokenType::RBrace) {
                break;
            }
        }
        self.expect(TokenType::RBrace, "'}' after the match arms")?;
        if arms.is_empty() {
            return Err(self.error_here("a match needs at least one arm"));
        }
        // A catch-all or unguarded binding in a non-last arm would make every
        // later arm unreachable (Rust-style rule; with a guard it is fine).
        for arm in &arms[..arms.len() - 1] {
            let catches_all =
                arm.patterns.iter().any(|p| matches!(p, Pattern::Binding(_) | Pattern::Wildcard));
            if catches_all && arm.guard.is_none() {
                return Err(self.error_here(
                    "a binding or catch-all pattern is only allowed in the last arm of the match (add an 'if' guard or move it last)",
                ));
            }
        }
        let tok = self.peek().clone();
        Ok(Expr::new(
            ExprKind::Match { value: Box::new(value), arms },
            tok.line,
            tok.col,
        ))
    }

    /// One match pattern: a literal, a range, a binding or a catch-all.
    /// One element of an enum-variant pattern's payload (26.0.12.0):
    /// a literal, a binding name, or `_`.
    fn variant_field(&mut self) -> PResult<VariantField> {
        use TokenType::*;
        match self.peek_ty() {
            Int | Float | Str | True | False | Null => {
                Ok(VariantField::Lit(self.pattern()?))
            }
            Ident if self.peek().lexeme == "_" => {
                self.advance();
                Ok(VariantField::Wild)
            }
            Ident => {
                let b = self.advance();
                Ok(VariantField::Bind(b.lexeme.clone()))
            }
            other => Err(self.error_here(format!(
                "expected a literal, a binding or '_' in the variant pattern, found {}",
                other.describe()
            ))),
        }
    }

    fn pattern(&mut self) -> PResult<Pattern> {
        use TokenType::*;
        let tok = self.peek().clone();
        match tok.ty {
            Int => {
                self.advance();
                let lo = match tok.lit {
                    Some(Lit::Int(i)) => i,
                    _ => unreachable!(),
                };
                if matches!(self.peek_ty(), DotDot | DotDotEq) {
                    let range_tok = self.advance();
                    let end = self.expect(Int, "an integer as the range end")?;
                    let hi = match end.lit {
                        Some(Lit::Int(i)) => i,
                        _ => unreachable!(),
                    };
                    return Ok(Pattern::Range {
                        lo,
                        hi,
                        inclusive: range_tok.ty == DotDotEq,
                    });
                }
                Ok(Pattern::Int(lo))
            }
            Float => {
                self.advance();
                match tok.lit {
                    Some(Lit::Float(f)) => Ok(Pattern::Float(f)),
                    _ => unreachable!(),
                }
            }
            Str => {
                self.advance();
                match tok.lit {
                    Some(Lit::Str(s)) => Ok(Pattern::Str(s)),
                    _ => unreachable!(),
                }
            }
            True => {
                self.advance();
                Ok(Pattern::Bool(true))
            }
            False => {
                self.advance();
                Ok(Pattern::Bool(false))
            }
            Null => {
                self.advance();
                Ok(Pattern::Null)
            }
            Else => {
                self.advance();
                Ok(Pattern::Wildcard)
            }
            Ident => {
                self.advance();
                if tok.lexeme == "_" {
                    return Ok(Pattern::Wildcard);
                }
                // `Shape.Circle` / `Shape.Rect(w, h)` — an enum-variant
                // pattern (26.0.11.0).
                if self.check(TokenType::Dot) {
                    self.advance(); // .
                    let v = self.expect(TokenType::Ident, "a variant name after '.'")?;
                    let mut fields = Vec::new();
                    if self.match_ty(TokenType::LParen).is_some() {
                        loop {
                            if self.check(TokenType::RParen) {
                                break;
                            }
                            fields.push(self.variant_field()?);
                            if self.match_ty(TokenType::Comma).is_some() {
                                continue;
                            }
                            break;
                        }
                        self.expect(TokenType::RParen, "')' after the variant fields")?;
                    }
                    return Ok(Pattern::EnumVariant {
                        enum_name: tok.lexeme.clone(),
                        variant: v.lexeme.clone(),
                        fields,
                    });
                }
                Ok(Pattern::Binding(tok.lexeme.clone()))
            }
            _ => Err(self.error_here(format!(
                "expected a match pattern (a literal, a range, a name, '_' or 'else'), found {}",
                tok.ty.describe()
            ))),
        }
    }

    /// `(x, y) => expr` — an arrow closure (2026.5.6), the `(` already
    /// spotted at the cursor.
    fn arrow_closure(&mut self) -> PResult<Expr> {
        let open = self.advance(); // (
        let params = self.param_list(TokenType::RParen)?;
        self.expect(TokenType::RParen, "')' after closure parameters")?;
        self.expect(TokenType::FatArrow, "'=>' after closure parameters")?;
        let body = self.arrow_body(open.line, open.col)?;
        Ok(Expr::new(
            ExprKind::Func(Box::new(FuncLit { params, body, line: open.line, col: open.col })),
            open.line,
            open.col,
        ))
    }

    /// The body after `=>`: an expression (implicit return) or a block.
    fn arrow_body(&mut self, line: usize, col: usize) -> PResult<Vec<Stmt>> {
        if self.check(TokenType::LBrace) {
            self.block()
        } else {
            let value = self.expression()?;
            Ok(vec![Stmt::new(StmtKind::Return(Some(value)), line, col)])
        }
    }

    /// Rust-style short closure. An expression body returns its value
    /// implicitly; a block body needs an explicit `return` (RSCP blocks are
    /// not expressions).
    fn short_closure(&mut self) -> PResult<Expr> {
        let open = self.peek().clone();
        let mut params: Vec<String> = Vec::new();
        if open.ty == TokenType::Pipe {
            self.advance(); // opening '|'
            params = self.param_list(TokenType::Pipe)?;
            self.expect(TokenType::Pipe, "'|' after the closure parameters")?;
        } else {
            self.advance(); // '||' — a closure with no parameters
        }
        let body = if self.check(TokenType::LBrace) {
            self.block()?
        } else {
            let value = self.expression()?;
            vec![Stmt::new(StmtKind::Return(Some(value)), open.line, open.col)]
        };
        Ok(Expr::new(
            ExprKind::Func(Box::new(FuncLit {
                params,
                body,
                line: open.line,
                col: open.col,
            })),
            open.line,
            open.col,
        ))
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::lexer::Lexer;

    fn parse(src: &str) -> Vec<Stmt> {
        let tokens = Lexer::new(src).tokenize().unwrap();
        Parser::new(tokens).parse().unwrap()
    }

    fn parse_err(src: &str) -> RscpError {
        let tokens = Lexer::new(src).tokenize().unwrap();
        Parser::new(tokens).parse().unwrap_err()
    }

    #[test]
    fn precedence() {
        let stmts = parse("1 + 2 * 3 == 7;");
        match &stmts[0].kind {
            StmtKind::Expr(e) => match &e.kind {
                ExprKind::Binary { op: BinaryOp::Eq, lhs, rhs } => {
                    assert!(matches!(lhs.kind, ExprKind::Binary { op: BinaryOp::Add, .. }));
                    assert!(matches!(rhs.kind, ExprKind::Int(7)));
                }
                other => panic!("bad shape: {other:?}"),
            },
            other => panic!("bad stmt: {other:?}"),
        }
    }

    #[test]
    fn statements_shapes() {
        let stmts = parse("let a = 1; var b = a; b += 2; b++; fn f(x) { return x; }");
        assert!(matches!(stmts[0].kind, StmtKind::Let { mutable: false, .. }));
        assert!(matches!(stmts[1].kind, StmtKind::Let { mutable: true, .. }));
        assert!(matches!(stmts[2].kind, StmtKind::Assign { .. }));
        assert!(matches!(stmts[3].kind, StmtKind::IncDec { plus: true, .. }));
        assert!(matches!(stmts[4].kind, StmtKind::Fn { .. }));
    }

    #[test]
    fn control_flow_shapes() {
        let stmts = parse(
            "if a { } else if b { } else { }\
             while x < 3 { x++; }\
             for (let i = 0; i < 3; i++) { }\
             for (let v in arr) { }",
        );
        assert!(matches!(stmts[0].kind, StmtKind::If { els: Some(_), .. }));
        assert!(matches!(stmts[1].kind, StmtKind::While { .. }));
        assert!(matches!(stmts[2].kind, StmtKind::ForC { .. }));
        assert!(matches!(stmts[3].kind, StmtKind::ForIn { .. }));
    }

    #[test]
    fn light_syntax_shapes() {
        // The 2026.2.0.0 light style: no semicolons, no parentheses around
        // conditions, ranges, loop, short closures, arrow functions.
        let src = "\
var total = 0
for i in 0..10 {
    if i % 2 == 0 { continue }
    total += i
}
while total > 5 { total -= 5 }
loop {
    break
}
let double = |x| x * 2
fn square(x) -> x * x
for v in [1, 2, 3] { total += v }
";
        let stmts = parse(src);
        assert!(matches!(stmts[0].kind, StmtKind::Let { mutable: true, .. }));
        assert!(matches!(&stmts[1].kind, StmtKind::ForIn { name, .. } if name == "i"));
        assert!(matches!(stmts[2].kind, StmtKind::While { .. }));
        assert!(matches!(stmts[3].kind, StmtKind::While { .. })); // loop {}
        assert!(matches!(&stmts[4].kind, StmtKind::Let { init, .. }
            if matches!(&init.kind, ExprKind::Func(_))));
        assert!(matches!(stmts[5].kind, StmtKind::Fn { .. }));
        assert!(matches!(&stmts[6].kind, StmtKind::ForIn { .. }));
    }

    #[test]
    fn range_shapes() {
        let stmts = parse("for i in 0..n { } for i in 0..=n { } for i in 1..n-1 { }");
        match &stmts[0].kind {
            StmtKind::ForIn { iter, .. } => match &iter.kind {
                ExprKind::Range { inclusive, end, .. } => {
                    assert!(!*inclusive);
                    assert!(matches!(end.kind, ExprKind::Ident(_))); // not n-1
                }
                other => panic!("bad range: {other:?}"),
            },
            other => panic!("bad stmt: {other:?}"),
        }
        match &stmts[2].kind {
            StmtKind::ForIn { iter, .. } => match &iter.kind {
                ExprKind::Range { end, .. } => {
                    // `n-1` binds to the range end, not to the whole loop
                    assert!(matches!(&end.kind, ExprKind::Binary { op: BinaryOp::Sub, .. }));
                }
                other => panic!("bad range: {other:?}"),
            },
            other => panic!("bad stmt: {other:?}"),
        }
    }

    #[test]
    fn else_on_own_line() {
        let stmts = parse("if a {\n    break\n}\nelse {\n    continue\n}");
        match &stmts[0].kind {
            StmtKind::If { els: Some(_), .. } => {}
            other => panic!("bad stmt: {other:?}"),
        }
    }

    #[test]
    fn empty_statements() {
        let stmts = parse(";;let a = 1;;let b = 2;;");
        assert_eq!(stmts.len(), 2);
        let stmts = parse("var x = 1\n;\nvar y = 2\n"); // inserted + explicit
        assert_eq!(stmts.len(), 2);
    }

    #[test]
    fn arrow_and_block_bodies() {
        let stmts = parse("fn a(x) -> x + 1\nfn b(x) { return x + 1 }\nlet c = fn(x) -> x * 2");
        match &stmts[0].kind {
            StmtKind::Fn { func, .. } => {
                assert_eq!(func.params, vec!["x"]);
                assert_eq!(func.body.len(), 1);
                assert!(matches!(func.body[0].kind, StmtKind::Return(Some(_))));
            }
            other => panic!("bad stmt: {other:?}"),
        }
        match &stmts[2].kind {
            StmtKind::Let { init, .. } => assert!(matches!(&init.kind, ExprKind::Func(_))),
            other => panic!("bad stmt: {other:?}"),
        }
    }

    #[test]
    fn short_closures() {
        let stmts = parse("let f = |x| x + 1\nlet g = |a, b| a * b\nlet h = || 42\nlet k = |x| { return x }");
        for i in 0..4 {
            match &stmts[i].kind {
                StmtKind::Let { init, .. } => assert!(matches!(&init.kind, ExprKind::Func(_)), "stmt {i}"),
                other => panic!("bad stmt {i}: {other:?}"),
            }
        }
        match &stmts[0].kind {
            StmtKind::Let { init, .. } => match &init.kind {
                ExprKind::Func(f) => {
                    assert_eq!(f.params, vec!["x"]);
                    assert!(matches!(f.body[0].kind, StmtKind::Return(Some(_))));
                }
                _ => unreachable!(),
            },
            _ => unreachable!(),
        }
        match &stmts[1].kind {
            StmtKind::Let { init, .. } => match &init.kind {
                ExprKind::Func(f) => assert_eq!(f.params, vec!["a", "b"]),
                _ => unreachable!(),
            },
            _ => unreachable!(),
        }
    }

    #[test]
    fn multiline_expressions_without_semis() {
        let src = "\
var a = [
    1,
    2,
]
var m = {
    \"k\": 1,
}
var s = 1 +
    2
fn f(
    x,
    y,
) -> x + y
";
        let stmts = parse(src);
        assert_eq!(stmts.len(), 4);
        assert!(matches!(&stmts[0].kind, StmtKind::Let { init, .. } if matches!(init.kind, ExprKind::Array(_))));
        assert!(matches!(&stmts[1].kind, StmtKind::Let { init, .. } if matches!(init.kind, ExprKind::Map(_))));
        assert!(matches!(&stmts[2].kind, StmtKind::Let { init, .. } if matches!(init.kind, ExprKind::Binary { .. })));
        assert!(matches!(stmts[3].kind, StmtKind::Fn { .. }));
    }

    #[test]
    fn ternary_right_assoc() {
        let stmts = parse("let x = a ? 1 : b ? 2 : 3;");
        match &stmts[0].kind {
            StmtKind::Let { init, .. } => {
                assert!(matches!(init.kind, ExprKind::Ternary { .. }));
                match &init.kind {
                    ExprKind::Ternary { els, .. } => {
                        assert!(matches!(els.kind, ExprKind::Ternary { .. }));
                    }
                    _ => unreachable!(),
                }
            }
            _ => panic!("bad stmt"),
        }
    }

    #[test]
    fn bitwise_precedence_and_ops() {
        // `&` binds tighter than `==`; `|` looser than `&`; `&&` looser
        // than `|`; `<<` tighter than comparison, looser than `+`.
        let stmts = parse(
            "let a = 1 & 2 == 4\nlet b = 1 | 2 & 3\nlet c = 1 << 2 + 3\nlet d = 1 | 2 == 3 && true\nlet e = ~5 & 0xFF",
        );
        let init = |i: usize| match &stmts[i].kind {
            StmtKind::Let { init, .. } => init.kind.clone(),
            other => panic!("bad stmt: {other:?}"),
        };
        assert!(matches!(init(0), ExprKind::Binary { op: BinaryOp::Eq, ref lhs, .. }
            if matches!(lhs.kind, ExprKind::Binary { op: BinaryOp::BitAnd, .. })));
        assert!(matches!(init(1), ExprKind::Binary { op: BinaryOp::BitOr, ref rhs, .. }
            if matches!(rhs.kind, ExprKind::Binary { op: BinaryOp::BitAnd, .. })));
        assert!(matches!(init(2), ExprKind::Binary { op: BinaryOp::Shl, ref rhs, .. }
            if matches!(rhs.kind, ExprKind::Binary { op: BinaryOp::Add, .. })));
        assert!(matches!(init(3), ExprKind::Logical { op: LogicalOp::And, ref lhs, .. }
            if matches!(lhs.kind, ExprKind::Binary { op: BinaryOp::Eq, lhs: ref l2, .. }
                if matches!(l2.kind, ExprKind::Binary { op: BinaryOp::BitOr, .. }))));
        assert!(matches!(init(4), ExprKind::Binary { op: BinaryOp::BitAnd, ref lhs, .. }
            if matches!(lhs.kind, ExprKind::Unary { op: UnaryOp::BitNot, .. })));
        // Compound bitwise assignment parses.
        let stmts = parse("var x = 1\nx &= 3\nx |= 8\nx ^= 1\nx <<= 2\nx >>= 1");
        for i in 1..6 {
            assert!(matches!(&stmts[i].kind, StmtKind::Assign { .. }), "stmt {i}");
        }
    }

    #[test]
    fn match_shapes() {
        let stmts = parse(
            "let x = match n { 0 => \"zero\", 1 | 2 => \"few\", k if k < 0 => \"neg\", 3..=9 => \"digit\", else => \"other\" }",
        );
        match &stmts[0].kind {
            StmtKind::Let { init, .. } => match &init.kind {
                ExprKind::Match { arms, .. } => {
                    assert_eq!(arms.len(), 5);
                    assert!(matches!(&arms[0].patterns[0], Pattern::Int(0)));
                    assert_eq!(arms[1].patterns.len(), 2);
                    assert!(matches!(&arms[1].patterns[1], Pattern::Int(2)));
                    assert!(arms[2].guard.is_some());
                    assert!(matches!(&arms[2].patterns[0], Pattern::Binding(k) if k == "k"));
                    assert!(matches!(
                        &arms[3].patterns[0],
                        Pattern::Range { lo: 3, hi: 9, inclusive: true }
                    ));
                    assert!(matches!(&arms[4].patterns[0], Pattern::Wildcard));
                    assert!(matches!(&arms[0].body, MatchBody::Expr(_)));
                }
                other => panic!("bad expr: {other:?}"),
            },
            other => panic!("bad stmt: {other:?}"),
        }
        // Exclusive range, `_` catch-all, block body, match as a statement.
        let stmts = parse("match x { 0..9 => \"low\", _ => { let y = 1\n y * 2 } }");
        match &stmts[0].kind {
            StmtKind::Expr(e) => match &e.kind {
                ExprKind::Match { arms, .. } => {
                    assert!(matches!(
                        &arms[0].patterns[0],
                        Pattern::Range { lo: 0, hi: 9, inclusive: false }
                    ));
                    assert!(matches!(&arms[1].body, MatchBody::Block(_)));
                }
                other => panic!("bad expr: {other:?}"),
            },
            other => panic!("bad stmt: {other:?}"),
        }
        // A binding with a guard is legal in a non-last arm.
        assert_eq!(parse("match x { n if n < 0 => 1, _ => 2 }").len(), 1);
    }

    #[test]
    fn match_errors() {
        // Catch-all not last -> unreachable arms.
        assert!(matches!(parse_err("match x { _ => 1, 2 => 2 }"), RscpError::Parse { .. }));
        // Binding without a guard not last.
        assert!(matches!(parse_err("match x { n => 1, 2 => 2 }"), RscpError::Parse { .. }));
        // A binding cannot be combined with '|'.
        assert!(matches!(parse_err("match x { 1 | n => 1, _ => 2 }"), RscpError::Parse { .. }));
        // Missing '=>' or arms.
        assert!(matches!(parse_err("match x { 1 : 2 }"), RscpError::Parse { .. }));
        assert!(matches!(parse_err("match x { }"), RscpError::Parse { .. }));
        // A bad pattern.
        assert!(matches!(parse_err("match x { (1) => 2 }"), RscpError::Parse { .. }));
    }

    #[test]
    fn try_catch_shapes() {
        let stmts = parse("try { risky() } catch e { println(e) }");
        assert!(matches!(&stmts[0].kind,
            StmtKind::Try { clauses, .. }
            if clauses.len() == 1
                && clauses[0].name.as_deref() == Some("e")
                && clauses[0].guard.is_none()));
        // Unnamed catch; `catch` on its own line; `throw` with an expression.
        let stmts = parse("try {\n    a()\n}\ncatch { b() }\nthrow \"boom\"");
        assert!(matches!(&stmts[0].kind,
            StmtKind::Try { clauses, .. }
            if clauses.len() == 1 && clauses[0].name.is_none()));
        assert!(matches!(&stmts[1].kind, StmtKind::Throw(_)));
        // Guards and multiple clauses (26.0.10.0).
        let stmts = parse(
            "try { risky() } catch e code \"DIV_ZERO\" { a() } catch e where e.code == \"X\" { b() } catch { c() }",
        );
        assert!(matches!(&stmts[0].kind,
            StmtKind::Try { clauses, .. }
            if clauses.len() == 3
                && matches!(&clauses[0].guard, Some(CatchGuard::Code(c)) if c == "DIV_ZERO")
                && matches!(&clauses[1].guard, Some(CatchGuard::Where(_)))
                && clauses[2].guard.is_none()
                && clauses[2].name.is_none()));
        // try inside functions and loops parses.
        let stmts = parse("fn f() { try { return 1 } catch { return 2 } }\nfor i in 0..3 { try { continue } catch e { } }");
        assert_eq!(stmts.len(), 2);
        // A try without a catch block is a syntax error.
        assert!(matches!(parse_err("try { 1 }"), RscpError::Parse { .. }));
        assert!(matches!(parse_err("try { 1 } println(2)"), RscpError::Parse { .. }));
        // `throw` needs an expression.
        assert!(matches!(parse_err("throw"), RscpError::Parse { .. }));
    }

    #[test]
    fn literals_and_calls() {
        let stmts = parse("let a = [1, 2]; let m = {\"k\": 1}; let f = fn(x) { return x; }; f(m[\"k\"], a[0]);");
        assert!(matches!(&stmts[0].kind, StmtKind::Let { init, .. } if matches!(init.kind, ExprKind::Array(_))));
        assert!(matches!(&stmts[1].kind, StmtKind::Let { init, .. } if matches!(init.kind, ExprKind::Map(_))));
        assert!(matches!(&stmts[2].kind, StmtKind::Let { init, .. } if matches!(init.kind, ExprKind::Func(_))));
        assert!(matches!(&stmts[3].kind, StmtKind::Expr(e) if matches!(e.kind, ExprKind::Call { .. })));
    }

    #[test]
    fn syntax_errors() {
        // Since 2026.2.0.0 a statement may end without ';' — this parses fine.
        assert_eq!(parse("let x = 1").len(), 1);
        // A range parses anywhere; the compiler rejects non-`for` uses.
        assert_eq!(parse("var a = 1..3;").len(), 1);
        // An expression that is still open at EOF asks for more input (REPL).
        assert!(parse_err("let x = 1 +").is_at_eof());
        assert!(!parse_err("let x = 1 let y = 2;").is_at_eof());
        assert!(matches!(parse_err("let x = ;"), RscpError::Parse { .. }));
        assert!(matches!(parse_err("1 + 2 = 3;"), RscpError::Parse { .. })); // invalid target
        assert!(matches!(parse_err("let x;"), RscpError::Parse { .. })); // needs initializer
        assert!(matches!(parse_err("fn f(a, a) {}"), RscpError::Parse { .. })); // dup params
        assert!(matches!(parse_err("if x"), RscpError::Parse { .. })); // body missing
        assert_eq!(parse("if x 1").len(), 1); // single-statement body (2026.5.6)
        assert!(matches!(parse_err("if x { } 1 { }"), RscpError::Parse { .. })); // '{' after condition only
        assert!(matches!(parse_err("for i in 0.. { }"), RscpError::Parse { .. })); // missing range end
        // `//` is floor division since 26.0.12.5 (the pre-2026.5.1
        // comment migration hint is gone with it).
        assert_eq!(parse("let a = 1 // 2").len(), 1);
        let e = parse_err("1 /* block */ 2");
        assert!(matches!(&e, RscpError::Parse { msg, .. } if msg.contains("block comments")));
        // Parenthesized conditions are rejected since 2026.5.2...
        let e = parse_err("if (x < 5) { x++ }");
        assert!(matches!(&e, RscpError::Parse { msg, .. } if msg.contains("parentheses around the 'if' condition")));
        assert!(matches!(parse_err("while (true) { }"), RscpError::Parse { .. }));
        // ...but parens that are part of the expression still parse.
        assert_eq!(parse("if (a + b) * c > 0 { }").len(), 1);
    }

    #[test]
    fn word_logic_operators() {
        // 'and'/'or'/'not' are word forms of && / || / ! (2026.5.2).
        let stmts = parse("let x = a and b or not c\nlet y = a && b || !c");
        for i in 0..2 {
            match &stmts[i].kind {
                StmtKind::Let { init, .. } => assert!(
                    matches!(&init.kind, ExprKind::Logical { op: LogicalOp::Or, ref lhs, .. }
                        if matches!(lhs.kind, ExprKind::Logical { op: LogicalOp::And, .. })),
                    "stmt {i}"
                ),
                other => panic!("bad stmt {i}: {other:?}"),
            }
        }
        let stmts = parse("if not done { break }");
        assert!(matches!(&stmts[0].kind, StmtKind::If { cond, .. }
            if matches!(cond.kind, ExprKind::Unary { op: UnaryOp::Not, .. })));
    }

    #[test]
    fn class_shapes() {
        let stmts = parse(
            "class Animal {\n    fn init(name) { self.name = name }\n    fn speak() -> \"...\"\n}\nclass Dog(Animal) { fn speak() -> \"Woof\" }",
        );
        match &stmts[0].kind {
            StmtKind::Class { name, parent, methods } => {
                assert_eq!(name, "Animal");
                assert!(parent.is_none());
                assert_eq!(methods.len(), 2);
                assert_eq!(methods[0].0, "init");
                assert_eq!(methods[0].1.params, vec!["name"]); // no self listed
            }
            other => panic!("bad stmt: {other:?}"),
        }
        match &stmts[1].kind {
            StmtKind::Class { parent, .. } => assert_eq!(parent.as_deref(), Some("Animal")),
            other => panic!("bad stmt: {other:?}"),
        }
        // instanceof parses at comparison level, under and/or/not.
        let stmts = parse("let ok = d instanceof Dog and x < 3");
        assert!(matches!(&stmts[0].kind, StmtKind::Let { init, .. }
            if matches!(init.kind, ExprKind::Logical { op: LogicalOp::And, .. })));
        // A class body without methods is an error, as is a stray super.
        assert!(matches!(parse_err("class X { let y = 1 }"), RscpError::Parse { .. }));
        assert!(matches!(parse_err("super"), RscpError::Parse { .. }));
    }

    #[test]
    fn var_without_initializer() {
        // `var x` declares null (2026.5.5); `let x` still needs a value.
        let stmts = parse("var x\nx = 1");
        assert!(matches!(&stmts[0].kind, StmtKind::Let { mutable: true, init, .. }
            if matches!(init.kind, ExprKind::Null)));
        assert!(matches!(&stmts[1].kind, StmtKind::Assign { .. }));
        assert!(matches!(parse_err("let x"), RscpError::Parse { .. }));
    }

    #[test]
    fn slice_shapes() {
        // Python-style slices (2026.5.4); a lone expression stays an index.
        let stmts = parse(
            "let a = x[1:3]\nlet b = x[1:]\nlet c = x[:2]\nlet d = x[:]\nlet e = x[::2]\nlet f = x[1:5:2]\nlet g = x[-1]\nlet h = x[k ? 1 : 2]",
        );
        let init = |i: usize| match &stmts[i].kind {
            StmtKind::Let { init, .. } => init.kind.clone(),
            other => panic!("bad stmt: {other:?}"),
        };
        assert!(matches!(init(0), ExprKind::Slice { start: Some(_), end: Some(_), step: None, .. }));
        assert!(matches!(init(1), ExprKind::Slice { start: Some(_), end: None, step: None, .. }));
        assert!(matches!(init(2), ExprKind::Slice { start: None, end: Some(_), step: None, .. }));
        assert!(matches!(init(3), ExprKind::Slice { start: None, end: None, step: None, .. }));
        assert!(matches!(init(4), ExprKind::Slice { start: None, end: None, step: Some(_), .. }));
        assert!(matches!(init(5), ExprKind::Slice { start: Some(_), end: Some(_), step: Some(_), .. }));
        assert!(matches!(init(6), ExprKind::Index { .. }));
        // The ternary's ':' is consumed inside the expression, not a slice.
        assert!(matches!(init(7), ExprKind::Index { idx, .. } if matches!(idx.kind, ExprKind::Ternary { .. })));
    }
}
