//! Runtime values.
//!
//! Ints are `i64`, floats are `f64`, strings are UTF-8 (`Rc<str>`).
//! Arrays and maps are reference types (`Rc<RefCell<...>>`): assignment
//! shares the same object, and `==` compares references for them while
//! numbers/strings/bools/null compare by value.

use std::cell::RefCell;
use std::cmp::Ordering;
use std::collections::HashMap;
use std::rc::Rc;

use crate::bytecode::FnProto;
use crate::fxhash::FxBuild;
use crate::vm::Vm;

/// A runtime failure: a stable machine-readable `code` (see the error-code
/// table in the docs), the human-readable message, and an optional
/// structured `detail` payload (e.g. `{"index": 9, "length": 1}` for an
/// out-of-bounds access). Shared by VM raises, native builtins and `throw`.
pub struct RtError {
    pub code: &'static str,
    pub msg: String,
    pub detail: Value,
}

impl RtError {
    pub fn new(code: &'static str, msg: impl Into<String>) -> Self {
        RtError { code, msg: msg.into(), detail: Value::Null }
    }

    pub fn with_detail(code: &'static str, msg: impl Into<String>, detail: Value) -> Self {
        RtError { code, msg: msg.into(), detail }
    }

    /// Boxed constructors: the hot `Result<Value, Box<RtError>>` stays
    /// small (a pointer), so arith/index helpers keep their register
    /// returns — the allocation only happens on the error path (26.0.10.0).
    pub fn boxed(code: &'static str, msg: impl Into<String>) -> Box<RtError> {
        Box::new(RtError::new(code, msg))
    }

    pub fn boxed_with_detail(
        code: &'static str,
        msg: impl Into<String>,
        detail: Value,
    ) -> Box<RtError> {
        Box::new(RtError::with_detail(code, msg, detail))
    }
}

/// A native (Rust-implemented) function. The arguments arrive as a slice
/// (no per-call Vec allocation since 26.0.9.0); failures carry a code.
pub type NativeFn = fn(&mut Vm, &[Value]) -> Result<Value, Box<RtError>>;

/// User-facing map values: `Rc<str>` keys (inserting a key from a string
/// value moves the existing `Rc`, no allocation), FxHash for speed.
pub type ValueMap = HashMap<Rc<str>, Value, FxBuild>;

/// The error value bound by `catch`: a map
/// `{"__error__": true, "code": ..., "message": ..., "detail": ...}`.
/// `print(e)` renders just the message (Python-style `str(e)`); the
/// structured fields are there for programmatic use (26.0.10.0).
pub fn error_value(code: &str, message: String, detail: Value) -> Value {
    let mut m = ValueMap::with_capacity_and_hasher(4, Default::default());
    m.insert(Rc::from("__error__"), Value::Bool(true));
    m.insert(Rc::from("code"), Value::str(code));
    m.insert(Rc::from("message"), Value::str(message));
    m.insert(Rc::from("detail"), detail);
    Value::Map(Rc::new(RefCell::new(m)))
}

/// True for values produced by `error_value` (used to rethrow as-is).
pub fn is_error_value(v: &Value) -> bool {
    match v {
        Value::Map(m) => matches!(m.borrow().get("__error__"), Some(Value::Bool(true))),
        _ => false,
    }
}

/// Build a small structured detail payload for errors,
/// e.g. `detail(&[("index", Value::Int(9)), ("length", Value::Int(1))])`.
pub fn detail(pairs: &[(&str, Value)]) -> Value {
    let mut m = ValueMap::with_capacity_and_hasher(pairs.len(), Default::default());
    for (k, v) in pairs {
        m.insert(Rc::from(*k), v.clone());
    }
    Value::Map(Rc::new(RefCell::new(m)))
}

/// A compiled function plus its captured upvalues.
pub struct FunctionVal {
    pub proto: Rc<FnProto>,
    pub upvalues: Vec<Rc<RefCell<Upvalue>>>,
    /// Module globals for closures defined inside an imported module: they
    /// resolve names against their module, not against the importer's
    /// globals (26.0.12.2). None for script functions.
    pub globals: Option<Rc<RefCell<crate::vm::GlobalMap>>>,
}

/// A built-in function implemented in Rust.
pub struct NativeVal {
    pub name: &'static str,
    pub func: NativeFn,
}

/// An upvalue cell: either still pointing at a live stack slot, or holding
/// the closed value after the defining scope returned.
pub enum Upvalue {
    Open(usize),
    Closed(Value),
}

/// A runtime value.
#[derive(Clone)]
pub enum Value {
    Null,
    Int(i64),
    Float(f64),
    Bool(bool),
    Str(Rc<str>),
    Array(Rc<RefCell<Vec<Value>>>),
    Map(Rc<RefCell<ValueMap>>),
    Func(Rc<FunctionVal>),
    Native(Rc<NativeVal>),
    /// Compile-time only: a function prototype stored in a constant pool.
    Proto(Rc<FnProto>),
}

impl std::fmt::Debug for Value {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.write_str(&self.display_string(0))
    }
}

impl Value {
    pub fn str(s: impl AsRef<str>) -> Value {
        Value::Str(Rc::from(s.as_ref()))
    }

    /// Type name as reported by `type()` and error messages.
    pub fn type_name(&self) -> &'static str {
        match self {
            Value::Null => "null",
            Value::Int(_) => "int",
            Value::Float(_) => "float",
            Value::Bool(_) => "bool",
            Value::Str(_) => "string",
            Value::Array(_) => "array",
            Value::Map(_) => "map",
            Value::Func(_) | Value::Proto(_) => "function",
            Value::Native(_) => "function",
        }
    }

    /// Human-readable form used by `print`, `println` and `str`.
    /// Strings print unquoted at the top level and quoted inside containers.
    pub fn display_string(&self, depth: usize) -> String {
        if depth > 16 {
            return "…".to_string();
        }
        match self {
            Value::Null => "null".to_string(),
            Value::Int(i) => i.to_string(),
            // Rust's Debug formatting for f64 is the shortest representation
            // that round-trips, and keeps a trailing ".0" for whole floats.
            Value::Float(f) => format!("{f:?}"),
            Value::Bool(b) => b.to_string(),
            Value::Str(s) => s.to_string(),
            Value::Array(items) => {
                let mut parts: Vec<String> = items
                    .borrow()
                    .iter()
                    .map(|v| v.nested_string(depth + 1))
                    .collect();
                // Guard against self-referential containers (`push(a, a)`).
                if parts.len() > 100 {
                    parts.truncate(100);
                    parts.push("…".to_string());
                }
                format!("[{}]", parts.join(", "))
            }
            Value::Map(m) => {
                // Classes and instances print compactly (2026.6.0); error
                // objects print as their message (26.0.10.0), like
                // Python's str(e).
                {
                    let mref = m.borrow();
                    if matches!(mref.get("__error__"), Some(Value::Bool(true))) {
                        return mref
                            .get("message")
                            .map_or(String::new(), |v| match v {
                                Value::Str(s) => s.to_string(),
                                _ => String::new(),
                            });
                    }
                    // Enum variants print as `Shape.Rect(3, 4)` (26.0.11.0).
                    if let Some(Value::Str(ename)) = mref.get("__enum__") {
                        let vname = mref
                            .get("__variant__")
                            .map_or("?".to_string(), |v| match v {
                                Value::Str(s) => s.to_string(),
                                _ => "?".to_string(),
                            });
                        let args = match mref.get("args") {
                            Some(Value::Array(items)) => items
                                .borrow()
                                .iter()
                                .map(|v| v.nested_string(depth + 1))
                                .collect::<Vec<_>>()
                                .join(", "),
                            _ => String::new(),
                        };
                        if args.is_empty() {
                            return format!("{ename}.{vname}");
                        }
                        return format!("{ename}.{vname}({args})");
                    }
                    if let Some(Value::Map(class)) = mref.get("__class__") {
                        let name = class
                            .borrow()
                            .get("__name__")
                            .map_or("?".to_string(), |v| match v {
                                Value::Str(s) => s.to_string(),
                                _ => "?".to_string(),
                            });
                        return format!("<{name} instance>");
                    }
                    if mref
                        .get("__isclass__")
                        .map_or(false, |f| matches!(f, Value::Bool(true)))
                    {
                        let name = mref
                            .get("__name__")
                            .map_or("?".to_string(), |v| match v {
                                Value::Str(s) => s.to_string(),
                                _ => "?".to_string(),
                            });
                        return format!("<class {name}>");
                    }
                }
                let borrowed = m.borrow();
                let mut keys: Vec<&Rc<str>> = borrowed.keys().collect();
                keys.sort();
                let parts: Vec<String> = keys
                    .iter()
                    .map(|k| format!("{:?}: {}", k, borrowed[&***k].nested_string(depth + 1)))
                    .collect();
                format!("{{{}}}", parts.join(", "))
            }
            Value::Func(f) => fn_display_name(&f.proto),
            Value::Proto(p) => fn_display_name(p),
            Value::Native(n) => format!("<native fn {}>", n.name),
        }
    }

    fn nested_string(&self, depth: usize) -> String {
        match self {
            Value::Str(s) => format!("{s:?}"), // quoted + escaped inside containers
            Value::Array(_) | Value::Map(_) => self.display_string(depth),
            _ => self.display_string(depth),
        }
    }

    /// Equality semantics: by value for null/bool/numbers/strings
    /// (ints and floats compare numerically across types), by reference for
    /// arrays, maps and functions.
    pub fn equals(&self, other: &Value) -> bool {
        match (self, other) {
            (Value::Null, Value::Null) => true,
            (Value::Bool(a), Value::Bool(b)) => a == b,
            (Value::Int(a), Value::Int(b)) => a == b,
            (Value::Float(a), Value::Float(b)) => a == b,
            (Value::Int(a), Value::Float(b)) => *a as f64 == *b,
            (Value::Float(a), Value::Int(b)) => *a == *b as f64,
            (Value::Str(a), Value::Str(b)) => a == b,
            (Value::Array(a), Value::Array(b)) => Rc::ptr_eq(a, b),
            // Enum variants compare structurally: same enum, same variant,
            // equal payloads (26.0.11.0). Unit variants from different
            // constructions must still be equal.
            (Value::Map(a), Value::Map(b)) => {
                if Rc::ptr_eq(a, b) {
                    return true;
                }
                let (ar, br) = (a.borrow(), b.borrow());
                let is_enum = |m: &std::cell::Ref<ValueMap>| {
                    m.get("__enum__").map_or(false, |v| matches!(v, Value::Str(_)))
                };
                if is_enum(&ar) && is_enum(&br) {
                    let same = |a: Option<&Value>, b: Option<&Value>| match (a, b) {
                        (Some(x), Some(y)) => x.equals(y),
                        (None, None) => true,
                        _ => false,
                    };
                    let args = |m: &std::cell::Ref<ValueMap>| match m.get("args") {
                        Some(Value::Array(items)) => items.borrow().clone(),
                        _ => Vec::new(),
                    };
                    same(ar.get("__enum__"), br.get("__enum__"))
                        && same(ar.get("__variant__"), br.get("__variant__"))
                        && args(&ar).len() == args(&br).len()
                        && args(&ar).iter().zip(args(&br).iter()).all(|(x, y)| x.equals(y))
                } else {
                    false // plain maps (and classes) stay identity-compared
                }
            }
            (Value::Func(a), Value::Func(b)) => Rc::ptr_eq(a, b),
            (Value::Native(a), Value::Native(b)) => Rc::ptr_eq(a, b),
            _ => false,
        }
    }

    /// Ordering for `<`, `<=`, `>` and `>=`: numbers (int/float mixed) and
    /// strings (lexicographic). `None` means the pair is not comparable.
    pub fn num_cmp(a: &Value, b: &Value) -> Option<Ordering> {
        match (a, b) {
            (Value::Int(x), Value::Int(y)) => x.partial_cmp(y),
            (Value::Int(x), Value::Float(y)) => (*x as f64).partial_cmp(y),
            (Value::Float(x), Value::Int(y)) => x.partial_cmp(&(*y as f64)),
            (Value::Float(x), Value::Float(y)) => x.partial_cmp(y),
            (Value::Str(x), Value::Str(y)) => Some(x.cmp(y)),
            _ => None,
        }
    }
}

/// Display name for a function ("<fn add>", "<script>" is not used here).
fn fn_display_name(p: &FnProto) -> String {
    if p.name.is_empty() {
        "<fn>".to_string()
    } else {
        format!("<fn {}>", p.name)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use std::iter::FromIterator;

    #[test]
    fn float_formatting() {
        assert_eq!(Value::Float(1.0).display_string(0), "1.0");
        assert_eq!(Value::Float(0.5).display_string(0), "0.5");
        assert_eq!(Value::Float(0.1).display_string(0), "0.1");
        assert_eq!(Value::Float(1e300).display_string(0), "1e300");
    }

    #[test]
    fn container_formatting() {
        let a = Value::Array(Rc::new(RefCell::new(vec![
            Value::Int(1),
            Value::str("two"),
            Value::Float(3.0),
        ])));
        assert_eq!(a.display_string(0), "[1, \"two\", 3.0]");
        let m = Value::Map(Rc::new(RefCell::new(
            ValueMap::from_iter([
                (Rc::from("b"), Value::Int(2)),
                (Rc::from("a"), Value::Int(1)),
            ]),
        )));
        assert_eq!(m.display_string(0), "{\"a\": 1, \"b\": 2}");
    }

    #[test]
    fn equality() {
        assert!(Value::Int(1).equals(&Value::Float(1.0)));
        assert!(!Value::Int(1).equals(&Value::Bool(true)));
        assert!(Value::str("a").equals(&Value::str("a")));
        let arr = Rc::new(RefCell::new(Vec::new()));
        assert!(Value::Array(Rc::clone(&arr)).equals(&Value::Array(arr)));
        assert!(!Value::Null.equals(&Value::Int(0)));
    }
}
