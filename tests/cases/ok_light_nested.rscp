// Nested closures and ranges in functions, heavy light-syntax nesting.
fn makeCounter() -> || 0
fn adder(a) -> |b| |c| a + b + c
println(adder(1)(2)(3))

var grid = [
    [1, 2],
    [3, 4],
]
var trace = 0
for r in 0..2 {
    for c in 0..2 {
        if r == c { trace += grid[r][c] }
    }
}
println(trace)

let pick = |rows, r, c| rows[r][c]
println(pick(grid, 1, 0))
