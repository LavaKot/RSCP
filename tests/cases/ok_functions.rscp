fn add(a, b) { return a + b; }
fn factorial(n) {
    if (n <= 1) { return 1; }
    return n * factorial(n - 1);
}
fn sign(x) {
    if (x > 0) { return "positive"; }
    if (x < 0) { return "negative"; }
    return "zero";
}
fn noret() { var t = 1; }
fn outer() {
    fn inner(v) { return v * 2; }
    return inner(21);
}
println(add(2, 3));
println(factorial(10));
println(sign(5), sign(-5), sign(0));
println(noret());
println(outer());
let fnval = add;
println(fnval(10, 20));
println(type(add));
