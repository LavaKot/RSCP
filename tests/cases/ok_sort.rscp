fn bubbleSort(arr) {
    var n = len(arr);
    for (var i = 0; i < n; i++) {
        var swapped = false;
        for (var j = 0; j < n - 1 - i; j++) {
            if (arr[j] > arr[j + 1]) {
                let tmp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = tmp;
                swapped = true;
            }
        }
        if (!swapped) { break; }
    }
    return arr;
}
fn binarySearch(arr, target) {
    var lo = 0;
    var hi = len(arr) - 1;
    while (lo <= hi) {
        var mid = (lo + hi) / 2;
        if (arr[mid] == target) { return mid; }
        if (arr[mid] < target) { lo = mid + 1; }
        else { hi = mid - 1; }
    }
    return -1;
}
let data = [42, 7, 19, 3, 88, 1];
let sorted = bubbleSort(data);
println(sorted);
println(binarySearch(sorted, 19));
println(binarySearch(sorted, 100));
