// Multiline literals with trailing commas, continuation lines that start
// with an operator, `else` on its own line.
let xs = [
    10,
    20,
    30,
]
let m = {
    "a": 1,
    "b": 2,
}
let total = 1 +
    2 +
    4
fn sum3(
    a,
    b,
    c,
) -> a + b + c
println(sum3(xs[0], m["b"], total))

var grade = "F"
if total >= 100 {
    grade = "A"
}
else if total >= 10 {
    grade = "B"
}
println(grade)

var s = "x"
s += "y"
s += "z"
println(s)
