{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "RSCP",
  "scopeName": "source.rscp",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.rscp",
          "match": "//.*$"
        },
        {
          "name": "comment.block.rscp",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "name": "comment.block.rscp",
              "match": "."
            }
          ]
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.rscp",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.rscp",
          "match": "\\\\(n|t|r|0|\\\\|\"|')"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.rscp",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.rscp",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.rscp",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.float.rscp",
          "match": "\\b(\\d[\\d_]*)?\\.\\d[\\d_]*([eE][+-]?\\d+)?\\b|\\b\\d[\\d_]*\\.?([eE][+-]?\\d+)\\b"
        },
        {
          "name": "constant.numeric.integer.rscp",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.rscp",
          "match": "\\b(if|else|while|loop|for|in|match|return|break|continue)\\b"
        },
        {
          "name": "storage.type.rscp",
          "match": "\\b(fn|let|var)\\b"
        },
        {
          "name": "constant.language.rscp",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "builtins": {
      "name": "support.function.builtin.rscp",
      "match": "\\b(print|println|len|str|int|float|type|abs|min|max|sqrt|pow|rand|clock|push|pop|keys|has|assert|panic)\\b(?=\\s*\\()"
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.definition.rscp",
          "match": "\\bfn\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.function.rscp" }
          }
        },
        {
          "name": "meta.function-call.rscp",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.rscp" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.rscp",
          "match": "\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|\\+\\+|--"
        },
        {
          "name": "keyword.operator.bitwise.rscp",
          "match": "<<|>>|&|\\^|~"
        },
        {
          "name": "keyword.operator.fat-arrow.rscp",
          "match": "=>"
        },
        {
          "name": "keyword.operator.range.rscp",
          "match": "\\.\\.=|\\.\\."
        },
        {
          "name": "keyword.operator.arrow.rscp",
          "match": "->"
        },
        {
          "name": "keyword.operator.assignment.rscp",
          "match": "="
        },
        {
          "name": "keyword.operator.comparison.rscp",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.rscp",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "punctuation.definition.closure.rscp",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.arithmetic.rscp",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.ternary.rscp",
          "match": "\\?|:"
        }
      ]
    }
  }
}
