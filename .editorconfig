; EditorConfig keeps .rscp files consistent across every editor.
; https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.rscp]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{rs,toml}]
indent_style = space
indent_size = 4

[*.{json,md,yml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
