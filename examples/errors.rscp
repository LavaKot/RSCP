# Error handling: typed errors, selective catch, retries.

# Wrap a fallible conversion.
fn parse_int(s) {
    try { return int(s) }
    catch e { return -1 }
}
println(parse_int("42"), parse_int("not a number"))

# A safe division.
fn div(a, b) {
    try { return a / b }
    catch e { return null }
}
println(div(10, 2), div(1, 0))

# Errors are typed objects: e.code, e.message, e.detail (26.0.10.0).
try {
    let arr = [1, 2, 3]
    println(arr[99])
} catch e {
    println(e.code, "|", e.message, "|", e.detail.index, "of", e.detail.length)
}

# Selective catch: only handle DIV_ZERO, rethrow everything else upward.
fn safe_div(a, b) {
    try { return a / b }
    catch e code "DIV_ZERO" { return null }
}
try { println(safe_div(1, 0), safe_div(1, "x")) } catch e { println("rethrown:", e.code) }

# Multiple clauses and a `where` filter.
fn describe(n) {
    try { return 100 / n }
    catch e where e.code != "DIV_ZERO" { return "bad type" }
    catch e { return "cannot divide by zero" }
}
println(describe(4), describe(0), describe("x"))

# Typed errors of your own: throw error(code, message, detail).
fn flaky(n) {
    if n < 2 { throw error("FLAKY", f"attempt {n} failed", {"attempt": n}) }
    return "ok"
}
var result = "gave up"
for attempt in 1..=3 {
    try {
        result = flaky(attempt)
        break
    } catch e code "FLAKY" {
        println(f"retry after: {e.message} (attempt {e.detail.attempt})")
    }
}
println("result:", result)

# Collect the outcome of many operations without crashing.
var failures = 0
for op in ["ok", "fail", "ok", "fail"] {
    try {
        if op == "fail" { throw "nope" }
    } catch e {
        failures++
    }
}
println(f"{failures} of 4 operations failed")
